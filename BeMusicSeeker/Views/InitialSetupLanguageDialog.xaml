<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="BeMusicSeeker.Views.InitialSetupLanguageDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels"
             x:Name="initialSetupLanguageDialog">
  <Grid Name="initialSetupLanguageDialogRootGrid" TextElement.Foreground="{DynamicResource App.TextBrush}">
    <Rectangle Fill="{DynamicResource App.DialogOverlayBrush}" Opacity="0.5" />
    <Border Width="520" CornerRadius="10" Background="{DynamicResource App.DialogBackgroundBrush}" BorderBrush="{DynamicResource App.DialogBorderBrush}" BorderThickness="1" Padding="14" VerticalAlignment="Center" HorizontalAlignment="Center">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button Name="buttonContinue" MinWidth="96" Height="24" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.InitialSetupLanguageDialogContinue, Mode=OneWay}" Command="{Binding settingDialog.OpenCommand}" />
        </StackPanel>
        <StackPanel>
          <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.InitialSetupLanguageDialogTitle, Mode=OneWay}" />
          <DockPanel LastChildFill="False" Margin="0,0,0,12">
            <ComboBox Height="24" Width="180" MaxDropDownHeight="260" VerticalContentAlignment="Center" ItemsSource="{Binding settingDialog.Languages, Mode=OneWay}" SelectedItem="{Binding Path=settingDialog.Language}" DockPanel.Dock="Right" />
            <Label Height="28" Padding="0,6,8,0" HorizontalContentAlignment="Right" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Language, Mode=OneWay}" />
          </DockPanel>
          <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock TextWrapping="Wrap" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Msg_init_settings, Mode=OneWay}" />
          </ScrollViewer>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
