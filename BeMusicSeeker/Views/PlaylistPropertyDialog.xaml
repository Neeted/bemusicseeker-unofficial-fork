<?xml version="1.0" encoding="utf-8"?>
<v:ThemedWindow x:Class="BeMusicSeeker.Views.PlaylistPropertyDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:v="clr-namespace:BeMusicSeeker.Views" xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels" xmlns:settings="clr-namespace:BeMusicSeeker.Views.Settings" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" x:Name="playlistPropertyDialog" Width="640" Height="520" MinWidth="560" MinHeight="420" ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Title="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Property, Mode=OneWay}" KeyDown="DialogKeyDown">
  <Grid TextElement.Foreground="{DynamicResource App.TextBrush}">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/BeMusicSeeker;component/BeMusicSeeker/Themes/CanonicalDialogStyles.xaml" />
          <ResourceDictionary Source="/BeMusicSeeker;component/BeMusicSeeker/Views/Settings/SettingsControls.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <v:objectToBoolConverter x:Key="objectToBoolConverter" />
        <v:notOperatorBoolConverter x:Key="notOperatorBoolConverter" />
        <v:folderSortKeyConverter x:Key="folderSortKeyConverter" />
        <v:folderSortKeyListConverter x:Key="folderSortKeyListConverter" />
        <v:entryUnitTypeConverter x:Key="entryUnitTypeConverter" />
        <v:entryUnitTypeListConverter x:Key="entryUnitTypeListConverter" />
        <v:customfolderOutputCheckBoxConverter x:Key="customfolderOutputCheckBoxConverter" />
        <v:emptyFolderNameConverter x:Key="emptyFolderNameConverter" />
        <v:entryUnitTypeIsFileConverter x:Key="entryUnitTypeIsFileConverter" />
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
          <Setter Property="MinHeight" Value="24" />
          <Setter Property="Padding" Value="10,2" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
          <Setter Property="MinHeight" Value="24" />
          <Setter Property="Padding" Value="5,1" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
          <Setter Property="MinHeight" Value="24" />
          <Setter Property="Padding" Value="5,1" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type Label}" BasedOn="{StaticResource {x:Type Label}}">
          <Setter Property="MinHeight" Value="24" />
          <Setter Property="Padding" Value="0,4,8,4" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
          <Setter Property="MinHeight" Value="20" />
          <Setter Property="Padding" Value="4,1,0,1" />
        </Style>
        <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource {x:Type RadioButton}}">
          <Setter Property="MinHeight" Value="20" />
          <Setter Property="Padding" Value="4,1,0,1" />
        </Style>
        <Style x:Key="PropertyCategoryPageStyle" TargetType="{x:Type Grid}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedIndex, ElementName=propertyNavigation}" Value="0">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="PropertyFolderPageStyle" TargetType="{x:Type Grid}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedIndex, ElementName=propertyNavigation}" Value="1">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="PropertyCustomPageStyle" TargetType="{x:Type Grid}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedIndex, ElementName=propertyNavigation}" Value="2">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Border Style="{StaticResource App.Canonical.NativeWindowContentStyle}" SnapsToDevicePixels="True">
      <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" LastChildFill="True">
        <Grid DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource App.TextBrush}"
                     Text="{Binding last_update, StringFormat=&quot;Update: {0:yyyy'/'MM'/'dd}&quot;}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource App.Canonical.DialogPrimaryActionStyle}" Content="OK" MinWidth="64" Margin="0,0,8,0" AutomationProperties.AutomationId="PlaylistPropertyAccept" Click="SaveAndClose" />
            <Button Style="{StaticResource App.Canonical.DialogQuietActionStyle}" Content="Cancel" MinWidth="64" AutomationProperties.AutomationId="PlaylistPropertyCancel" Click="CancelAndClose" />
          </StackPanel>
        </Grid>
        <ListBox x:Name="propertyNavigation"
                 DockPanel.Dock="Top"
                 Margin="0,0,0,8"
                 SelectedIndex="0"
                 SelectionMode="Single"
                 KeyboardNavigation.TabIndex="1"
                 Style="{StaticResource App.Canonical.TopNavigationStyle}"
                 SelectionChanged="PropertyNavigationSelectionChanged">
          <ListBoxItem Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.General, Mode=OneWay}" />
          <ListBoxItem Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Folder, Mode=OneWay}" />
          <ListBoxItem Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Custom_folder, Mode=OneWay}" IsEnabled="{Binding OperationModeLR2DB, Mode=OneWay}" />
        </ListBox>
        <ContentControl x:Name="propertyContent"
                        DockPanel.Dock="Top"
                        KeyboardNavigation.TabIndex="2"
                        Style="{StaticResource App.Canonical.TopNavigationContentStyle}">
          <ScrollViewer x:Name="propertyContentScrollViewer"
                        Style="{StaticResource App.Canonical.ScrollViewerStyle}"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <Grid>
              <Grid x:Name="generalPage" Style="{StaticResource PropertyCategoryPageStyle}">
                <StackPanel>
                  <settings:SettingsSection DockPanel.Dock="Top" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist, Mode=OneWay}">
                    <DockPanel>
                      <DockPanel Dock="Bottom">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                          <Label Style="{StaticResource App.Canonical.LabelStyle}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_entrytype, Mode=OneWay}" />
                          <ComboBox Style="{StaticResource App.Canonical.ComboBoxStyle}" Name="comboBox" Margin="0,2,0,2" Width="100" IsEnabled="{Binding IsChecked, Converter={StaticResource notOperatorBoolConverter}, ElementName=checkBox, Mode=OneWay}" ItemsSource="{Binding entry_type_list, Converter={StaticResource entryUnitTypeListConverter}, Mode=OneWay}" SelectedItem="{Binding entry_type, Converter={StaticResource entryUnitTypeConverter}, Mode=TwoWay}" />
                        </StackPanel>
                        <DockPanel Dock="Left">
                          <Label Style="{StaticResource App.Canonical.LabelStyle}" Width="90" DockPanel.Dock="Left" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_folder_prefix, Mode=OneWay}" />
                          <TextBox Style="{StaticResource App.Canonical.TextBoxStyle}" Height="24" VerticalContentAlignment="Center" Text="{Binding compat_prefix, Mode=TwoWay}" />
                        </DockPanel>
                      </DockPanel>
                      <DockPanel Dock="Top">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                          <Label Style="{StaticResource App.Canonical.LabelStyle}" Width="60" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_symbol, Mode=OneWay}" />
                          <TextBox Style="{StaticResource App.Canonical.TextBoxStyle}" Height="24" Width="40" VerticalContentAlignment="Center" Text="{Binding symbol, Mode=TwoWay}" />
                        </StackPanel>
                        <DockPanel>
                          <Label Style="{StaticResource App.Canonical.LabelStyle}" Width="90" DockPanel.Dock="Left" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_playlist_name, Mode=OneWay}" />
                          <TextBox Style="{StaticResource App.Canonical.TextBoxStyle}" Height="24" Margin="0,0,10,0" DockPanel.Dock="Right" VerticalContentAlignment="Center" Text="{Binding name, Mode=TwoWay}" />
                        </DockPanel>
                      </DockPanel>
                    </DockPanel>
                  </settings:SettingsSection>
                  <StackPanel Margin="0,0,0,28">
                    <CheckBox Style="{StaticResource App.Canonical.CheckBoxStyle}" Name="checkBox" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_syncmode, Mode=OneWay}" IsChecked="{Binding is_external_sync, Mode=TwoWay}" />
                    <StackPanel Margin="0,14,0,0" IsEnabled="{Binding IsChecked, Converter={StaticResource notOperatorBoolConverter}, ElementName=checkBox, Mode=OneWay}">
                      <DockPanel Margin="0,5,0,0">
                        <TextBox Style="{StaticResource App.Canonical.TextBoxStyle}" Height="24" Width="340" DockPanel.Dock="Right" VerticalContentAlignment="Center" Text="{Binding Page_url, Mode=TwoWay}" />
                        <Label Style="{StaticResource App.Canonical.LabelStyle}" DockPanel.Dock="Left" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_pageuri, Mode=OneWay}" />
                      </DockPanel>
                      <DockPanel Margin="0,5,0,0">
                        <TextBox Style="{StaticResource App.Canonical.TextBoxStyle}" Height="24" Width="340" DockPanel.Dock="Right" VerticalContentAlignment="Center" Text="{Binding Header_url, Mode=TwoWay}" />
                        <Label Style="{StaticResource App.Canonical.LabelStyle}" DockPanel.Dock="Left" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_headeruri, Mode=OneWay}" />
                      </DockPanel>
                      <DockPanel Margin="0,5,0,0">
                        <TextBox Style="{StaticResource App.Canonical.TextBoxStyle}" Height="24" Width="340" DockPanel.Dock="Right" VerticalContentAlignment="Center" Text="{Binding Data_url, Mode=TwoWay}" />
                        <Label Style="{StaticResource App.Canonical.LabelStyle}" DockPanel.Dock="Left" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_datauri, Mode=OneWay}" />
                      </DockPanel>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Grid>
              <Grid x:Name="folderPage" Style="{StaticResource PropertyFolderPageStyle}">
                <DockPanel>
                  <settings:SettingsSection DockPanel.Dock="Top" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_sortorder_song, Mode=OneWay}" IsEnabled="{Binding IsChecked, Converter={StaticResource notOperatorBoolConverter}, ElementName=checkBox, Mode=OneWay}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                      </Grid.ColumnDefinitions>
                      <DockPanel Grid.Column="0">
                        <Label Style="{StaticResource App.Canonical.LabelStyle}" DockPanel.Dock="Left" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_sortkey, Mode=OneWay}" />
                        <ComboBox Style="{StaticResource App.Canonical.ComboBoxStyle}" Margin="0,2,0,2" ItemsSource="{Binding folder_sort_key_list, Converter={StaticResource folderSortKeyListConverter}, Mode=OneWay}" SelectedItem="{Binding folder_sort_key, Converter={StaticResource folderSortKeyConverter}, Mode=TwoWay}" />
                      </DockPanel>
                      <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <RadioButton Style="{StaticResource App.Canonical.RadioButtonStyle}" GroupName="SortOrder" Margin="0,0,20,0" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_asc, Mode=OneWay}" IsChecked="{Binding folder_sort_ascending, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource App.Canonical.RadioButtonStyle}" GroupName="SortOrder" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_desc, Mode=OneWay}" IsChecked="{Binding folder_sort_ascending, Converter={StaticResource notOperatorBoolConverter}, Mode=TwoWay}" />
                      </StackPanel>
                    </Grid>
                  </settings:SettingsSection>
                  <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_folder_order, Mode=OneWay}" IsEnabled="{Binding IsChecked, Converter={StaticResource notOperatorBoolConverter}, ElementName=checkBox, Mode=OneWay}">
                    <DockPanel>
                      <ListBox Style="{StaticResource App.Canonical.ListBoxStyle}" Name="foldersListBox" DockPanel.Dock="Left" Width="300" Height="130" SelectionMode="Extended" ItemsSource="{Binding folder_order, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <ContentPresenter Content="{Binding Converter={StaticResource emptyFolderNameConverter}}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ListBox>
                      <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                        <CheckBox Style="{StaticResource App.Canonical.CheckBoxStyle}" Name="checkBoxFolderNatueralSort" Margin="0,0,0,2" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Auto, Mode=OneWay}" IsChecked="{Binding is_auto_folder_sort, Mode=TwoWay}" Checked="folderNaturalSort" />
                      </StackPanel>
                      <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10">
                        <Button Style="{StaticResource App.Canonical.DialogActionStyle}" FontFamily="Marlett" Content="5" Margin="0,0,0,2" Padding="2,1,1,1" AutomationProperties.AutomationId="PlaylistPropertyFolderMoveUp" IsEnabled="{Binding IsChecked, Converter={StaticResource notOperatorBoolConverter}, ElementName=checkBoxFolderNatueralSort, Mode=OneWay}" Click="folderListUp" />
                        <Button Style="{StaticResource App.Canonical.DialogActionStyle}" FontFamily="Marlett" Content="6" Margin="0,2,0,0" Padding="2,1,1,1" AutomationProperties.AutomationId="PlaylistPropertyFolderMoveDown" IsEnabled="{Binding IsChecked, Converter={StaticResource notOperatorBoolConverter}, ElementName=checkBoxFolderNatueralSort, Mode=OneWay}" Click="folderListDown" />
                      </StackPanel>
                    </DockPanel>
                  </settings:SettingsSection>
                </DockPanel>
              </Grid>
              <Grid x:Name="customPage" Style="{StaticResource PropertyCustomPageStyle}">
                <DockPanel>
                  <settings:SettingsSection DockPanel.Dock="Bottom" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_output_dst, Mode=OneWay}">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,4">
                        <Label Style="{StaticResource App.Canonical.LabelStyle}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_output_base, Mode=OneWay}" />
                        <ComboBox Style="{StaticResource App.Canonical.ComboBoxStyle}" Height="24" Width="210" HorizontalAlignment="Left" VerticalContentAlignment="Center" ItemsSource="{Binding OutputBaseOptions, Mode=OneWay}" SelectedItem="{Binding custom_folder_output_base_option, Mode=TwoWay}" DisplayMemberPath="Label" />
                      </DockPanel>
                      <DockPanel>
                        <Label Style="{StaticResource App.Canonical.LabelStyle}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_save_name, Mode=OneWay}" />
                        <CheckBox Style="{StaticResource App.Canonical.CheckBoxStyle}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,5,5,5" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_make_root, Mode=OneWay}" IsChecked="{Binding is_root_folder, Mode=TwoWay}" />
                        <TextBox Style="{StaticResource App.Canonical.TextBoxStyle}" Height="24" HorizontalAlignment="Left" Width="210" VerticalContentAlignment="Center" Text="{Binding output_dir, Mode=TwoWay}" />
                      </DockPanel>
                    </StackPanel>
                  </settings:SettingsSection>
                  <settings:SettingsSection DockPanel.Dock="Top" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_folder_type, Mode=OneWay}">
                    <DockPanel>
                      <UniformGrid ScrollViewer.VerticalScrollBarVisibility="Disabled" UseLayoutRounding="False" Columns="2" Margin="10,0,10,0" DockPanel.Dock="Top" VerticalAlignment="Center" Height="160">
                        <CheckBox Style="{StaticResource App.Canonical.CheckBoxStyle}" VerticalAlignment="Center" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_all_songs, Mode=OneWay}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_all_songs_tooltip, Mode=OneWay}" IsChecked="{Binding ignore_folder_output, ConverterParameter=AllSongsFolder, Converter={StaticResource customfolderOutputCheckBoxConverter}, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource App.Canonical.CheckBoxStyle}" VerticalAlignment="Center" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_user, Mode=OneWay}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_user_tooltip, Mode=OneWay}" IsChecked="{Binding ignore_folder_output, ConverterParameter=UserFolder, Converter={StaticResource customfolderOutputCheckBoxConverter}, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource App.Canonical.CheckBoxStyle}" VerticalAlignment="Center" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_level, Mode=OneWay}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_level_tooltip, Mode=OneWay}" IsEnabled="{Binding SelectedValue, ElementName=comboBox, Converter={StaticResource entryUnitTypeIsFileConverter}, Mode=OneWay}" IsChecked="{Binding ignore_folder_output, ConverterParameter=LevelFolder, Converter={StaticResource customfolderOutputCheckBoxConverter}, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource App.Canonical.CheckBoxStyle}" VerticalAlignment="Center" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_alphabet, Mode=OneWay}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_alphabet_tooltip, Mode=OneWay}" IsChecked="{Binding ignore_folder_output, ConverterParameter=AlphabetFolder, Converter={StaticResource customfolderOutputCheckBoxConverter}, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource App.Canonical.CheckBoxStyle}" VerticalAlignment="Center" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_clear, Mode=OneWay}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_clear_tooltip, Mode=OneWay}" IsChecked="{Binding ignore_folder_output, ConverterParameter=ClearFolder, Converter={StaticResource customfolderOutputCheckBoxConverter}, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource App.Canonical.CheckBoxStyle}" VerticalAlignment="Center" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_djlevel, Mode=OneWay}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_djlevel_tooltip, Mode=OneWay}" IsChecked="{Binding ignore_folder_output, ConverterParameter=DJLevelFolder, Converter={StaticResource customfolderOutputCheckBoxConverter}, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource App.Canonical.CheckBoxStyle}" VerticalAlignment="Center" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_all, Mode=OneWay}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_all_tooltip, Mode=OneWay}" IsChecked="{Binding ignore_folder_output, ConverterParameter=CategoryAllFolder, Converter={StaticResource customfolderOutputCheckBoxConverter}, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource App.Canonical.CheckBoxStyle}" VerticalAlignment="Center" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_etc, Mode=OneWay}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_etc_tooltip, Mode=OneWay}" IsChecked="{Binding ignore_folder_output, ConverterParameter=OtherFolder, Converter={StaticResource customfolderOutputCheckBoxConverter}, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource App.Canonical.CheckBoxStyle}" VerticalAlignment="Center" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_random, Mode=OneWay}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_random_tooltip, Mode=OneWay}" IsChecked="{Binding ignore_folder_output, ConverterParameter=RandomFolder, Converter={StaticResource customfolderOutputCheckBoxConverter}, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource App.Canonical.CheckBoxStyle}" VerticalAlignment="Center" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_bpm_sort, Mode=OneWay}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_bpm_sort_tooltip, Mode=OneWay}" IsChecked="{Binding ignore_folder_output, ConverterParameter=BpmSortFolder, Converter={StaticResource customfolderOutputCheckBoxConverter}, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource App.Canonical.CheckBoxStyle}" VerticalAlignment="Center" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_bp_sort, Mode=OneWay}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_bp_sort_tooltip, Mode=OneWay}" IsChecked="{Binding ignore_folder_output, ConverterParameter=BpSortFolder, Converter={StaticResource customfolderOutputCheckBoxConverter}, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource App.Canonical.CheckBoxStyle}" VerticalAlignment="Center" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_play_count_sort, Mode=OneWay}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_play_count_sort_tooltip, Mode=OneWay}" IsChecked="{Binding ignore_folder_output, ConverterParameter=PlayCountSortFolder, Converter={StaticResource customfolderOutputCheckBoxConverter}, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource App.Canonical.CheckBoxStyle}" VerticalAlignment="Center" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_last_play_sort, Mode=OneWay}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_last_play_sort_tooltip, Mode=OneWay}" IsChecked="{Binding ignore_folder_output, ConverterParameter=LastPlaySortFolder, Converter={StaticResource customfolderOutputCheckBoxConverter}, Mode=TwoWay}" />
                      </UniformGrid>
                      <TextBlock Margin="0" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_desc, Mode=OneWay}" />
                    </DockPanel>
                  </settings:SettingsSection>
                </DockPanel>
              </Grid>
            </Grid>
          </ScrollViewer>
        </ContentControl>
      </DockPanel>
    </Border>
  </Grid>
</v:ThemedWindow>
