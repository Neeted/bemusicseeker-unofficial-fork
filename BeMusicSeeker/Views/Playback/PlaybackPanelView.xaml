<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="BeMusicSeeker.Views.PlaybackPanelView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:BeMusicSeeker.Views" xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels" xmlns:prop="clr-namespace:BeMusicSeeker.Properties" x:Name="playbackPanelView" Height="286" VerticalAlignment="Top">
  <UserControl.Resources>
    <FontFamily x:Key="LigatureSymbols">/BeMusicSeeker;component/Assets/Fonts/#LigatureSymbols</FontFamily>
    <FontFamily x:Key="Commodore">/BeMusicSeeker;component/Assets/Fonts/#Commodore 64 Rounded</FontFamily>
    <v:externalPlayerHostVisibilitiesConverter x:Key="externalPlayerHostVisibilitiesConverter" />
    <v:panelStateToStringConverter x:Key="panelStateToStringConverter" />
    <v:panelStateToStringConverter2 x:Key="panelStateToStringConverter2" />
    <v:panelStateToTooltipConverter x:Key="panelStateToTooltipConverter" />
    <v:panelStateIsTitleSmallConverter x:Key="panelStateIsTitleSmallConverter" />
    <v:panelStateToVisibilityConverter x:Key="panelStateToVisibilityConverter" />
    <v:combineTitleAndArtistConverter x:Key="combineTitleAndArtistConverter" />
    <v:nowPlayingBMStoPlayButtonStringComverter x:Key="nowPlayingBMStoPlayButtonStringComverter" />
    <v:currentTimeConverter x:Key="currentTimeConverter" />
    <v:playingBmsInfoConverter x:Key="playingBmsInfoConverter" />
    <v:timeSpanToDoubleSecConverter x:Key="timeSpanToDoubleSecConverter" />
    <v:playerTitleVisibilityConverter x:Key="playerTitleVisibilityConverter" />
    <v:positiveTimeSpanToVisibilityHiddenConverter x:Key="positiveTimeSpanToVisibilityHiddenConverter" />
    <v:addStringToEndConverter x:Key="addStringToEndConverter" />
    <v:doubleSecToTimeStrConverter x:Key="doubleSecToTimeStrConverter" />
    <ControlTemplate x:Key="Playback.ButtonTemplate" TargetType="{x:Type ButtonBase}">
      <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource Playback.ControlHoverBrush}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource Playback.ControlHoverBrush}" />
          <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.7" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Playback.ButtonBaseStyle" TargetType="{x:Type ButtonBase}">
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Width" Value="25" />
      <Setter Property="Height" Value="25" />
      <Setter Property="Foreground" Value="{DynamicResource Playback.ControlForegroundBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource LigatureSymbols}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template" Value="{StaticResource Playback.ButtonTemplate}" />
    </Style>
    <Style x:Key="stylePlayerButtonSymbol" TargetType="{x:Type Button}" BasedOn="{StaticResource Playback.ButtonBaseStyle}" />
    <Style x:Key="stylePlayerButtonSymbolShrink" TargetType="{x:Type Button}" BasedOn="{StaticResource stylePlayerButtonSymbol}">
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" RenderTransformOrigin="0.5,0.5">
              <TextBlock.RenderTransform><ScaleTransform ScaleY="0.8" /></TextBlock.RenderTransform>
            </TextBlock>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderStylePlayer" TargetType="{x:Type Slider}" BasedOn="{StaticResource App.Canonical.CompactSliderStyle}">
      <Style.Resources>
        <DataTemplate x:Key="App.Canonical.SliderThumbOverlay">
        <TextBlock Text="{Binding Value, Converter={StaticResource doubleSecToTimeStrConverter}}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-30,-18,-30,0" IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Hidden" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMoveToPointEnabled, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Thumb}}}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMoveToPointEnabled, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}" Value="True" />
                    <Condition Binding="{Binding IsDragging, RelativeSource={RelativeSource AncestorType={x:Type Thumb}}}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        </DataTemplate>
      </Style.Resources>
      <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
    </Style>
  </UserControl.Resources>
<Grid Name="gridBMSPlayer" Row="0" Column="0" ColumnSpan="2" Width="{Binding Width, ElementName=gridBMSPlayerBody}">
  <Grid.RowDefinitions>
    <RowDefinition Height="*" />
    <RowDefinition Height="30" />
  </Grid.RowDefinitions>
    <Grid Name="gridBMSPlayerBody" Grid.Row="0">
      <Image Name="gridBMSPlayerImage" Stretch="UniformToFill" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-10,-10,-10,0">
        <UIElement.Effect>
          <BlurEffect Radius="0" />
        </UIElement.Effect>
      </Image>
      <Grid Name="gridPlayerTitle" Height="80" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" ClipToBounds="True">
        <Grid.Visibility>
          <Binding Path="Visibility" ElementName="externalPlayerHost" Converter="{StaticResource playerTitleVisibilityConverter}" />
        </Grid.Visibility>
        <DockPanel Name="gridBMSPlayerTitlePanel" Height="40" LastChildFill="False" VerticalAlignment="Bottom" Background="#CC000000">
          <TextBlock Name="gridBMSPlayerControlsArtist" DockPanel.Dock="Bottom" FontFamily="Meiryo" FontSize="12" Margin="0" Foreground="#FFFFFFFF" HorizontalAlignment="Center" Text="{Binding PlayerHeaderArtist}" />
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="3,3,3,0" HorizontalAlignment="Center">
            <TextBlock Name="gridBMSPlayerControlsTitle" FontFamily="Meiryo" FontSize="14" Margin="0" FontWeight="Bold" Foreground="#FFFFFFFF" HorizontalAlignment="Right" Text="{Binding PlayerHeaderTitle}" />
            <TextBlock Name="gridBMSPlayerControlsSubtitle" FontFamily="Meiryo" FontSize="14" Margin="5,0,0,0" Foreground="#FFFFFFFF" HorizontalAlignment="Left" Text="{Binding PlayerHeaderSubtitle}" />
          </StackPanel>
        </DockPanel>
        <Border Name="gridBMSPlayerControlsBanner" BorderThickness="0" BorderBrush="{DynamicResource App.BorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="302" Height="80" Margin="0" Opacity="0" />
      </Grid>
      <Grid Name="gridExternalPlayerHost">
        <v:ExternalPlayerHwndHost x:Name="externalPlayerHost" ClipToBounds="True" VerticalAlignment="Bottom" HorizontalAlignment="Center" MinWidth="587" Height="256" MaxHeight="256" Margin="0" IsEnabledChanged="externalPlayerHostIsEnabledChanged">
          <UIElement.Visibility>
            <MultiBinding Converter="{StaticResource externalPlayerHostVisibilitiesConverter}" Mode="OneWay">
              <Binding Path="OverlayVisibility" ElementName="playbackPanelView" />
              <Binding Path="IsEnabled" ElementName="externalPlayerHost" />
              <Binding Path="HasNowPlayingChart" />
              <Binding RelativeSource="{RelativeSource Self}" />
            </MultiBinding>
          </UIElement.Visibility>
        </v:ExternalPlayerHwndHost>
      </Grid>
      <Grid Name="gridPlayngBmsInfo" HorizontalAlignment="Right" Width="220" Margin="0" Visibility="Hidden">
        <TextBlock Margin="0,0,0,-11" VerticalAlignment="Center" FontFamily="{StaticResource Commodore}" FontSize="13" Background="#33000000" Padding="5" Visibility="{Binding CurrentlyPlayingDuration, Converter={StaticResource positiveTimeSpanToVisibilityHiddenConverter}}" Foreground="White">
          <TextBlock.Text>
            <MultiBinding Converter="{StaticResource playingBmsInfoConverter}" Mode="OneWay">
              <Binding Path="CurrentlyPlayingBmsDuration" />
              <Binding Path="CurrentlyPlayingMusicDuration" />
              <Binding Path="CurrentlyPlayingStopTime" />
              <Binding Path="CurrentlyPlayingCurrentVoices" />
              <Binding Path="CurrentlyPlayingMaxVoices" />
              <Binding Path="CurrentlyPlayingNoteDensity" />
              <Binding Path="CurrentlyPlayingNoteDensityMax" />
              <Binding Path="CurrentlyPlayingBpm" />
              <Binding Path="CurrentlyPlayingMinBpm" />
              <Binding Path="CurrentlyPlayingMaxBpm" />
              <Binding Path="CurrentlyPlayingTotal" />
              <Binding Path="CurrentlyPlayingCombo" />
              <Binding Path="CurrentlyPlayingNotes" />
              <Binding Path="CurrentlyPlayingMeasure" />
              <Binding Path="CurrentlyPlayingLastMeasure" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
      </Grid>
    </Grid>
    <DockPanel Background="{DynamicResource Playback.ControlBackgroundBrush}" Name="gridBMSPlayerControls" Grid.Row="1" Margin="0" MaxHeight="30" Height="30">
      <Slider Name="sliderPlayer" Panel.ZIndex="1" DockPanel.Dock="Top" Margin="0,-10,0,-8" Height="18" VerticalAlignment="Top" Style="{DynamicResource SliderStylePlayer}" IsMoveToPointEnabled="True" LargeChange="0.1" Maximum="{Binding CurrentlyPlayingDuration, Converter={StaticResource timeSpanToDoubleSecConverter}}" Value="{Binding CurrentlyPlayingTime, Mode=TwoWay, Converter={StaticResource timeSpanToDoubleSecConverter}}" Visibility="{Binding CurrentlyPlayingDuration, Converter={StaticResource positiveTimeSpanToVisibilityHiddenConverter}}" MouseMove="sliderPlayerMouseMove" MouseLeave="sliderPlayerMouseLeave" PreviewMouseLeftButtonUp="sliderPlayerMouseLeftButtonUp" />
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="5,0,0,0">
        <Button Name="buttonBMSPlayerControlsPlayAndPauseButton" Style="{StaticResource stylePlayerButtonSymbol}" FontSize="17" Margin="0,1,0,0" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Tooltip_play_pause, Mode=OneWay}" Content="{Binding PlaybackStatusValue, Converter={StaticResource nowPlayingBMStoPlayButtonStringComverter}, FallbackValue=play}" PreviewMouseLeftButtonDown="gridBMSPlayerControlsPlayStartButtonClicked" />
        <Button Content="stop" Style="{StaticResource stylePlayerButtonSymbol}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Tooltip_stop, Mode=OneWay}" PreviewMouseLeftButtonDown="gridBMSPlayerControlsPlayStopButtonClicked" />
        <Button Content="backback" Style="{StaticResource stylePlayerButtonSymbol}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Tooltip_previous_track, Mode=OneWay}" PreviewMouseLeftButtonDown="gridBMSPlayerControlsPreviousButtonClicked" />
        <Button Content="nextnext" Style="{StaticResource stylePlayerButtonSymbol}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Tooltip_next_track, Mode=OneWay}" PreviewMouseLeftButtonDown="gridBMSPlayerControlsNextButtonClicked" />
        <Button Content="leftleft" Style="{StaticResource stylePlayerButtonSymbolShrink}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Tooltip_rewind, Mode=OneWay}" IsEnabled="{Binding CanSeek}" PreviewMouseLeftButtonDown="gridBMSPlayerControlsFastBackwardButtonClicked" PreviewMouseLeftButtonUp="gridBMSPlayerControlsFastBackwardButtonReleased" MouseLeave="gridBMSPlayerControlsFastBackwardButtonReleased" />
        <Button Content="rightright" Style="{StaticResource stylePlayerButtonSymbolShrink}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Tooltip_fast_forward, Mode=OneWay}" IsEnabled="{Binding CanSeek}" PreviewMouseLeftButtonDown="gridBMSPlayerControlsFastForwardButtonClicked" PreviewMouseLeftButtonUp="gridBMSPlayerControlsFastForwardButtonReleased" MouseLeave="gridBMSPlayerControlsFastForwardButtonReleased" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="0,0,5,0">
        <Button Name="buttonBMSPlayerControlsRotatePanelState2" FlowDirection="LeftToRight" Style="{StaticResource stylePlayerButtonSymbol}" FontSize="20" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Tooltip_toggle_player_panel, Mode=OneWay}" Content="{Binding EffectivePlayerPanelState, ElementName=playbackPanelView, Mode=OneWay, Converter={StaticResource panelStateToStringConverter2}}" Click="gridBMSPlayerControlsRotatePanelStateButtonClicked2" />
        <Button Name="buttonBMSPlayerControlsRotatePanelState" FlowDirection="LeftToRight" Style="{StaticResource stylePlayerButtonSymbol}" FontSize="20" Content="{Binding EffectivePlayerPanelState, ElementName=playbackPanelView, Mode=OneWay, Converter={StaticResource panelStateToStringConverter}}" ToolTip="{Binding EffectivePlayerPanelState, ElementName=playbackPanelView, Mode=OneWay, Converter={StaticResource panelStateToTooltipConverter}}" Click="gridBMSPlayerControlsRotatePanelStateButtonClicked" />
        <Button Content="gear" Style="{StaticResource stylePlayerButtonSymbol}" FlowDirection="LeftToRight" FontSize="20" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_window_title, Mode=OneWay}" Command="{Binding SettingsCommand, ElementName=playbackPanelView}" />
        <v:DropDownMenuButton Width="25" Height="25" Style="{StaticResource Playback.ButtonBaseStyle}" FontSize="17" FlowDirection="LeftToRight" Margin="0,1,0,0" BorderThickness="0" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Tooltip_player_settings, Mode=OneWay}">
          <v:DropDownMenuButton.Content>
            <Grid>
              <TextBlock Text="setup" />
              <Path Width="6" Height="5" Margin="13,0,0,0" Stretch="Fill" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type v:DropDownMenuButton}}}" Data="F1 M57.5692,88 L99.1384,16 L16,16 L57.5692,88" />
            </Grid>
          </v:DropDownMenuButton.Content>
          <v:DropDownMenuButton.DropDownContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem>
                <HeaderedItemsControl.Header>
                  <UniformGrid Rows="1" Columns="2" MinWidth="180" IsEnabled="{Binding CanChangeHighSpeed}">
                    <Button Content="HS UP" Style="{StaticResource App.Canonical.CompactButtonStyle}" Margin="2,0" Command="{Binding IncreaseHighSpeedCommand}" />
                    <Button Content="HS DOWN" Style="{StaticResource App.Canonical.CompactButtonStyle}" Margin="2,0" Command="{Binding DecreaseHighSpeedCommand}" />
                  </UniformGrid>
                </HeaderedItemsControl.Header>
              </MenuItem>
              <MenuItem>
                <HeaderedItemsControl.Header>
                  <UniformGrid Rows="1" Columns="3" MinWidth="210">
                    <Button Content="Info" Style="{StaticResource App.Canonical.CompactButtonStyle}" Margin="2,0" IsEnabled="{Binding CanShowInfo}" Click="gridBMSPlayerControlsShowInfoButtonClicked" />
                    <Button Content="Effect" Style="{StaticResource App.Canonical.CompactButtonStyle}" Margin="2,0" IsEnabled="{Binding CanShowEffect}" Command="{Binding ShowEffectCommand}" />
                    <Button Content="1P/2P" Style="{StaticResource App.Canonical.CompactButtonStyle}" Margin="2,0" IsEnabled="{Binding CanChangePlayside}" Command="{Binding ChangePlaysideCommand}" />
                  </UniformGrid>
                </HeaderedItemsControl.Header>
              </MenuItem>
              <MenuItem>
                <HeaderedItemsControl.Header>
                  <Grid Width="150">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="playerVolumePercentage" Grid.Column="1" Foreground="{DynamicResource App.TextBrush}" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding PlayerVolume, Converter={StaticResource addStringToEndConverter}, ConverterParameter=%|}" />
                    <Slider x:Name="playerVolumeSlider" Thumb.DragCompleted="PlayerVolumeDragCompleted" PreviewMouseLeftButtonUp="PlayerVolumeMouseLeftButtonUp" PreviewKeyUp="PlayerVolumeKeyUp" LostKeyboardFocus="PlayerVolumeLostKeyboardFocus" Unloaded="PlayerVolumeUnloaded" Style="{StaticResource App.Canonical.CompactSliderStyle}" Grid.Column="0" VerticalAlignment="Center" Margin="0" AutoToolTipPlacement="TopLeft" Maximum="100" LargeChange="10" SmallChange="1" Height="18" RenderTransformOrigin="0.5,0.5" Value="{Binding PlayerVolume, Mode=TwoWay}" />
                  </Grid>
                </HeaderedItemsControl.Header>
              </MenuItem>
              <Separator />
              <MenuItem Header="REPEAT" IsCheckable="True" IsChecked="{Binding RepeatPlayMode, Mode=TwoWay}" />
              <MenuItem Header="FOLDER SKIP" IsCheckable="True" IsChecked="{Binding FolderSkipPlayMode, Mode=TwoWay}" />
              <MenuItem Header="SINGLE PLAY" IsCheckable="True" IsChecked="{Binding SinglePlayMode, Mode=TwoWay}" />
            </ContextMenu>
          </v:DropDownMenuButton.DropDownContextMenu>
        </v:DropDownMenuButton>
      </StackPanel>
      <TextBlock Foreground="{DynamicResource Playback.ControlForegroundBrush}" Opacity="0.8" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11" Margin="0,3,5,0" Visibility="{Binding CurrentlyPlayingDuration, Converter={StaticResource positiveTimeSpanToVisibilityHiddenConverter}}">
        <TextBlock.Text>
          <MultiBinding Converter="{StaticResource currentTimeConverter}" Mode="OneWay">
            <Binding Path="CurrentlyPlayingDuration" />
            <Binding Path="CurrentlyPlayingTime" />
          </MultiBinding>
        </TextBlock.Text>
      </TextBlock>
      <TextBlock Name="gridBMSPlayerControlsTitle2" DockPanel.Dock="Left" FontFamily="Meiryo" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,10,0" FontWeight="Bold" Foreground="{DynamicResource Playback.ControlForegroundBrush}" TextTrimming="CharacterEllipsis" Opacity="1">
        <UIElement.Visibility>
          <MultiBinding Converter="{StaticResource panelStateToVisibilityConverter}">
            <Binding Path="Visibility" ElementName="gridPlayerTitle" />
            <Binding Path="EffectivePlayerPanelState" ElementName="playbackPanelView" />
          </MultiBinding>
        </UIElement.Visibility>
        <TextBlock.Text>
          <MultiBinding Converter="{StaticResource combineTitleAndArtistConverter}">
            <Binding Path="PlayerHeaderTitle" />
            <Binding Path="PlayerHeaderSubtitle" />
            <Binding Path="PlayerHeaderArtist" />
          </MultiBinding>
        </TextBlock.Text>
      </TextBlock>
    </DockPanel>
</Grid>
</UserControl>
