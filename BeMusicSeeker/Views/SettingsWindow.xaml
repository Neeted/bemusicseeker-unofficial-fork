                        <Grid Style="{StaticResource settingsFieldGridStyle}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="120" />
                            <ColumnDefinition Width="3*" MinWidth="160" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Label Grid.Column="0" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.FilePath_songDB, Mode=OneWay}" />
