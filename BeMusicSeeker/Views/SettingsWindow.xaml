<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="BeMusicSeeker.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:v="clr-namespace:BeMusicSeeker.Views" xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:prop="clr-namespace:BeMusicSeeker.Properties" x:Name="settingsWindow" Width="920" Height="680" MinWidth="760" MinHeight="500" ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Title="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Advanced_settings, Mode=OneWay}" Background="{DynamicResource App.DialogBackgroundBrush}" Foreground="{DynamicResource App.TextBrush}" KeyDown="SettingsWindowKeyDown">
  <Grid Name="settingDialogRootGrid" IsEnabled="{Binding IsEditCompletionEnabled}">
    <Grid Name="settingDialogOperationGrid" TextElement.Foreground="{DynamicResource App.TextBrush}">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <v:expanderDetailedLR2PathConverter x:Key="expanderDetailedLR2PathConverter" />
        <v:backupTargetConverter x:Key="backupTargetConverter" />
        <v:lr2DetailedPathAutoExpandConverter x:Key="lr2DetailedPathAutoExpandConverter" />
        <v:notOperatorBoolConverter x:Key="notOperatorBoolConverter" />
        <v:encoderDriverSelectionEnabledConverter x:Key="encoderDriverSelectionEnabledConverter" />
        <v:backupSpanRadioConverter x:Key="backupSpanRadioConverter" />
        <v:booleanToVisibilityCollapsedConverter x:Key="booleanToVisibilityCollapsedConverter" />
        <Style x:Key="settingsNavigationItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="Margin" Value="12,2" />
          <Setter Property="Padding" Value="12,9" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="FocusVisualStyle" Value="{x:Null}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ListBoxItem}">
                <Border x:Name="NavigationPill" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="3" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SelectionIndicator" Width="3" Background="Transparent" CornerRadius="2" />
                    <ContentPresenter Grid.Column="2" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="NavigationPill" Property="Background" Value="{DynamicResource App.ControlHoverBrush}" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="NavigationPill" Property="Background" Value="{DynamicResource App.ControlSelectedBrush}" />
                    <Setter TargetName="SelectionIndicator" Property="Background" Value="{DynamicResource App.AccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </Trigger>
                  <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="NavigationPill" Property="BorderBrush" Value="{DynamicResource App.InputFocusBorderBrush}" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
                    <Setter TargetName="NavigationPill" Property="Opacity" Value="0.6" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource {x:Type GroupBox}}">
          <Setter Property="Margin" Value="0,0,0,16" />
          <Setter Property="Padding" Value="16,12,16,16" />
          <Setter Property="Background" Value="{DynamicResource App.ControlBackgroundBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type GroupBox}">
                <Border x:Name="SettingsCard" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}" CornerRadius="12" SnapsToDevicePixels="True">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentPresenter Margin="16,12,16,0" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Control.Foreground}" TextElement.FontSize="14" TextElement.FontWeight="SemiBold" />
                    <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Control.Foreground}" />
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
                    <Setter TargetName="SettingsCard" Property="Opacity" Value="0.65" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
          <Setter Property="MinHeight" Value="32" />
          <Setter Property="Padding" Value="12,4" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="settingsFooterActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
          <Setter Property="MinHeight" Value="36" />
          <Setter Property="MinWidth" Value="96" />
          <Setter Property="Padding" Value="16,6" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="settingsPrimaryActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource settingsFooterActionButtonStyle}">
          <Setter Property="Background" Value="{DynamicResource App.AccentBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource Table.CurrentCellTextBrush}" />
          <Style.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsEnabled" Value="True" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsEnabled" Value="True" />
                <Condition Property="IsPressed" Value="True" />
              </MultiTrigger.Conditions>
              <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
            </Trigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="settingsQuietActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource settingsFooterActionButtonStyle}">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
        </Style>
        <Style x:Key="settingsFieldGridStyle" TargetType="{x:Type Grid}">
          <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
          <Setter Property="MinHeight" Value="32" />
          <Setter Property="Padding" Value="8,3" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
          <Setter Property="MinHeight" Value="32" />
          <Setter Property="Padding" Value="8,3" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type Label}" BasedOn="{StaticResource {x:Type Label}}">
          <Setter Property="MinHeight" Value="32" />
          <Setter Property="Padding" Value="0,6,12,6" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="ContentTemplate">
            <Setter.Value>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
          <Setter Property="MinHeight" Value="24" />
          <Setter Property="Padding" Value="4,2,0,2" />
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Setter Property="ContentTemplate">
            <Setter.Value>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource {x:Type RadioButton}}">
          <Setter Property="MinHeight" Value="24" />
          <Setter Property="Padding" Value="4,2,0,2" />
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Setter Property="ContentTemplate">
            <Setter.Value>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="styleWrappingSettingCheckBox" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
          <Setter Property="MinHeight" Value="24" />
          <Setter Property="Padding" Value="4,2,0,2" />
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Setter Property="ContentTemplate">
            <Setter.Value>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="styleTextBlockActiveForeground" TargetType="{x:Type TextBlock}">
          <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid Background="{DynamicResource App.DialogBackgroundBrush}" SnapsToDevicePixels="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="224" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource App.SurfaceBrush}">
        <ListBox x:Name="settingsNavigation" SelectedIndex="0" Padding="0,16" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource settingsNavigationItemStyle}" AutomationProperties.AutomationId="SettingsCategoryNavigation" KeyboardNavigation.TabNavigation="Local">
          <ListBoxItem x:Name="navigationGeneral" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.General, Mode=OneWay}" />
          <ListBoxItem x:Name="navigationAppearance" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance, Mode=OneWay}" />
          <ListBoxItem x:Name="navigationPlayback" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playback, Mode=OneWay}" />
          <ListBoxItem x:Name="navigationDevice" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device, Mode=OneWay}" />
          <ListBoxItem x:Name="navigationRecord" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Record, Mode=OneWay}" />
          <ListBoxItem x:Name="navigationPlaylist" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist, Mode=OneWay}" />
          <ListBoxItem x:Name="navigationInstall" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Install, Mode=OneWay}" />
          <ListBoxItem x:Name="navigationBackup" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Backup, Mode=OneWay}" />
          <ListBoxItem x:Name="navigationDetails" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details, Mode=OneWay}" />
          <ListBoxItem x:Name="navigationVersionInfo" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Version_info, Mode=OneWay}" />
        </ListBox>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource App.SeparatorBrush}" />
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="1" />
          <RowDefinition Height="*" />
          <RowDefinition Height="1" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentControl Grid.Row="0" Margin="24,24,24,16" Content="{Binding SelectedItem.Content, ElementName=settingsNavigation}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource App.TextBrush}" IsTabStop="False" />
        <Border Grid.Row="1" Margin="24,0" Background="{DynamicResource App.SeparatorBrush}" />
        <ScrollViewer x:Name="settingsPageScrollViewer" Grid.Row="2" Margin="24,16,16,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
          <Grid Margin="0,0,8,0">
            <StackPanel x:Name="tabItemGeneral" Visibility="{Binding IsSelected, ElementName=navigationGeneral, Converter={StaticResource booleanToVisibilityCollapsedConverter}}">
