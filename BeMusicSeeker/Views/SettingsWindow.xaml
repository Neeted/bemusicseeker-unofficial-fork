                    <RadioButton Name="radioButtonNotUseLR2" GroupName="Operation Mode" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Not_use_LR2DB, Mode=OneWay}" IsChecked="{Binding OperationModeLR2DB, Converter={StaticResource notOperatorBoolConverter}, Mode=OneWay}" Click="operationModeRadioButtonClick" />
                    <RadioButton Name="radioButtonUseLR2" GroupName="Operation Mode" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Use_LR2_DB, Mode=OneWay}" IsChecked="{Binding OperationModeLR2DB, Mode=OneWay}" Click="operationModeRadioButtonClick" />
                    <Grid Margin="20,2,10,4" IsEnabled="{Binding IsChecked, ElementName=radioButtonUseLR2}">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Row="0" Grid.Column="1" Width="270" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Lr2PlayHistorySchemaDetailText, Mode=OneWay}">
                        <TextBlock.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="FontWeight" Value="Normal" />
                            <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding CanInstallOrRepairLr2PlayHistorySchema, Mode=OneWay}" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{DynamicResource App.WarningTextBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                        <Run Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_play_history_schema_label, Mode=OneWay}" />
                        <Run Text=": " />
                        <Run Text="{Binding Lr2PlayHistorySchemaStatusText, Mode=OneWay}" />
                      </TextBlock>
                      <Button Grid.Row="1" Grid.Column="0" Width="190" Height="24" HorizontalAlignment="Center" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_song_db_sync_data_resync, Mode=OneWay}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_song_db_sync_data_resync_tooltip, Mode=OneWay}" IsEnabled="{Binding CanRequestLr2SongDbSyncDataResync, Mode=OneWay}" Click="resyncLr2SongDbSyncDataButtonClicked" />
                      <Button Grid.Row="1" Grid.Column="1" Width="130" Height="24" HorizontalAlignment="Center" Content="{Binding Lr2PlayHistorySchemaInstallOrRepairButtonText, Mode=OneWay}" IsEnabled="{Binding CanInstallOrRepairLr2PlayHistorySchema, Mode=OneWay}" Click="installOrRepairLr2PlayHistorySchemaButtonClicked" />
                    </Grid>
                    <Grid Margin="10,0,0,4" IsEnabled="{Binding IsBmsSearchRootEditorEnabled}">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="120" />
                        <ColumnDefinition Width="3*" MinWidth="160" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Standalone_BMSDirectories, Mode=OneWay}" />
                      <Button Grid.Row="0" Grid.Column="2" MinWidth="88" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Add_BMSDirectory, Mode=OneWay}" Click="buttonAddBmsSearchRootPathsClicked" />
                      <ListBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="58" Margin="0,4,8,0" AllowDrop="True" Drop="bmsSearchRootPathListBoxDrop" PreviewDragEnter="bmsSearchRootPathListBoxDragOver" PreviewDragOver="bmsSearchRootPathListBoxDragOver" ItemsSource="{Binding AvailableBMSDirectories}" SelectedItem="{Binding SelectedBmsSearchRootPath, Mode=TwoWay}" />
                      <Button Grid.Row="1" Grid.Column="2" MinWidth="88" Margin="0,4,0,0" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Remove_BMSDirectory, Mode=OneWay}" Command="{Binding RemoveDirCommand}" CommandParameter="{Binding SelectedBmsSearchRootPath}" />
