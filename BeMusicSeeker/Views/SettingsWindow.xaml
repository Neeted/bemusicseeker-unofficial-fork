<?xml version="1.0" encoding="utf-8"?>
<views:ThemedWindow x:Class="BeMusicSeeker.Views.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels"
 xmlns:views="clr-namespace:BeMusicSeeker.Views"
 x:Name="settingsWindow"
 Width="820"
 Height="760"
 MinWidth="820"
 MinHeight="600"
 ResizeMode="CanResize"
 ShowInTaskbar="False"
 WindowStartupLocation="CenterOwner"
 Title="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_window_title, Mode=OneWay}"
 KeyDown="SettingsWindowKeyDown">
  <views:ThemedWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Settings/SettingsControls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </views:ThemedWindow.Resources>
  <Grid x:Name="settingDialogRootGrid" IsEnabled="{Binding IsEditCompletionEnabled}">
    <Grid x:Name="settingDialogOperationGrid" TextElement.Foreground="{DynamicResource App.TextBrush}">
      <Grid Background="{DynamicResource App.DialogBackgroundBrush}" SnapsToDevicePixels="True">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="216" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource App.SurfaceBrush}">
          <ListBox x:Name="settingsNavigation"
                   Style="{StaticResource SettingsListBoxStyle}"
                   SelectedIndex="0"
                   Padding="0,16"
                   BorderThickness="0"
                   Background="{x:Null}"
                   ItemContainerStyle="{StaticResource settingsNavigationItemStyle}"
                   AutomationProperties.AutomationId="SettingsCategoryNavigation"
                   KeyboardNavigation.DirectionalNavigation="Continue"
                   KeyboardNavigation.TabNavigation="Local"
                   SelectionChanged="settingsNavigationSelectionChanged">
            <ListBoxItem x:Name="navigationGeneral" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.General, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.General, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryGeneral" />
            <ListBoxItem x:Name="navigationAppearance" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryAppearance" />
            <ListBoxItem x:Name="navigationPlayback" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playback, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playback, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryPlayback" />
            <ListBoxItem x:Name="navigationAudio" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Audio, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Audio, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryAudio" />
            <ListBoxItem x:Name="navigationRecording" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Recording, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Recording, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryRecording" />
            <ListBoxItem x:Name="navigationPlaylist" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryPlaylist" />
            <ListBoxItem x:Name="navigationInstall" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Install, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Install, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryInstall" />
            <ListBoxItem x:Name="navigationBackup" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Backup, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Backup, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryBackup" />
            <ListBoxItem x:Name="navigationAdvanced" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Advanced_settings, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Advanced_settings, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryAdvanced" />
            <ListBoxItem x:Name="navigationAbout" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.About_this_app, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.About_this_app, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryAbout" />
          </ListBox>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource App.SeparatorBrush}" />
        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ContentControl x:Name="settingsPageHeader"
                          Grid.Row="0"
                          Margin="24,24,24,16"
                          Content="{Binding SelectedItem.Content, ElementName=settingsNavigation}"
                          AutomationProperties.AutomationId="SettingsSelectedPageHeader"
                          FontSize="26"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource App.TextBrush}"
                          IsTabStop="False" />
          <Border Grid.Row="1" Margin="24,0" Background="{DynamicResource App.SeparatorBrush}" />
          <ScrollViewer x:Name="settingsPageScrollViewer"
                        Grid.Row="2"
                        Style="{StaticResource SettingsScrollViewerStyle}"
                        Margin="24,16,16,16"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        CanContentScroll="False">
            <ContentControl x:Name="settingsPageContent"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalAlignment="Top"
                            AutomationProperties.AutomationId="SettingsSelectedPageContent" />
          </ScrollViewer>
          <Border Grid.Row="3" Background="{DynamicResource App.SeparatorBrush}" />
          <StackPanel x:Name="settingsFooter" Grid.Row="4" Margin="24,16" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="buttonOK" Style="{StaticResource SettingsPrimaryButtonStyle}" MinWidth="112" Margin="0,0,8,0" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Save_and_close, Mode=OneWay}" AutomationProperties.AutomationId="SettingsSaveAndClose" Click="buttonOKClick" />
            <Button x:Name="buttonCancel" Style="{StaticResource SettingsQuietButtonStyle}" MinWidth="88" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Cancel, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCancel" IsEnabled="{Binding IsEditCancellationEnabled}" Click="buttonCancelClick" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</views:ThemedWindow>
