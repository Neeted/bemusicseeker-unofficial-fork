<?xml version="1.0" encoding="utf-8"?>
<views:ThemedWindow x:Class="BeMusicSeeker.Views.PlayHistoryFolderDisplayPresetEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BeMusicSeeker.Views"
        xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels"
        Title="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Play_history_folder_display_preset_edit, Mode=OneWay}"
        Width="560"
        Height="520"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource App.DialogBackgroundBrush}"
        Foreground="{DynamicResource App.TextBrush}">
  <views:ThemedWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/BeMusicSeeker;component/BeMusicSeeker/Themes/CanonicalDialogStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </views:ThemedWindow.Resources>
  <Border Style="{StaticResource App.Canonical.NativeWindowContentStyle}">
    <Grid TextElement.Foreground="{DynamicResource App.TextBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0"
                 TextWrapping="Wrap"
                 Margin="0,0,0,10"
                 Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Play_history_folder_display_preset_desc, Mode=OneWay}" />

      <Grid Grid.Row="1" Margin="0,0,0,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0"
               Grid.Column="0"
               Style="{StaticResource App.Canonical.LabelStyle}"
               Height="28"
               Padding="0,4,8,0"
               Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Play_history_folder_display_preset_name, Mode=OneWay}" />
        <TextBox Grid.Row="0"
                 Grid.Column="1"
                 x:Name="PresetNameTextBox"
                 Style="{StaticResource App.Canonical.TextBoxStyle}"
                 Height="24"
                 VerticalContentAlignment="Center"
                 Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.AutomationId="PlayHistoryPresetName" />
        <Label Grid.Row="1"
               Grid.Column="0"
               Style="{StaticResource App.Canonical.LabelStyle}"
               Height="28"
               Padding="0,4,8,0"
               Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Play_history_folder_display_preset_search, Mode=OneWay}" />
        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 x:Name="PlaylistSearchTextBox"
                 Style="{StaticResource App.Canonical.TextBoxStyle}"
                 Height="24"
                 VerticalContentAlignment="Center"
                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.AutomationId="PlayHistoryPresetSearch" />
      </Grid>

      <Grid Grid.Row="2" MinHeight="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Label Grid.Row="0"
               Style="{StaticResource App.Canonical.LabelStyle}"
               Height="28"
               Padding="0,4,8,0"
               Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Play_history_folder_display_preset_playlists, Mode=OneWay}" />
        <ListBox Grid.Row="1"
                 x:Name="PlaylistOptionsList"
                 Style="{StaticResource App.Canonical.ListBoxStyle}"
                 MinHeight="0"
                 ItemsSource="{Binding FilteredPlaylistOptions}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 AutomationProperties.AutomationId="PlayHistoryPresetPlaylistList">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <CheckBox Style="{StaticResource App.Canonical.CheckBoxStyle}"
                        MinHeight="20"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        Content="{Binding DisplayName}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <StackPanel Grid.Row="3"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,10,0,0">
        <Button x:Name="SaveButton"
                MinWidth="72"
                Height="24"
                Margin="0,0,8,0"
                Style="{StaticResource App.Canonical.DialogPrimaryActionStyle}"
                Content="OK"
                IsDefault="True"
                AutomationProperties.AutomationId="PlayHistoryPresetSave"
                Click="SaveAndClose" />
        <Button x:Name="CancelButton"
                MinWidth="72"
                Height="24"
                Style="{StaticResource App.Canonical.DialogQuietActionStyle}"
                Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Cancel, Mode=OneWay}"
                IsCancel="True"
                AutomationProperties.AutomationId="PlayHistoryPresetCancel" />
      </StackPanel>
    </Grid>
  </Border>
</views:ThemedWindow>
