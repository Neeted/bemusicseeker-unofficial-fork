<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="BeMusicSeeker.Views.PlaybackPanelView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:BeMusicSeeker.Views" xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels" xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms" xmlns:prop="clr-namespace:BeMusicSeeker.Properties" x:Name="playbackPanelView" Height="286" VerticalAlignment="Top">
  <UserControl.Resources>
    <FontFamily x:Key="LigatureSymbols">/BeMusicSeeker;component/resources/#LigatureSymbols</FontFamily>
    <FontFamily x:Key="Commodore">/BeMusicSeeker;component/resources/#Commodore 64 Rounded</FontFamily>
    <v:windowsFormsHostVisibilitiesConverter x:Key="windowsFormsHostVisibilitiesConverter" />
    <v:panelStateToStringConverter x:Key="panelStateToStringConverter" />
    <v:panelStateToStringConverter2 x:Key="panelStateToStringConverter2" />
    <v:panelStateToTooltipConverter x:Key="panelStateToTooltipConverter" />
    <v:panelStateIsTitleSmallConverter x:Key="panelStateIsTitleSmallConverter" />
    <v:panelStateToVisibilityConverter x:Key="panelStateToVisibilityConverter" />
    <v:combineTitleAndArtistConverter x:Key="combineTitleAndArtistConverter" />
    <v:nowPlayingBMStoPlayButtonStringComverter x:Key="nowPlayingBMStoPlayButtonStringComverter" />
    <v:currentTimeConverter x:Key="currentTimeConverter" />
    <v:playingBmsInfoConverter x:Key="playingBmsInfoConverter" />
    <v:timeSpanToDoubleSecConverter x:Key="timeSpanToDoubleSecConverter" />
    <v:playerTitleVisibilityConverter x:Key="playerTitleVisibilityConverter" />
    <v:positiveTimeSpanToVisibilityHiddenConverter x:Key="positiveTimeSpanToVisibilityHiddenConverter" />
    <v:addStringToEndConverter x:Key="addStringToEndConverter" />
  </UserControl.Resources>
<Grid Name="gridBMSPlayer" Row="0" Column="0" ColumnSpan="2" Width="{Binding Width, ElementName=gridBMSPlayerBody}">
  <Grid.RowDefinitions>
    <RowDefinition Height="*" />
    <RowDefinition Height="30" />
  </Grid.RowDefinitions>
    <Grid Name="gridBMSPlayerBody" Grid.Row="0">
      <Image Name="gridBMSPlayerImage" Stretch="UniformToFill" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-10,-10,-10,0">
        <UIElement.Effect>
          <BlurEffect Radius="0" />
        </UIElement.Effect>
      </Image>
      <Grid Name="gridPlayerTitle" Height="80" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" ClipToBounds="True">
        <Grid.Visibility>
          <Binding Path="Visibility" ElementName="windowsFormsHost" Converter="{StaticResource playerTitleVisibilityConverter}" />
        </Grid.Visibility>
        <DockPanel Name="gridBMSPlayerTitlePanel" Height="40" LastChildFill="False" VerticalAlignment="Bottom" Background="#80000000">
          <TextBlock Name="gridBMSPlayerControlsArtist" DockPanel.Dock="Bottom" FontFamily="Meiryo" FontSize="12" Margin="0" Foreground="#FFFFFFFF" HorizontalAlignment="Center" Text="{Binding PlayerHeaderArtist}" />
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="3,3,3,0" HorizontalAlignment="Center">
            <TextBlock Name="gridBMSPlayerControlsTitle" FontFamily="Meiryo" FontSize="14" Margin="0" FontWeight="Bold" Foreground="#FFFFFFFF" HorizontalAlignment="Right" Text="{Binding PlayerHeaderTitle}" />
            <TextBlock Name="gridBMSPlayerControlsSubtitle" FontFamily="Meiryo" FontSize="14" Margin="5,0,0,0" Foreground="#FFFFFFFF" HorizontalAlignment="Left" Text="{Binding PlayerHeaderSubtitle}" />
          </StackPanel>
        </DockPanel>
        <Border Name="gridBMSPlayerControlsBanner" BorderThickness="0" BorderBrush="#FF404040" HorizontalAlignment="Center" VerticalAlignment="Center" Width="302" Height="80" Margin="0" Opacity="0" />
      </Grid>
      <Grid Name="gridPlayerFormsHost">
        <WindowsFormsHost Name="windowsFormsHost" Background="#FF000000" ClipToBounds="True" VerticalAlignment="Bottom" HorizontalAlignment="Center" MinWidth="587" Height="256" MaxHeight="256" Margin="0" IsEnabledChanged="windowsFormsHostIsEnabledChanged">
          <UIElement.Visibility>
            <MultiBinding Converter="{StaticResource windowsFormsHostVisibilitiesConverter}" Mode="OneWay" ConverterParameter="wfh">
              <Binding Path="OverlayVisibility" ElementName="playbackPanelView" />
              <Binding Path="IsEnabled" ElementName="windowsFormsHost" />
              <Binding Path="NowPlayingBmsFile" />
              <Binding RelativeSource="{RelativeSource Self}" />
            </MultiBinding>
          </UIElement.Visibility>
          <wf:Panel x:Name="_panel" Location="0,0" Size="587, 256" MinimumSize="587, 256" MaximumSize="587, 256" />
        </WindowsFormsHost>
      </Grid>
      <Grid Name="gridPlayngBmsInfo" HorizontalAlignment="Right" Width="220" Margin="0" Visibility="Hidden">
        <TextBlock Margin="0,0,0,-11" VerticalAlignment="Center" FontFamily="{StaticResource Commodore}" FontSize="13" Background="#33000000" Padding="5" Visibility="{Binding CurrentlyPlayingDuration, Converter={StaticResource positiveTimeSpanToVisibilityHiddenConverter}}">
          <UIElement.Effect>
            <DropShadowEffect ShadowDepth="2" BlurRadius="1" />
          </UIElement.Effect>
          <TextBlock.Foreground>
            <LinearGradientBrush EndPoint="0,0.5" StartPoint="0,0" SpreadMethod="Reflect">
              <GradientStop Color="#ffe6e5e5" Offset="0.4" />
              <GradientStop Color="#ffb2b3b8" Offset="1" />
            </LinearGradientBrush>
          </TextBlock.Foreground>
          <TextBlock.Text>
            <MultiBinding Converter="{StaticResource playingBmsInfoConverter}" Mode="OneWay">
              <Binding Path="CurrentlyPlayingBmsDuration" />
              <Binding Path="CurrentlyPlayingMusicDuration" />
              <Binding Path="CurrentlyPlayingStopTime" />
              <Binding Path="CurrentlyPlayingCurrentVoices" />
              <Binding Path="CurrentlyPlayingMaxVoices" />
              <Binding Path="CurrentlyPlayingNoteDensity" />
              <Binding Path="CurrentlyPlayingNoteDensityMax" />
              <Binding Path="CurrentlyPlayingBpm" />
              <Binding Path="CurrentlyPlayingMinBpm" />
              <Binding Path="CurrentlyPlayingMaxBpm" />
              <Binding Path="CurrentlyPlayingTotal" />
              <Binding Path="CurrentlyPlayingCombo" />
              <Binding Path="CurrentlyPlayingNotes" />
              <Binding Path="CurrentlyPlayingMeasure" />
              <Binding Path="CurrentlyPlayingLastMeasure" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
      </Grid>
    </Grid>
    <DockPanel Name="gridBMSPlayerControls" Grid.Row="1" Margin="0" MaxHeight="30" Height="30">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <Style x:Key="stylePlayerButton" TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Foreground">
              <Setter.Value>
                <LinearGradientBrush EndPoint="0,0.5" StartPoint="0,0" SpreadMethod="Reflect">
                  <GradientStop Color="#ffe6e5e5" Offset="0.4" />
                  <GradientStop Color="#ffb2b3b8" Offset="1" />
                </LinearGradientBrush>
              </Setter.Value>
            </Setter>
            <Setter Property="FontFamily" Value="{StaticResource LigatureSymbols}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="#00FFFFFF" />
            <Setter Property="BorderBrush" Value="{x:Null}" />
            <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Border Name="border" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True" CornerRadius="2">
                    <ContentPresenter Name="contentPresenter" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Content="{TemplateBinding ContentControl.Content}" ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}" Focusable="False" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" Margin="{TemplateBinding Control.Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" RenderTransformOrigin="0.5,0.5" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter Property="BorderBrush" Value="#FFFFFFFF" />
                      <Setter Property="BorderThickness" Value="1" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter Property="Foreground">
                        <Setter.Value>
                          <LinearGradientBrush EndPoint="0,0.5" StartPoint="0,0" SpreadMethod="Reflect">
                            <GradientStop Color="#ffb2b3b8" Offset="0.4" />
                            <GradientStop Color="#ff929398" Offset="1" />
                          </LinearGradientBrush>
                        </Setter.Value>
                      </Setter>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style x:Key="stylePlayerButtonSymbol" TargetType="{x:Type Button}" BasedOn="{StaticResource stylePlayerButton}">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
            <Setter Property="FontFamily" Value="{StaticResource LigatureSymbols}" />
          </Style>
          <Style x:Key="stylePlayerButtonSymbolShrink" TargetType="{x:Type Button}" BasedOn="{StaticResource stylePlayerButtonSymbol}">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Border Name="border" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True" CornerRadius="2">
                    <ContentPresenter Name="contentPresenter" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Content="{TemplateBinding ContentControl.Content}" ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}" Focusable="False" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" Margin="{TemplateBinding Control.Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" RenderTransformOrigin="0.5,0.5">
                      <UIElement.RenderTransform>
                        <TransformGroup>
                          <ScaleTransform ScaleY="0.8" />
                          <SkewTransform />
                          <RotateTransform />
                          <TranslateTransform />
                        </TransformGroup>
                      </UIElement.RenderTransform>
                    </ContentPresenter>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter Property="BorderBrush" Value="#FFFFFFFF" />
                      <Setter Property="BorderThickness" Value="1" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter Property="Foreground">
                        <Setter.Value>
                          <LinearGradientBrush EndPoint="0,0.5" StartPoint="0,0" SpreadMethod="Reflect">
                            <GradientStop Color="#ffb2b3b8" Offset="0.4" />
                            <GradientStop Color="#ff929398" Offset="1" />
                          </LinearGradientBrush>
                        </Setter.Value>
                      </Setter>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <Panel.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
          <GradientStop Color="#ff21262c" Offset="0.0" />
          <GradientStop Color="#ff40454a" Offset="0.05" />
          <GradientStop Color="#ff21262c" Offset="1" />
        </LinearGradientBrush>
      </Panel.Background>
      <Slider Name="sliderPlayer" DockPanel.Dock="Top" Margin="0,-10,0,-8" Height="18" VerticalAlignment="Top" Style="{DynamicResource SliderStylePlayer}" IsMoveToPointEnabled="True" LargeChange="0.1" Maximum="{Binding CurrentlyPlayingDuration, Converter={StaticResource timeSpanToDoubleSecConverter}}" Value="{Binding CurrentlyPlayingTime, Mode=TwoWay, Converter={StaticResource timeSpanToDoubleSecConverter}}" Visibility="{Binding CurrentlyPlayingDuration, Converter={StaticResource positiveTimeSpanToVisibilityHiddenConverter}}" MouseMove="sliderPlayerMouseMove" MouseLeave="sliderPlayerMouseLeave" PreviewMouseLeftButtonUp="sliderPlayerMouseLeftButtonUp" />
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="5,0,0,0">
        <Button Name="buttonBMSPlayerControlsPlayAndPauseButton" Style="{StaticResource stylePlayerButtonSymbol}" FontSize="17" Margin="0,1,0,0" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Tooltip_play_pause, Mode=OneWay}" Content="{Binding NowPlayingBmsFile.status, Converter={StaticResource nowPlayingBMStoPlayButtonStringComverter}, FallbackValue=play}" PreviewMouseLeftButtonDown="gridBMSPlayerControlsPlayStartButtonClicked" />
        <Button Content="stop" Style="{StaticResource stylePlayerButtonSymbol}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Tooltip_stop, Mode=OneWay}" PreviewMouseLeftButtonDown="gridBMSPlayerControlsPlayStopButtonClicked" />
        <Button Content="backback" Style="{StaticResource stylePlayerButtonSymbol}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Tooltip_previous_track, Mode=OneWay}" PreviewMouseLeftButtonDown="gridBMSPlayerControlsPreviousButtonClicked" />
        <Button Content="nextnext" Style="{StaticResource stylePlayerButtonSymbol}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Tooltip_next_track, Mode=OneWay}" PreviewMouseLeftButtonDown="gridBMSPlayerControlsNextButtonClicked" />
        <Button Content="leftleft" Style="{StaticResource stylePlayerButtonSymbolShrink}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Tooltip_rewind, Mode=OneWay}" IsEnabled="{Binding CanSeek}" PreviewMouseLeftButtonDown="gridBMSPlayerControlsFastBackwardButtonClicked" PreviewMouseLeftButtonUp="gridBMSPlayerControlsFastBackwardButtonReleased" MouseLeave="gridBMSPlayerControlsFastBackwardButtonReleased" />
        <Button Content="rightright" Style="{StaticResource stylePlayerButtonSymbolShrink}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Tooltip_fast_forward, Mode=OneWay}" IsEnabled="{Binding CanSeek}" PreviewMouseLeftButtonDown="gridBMSPlayerControlsFastForwardButtonClicked" PreviewMouseLeftButtonUp="gridBMSPlayerControlsFastForwardButtonReleased" MouseLeave="gridBMSPlayerControlsFastForwardButtonReleased" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="0,0,5,0">
        <Button Name="buttonBMSPlayerControlsRotatePanelState2" FlowDirection="LeftToRight" Style="{StaticResource stylePlayerButtonSymbol}" FontSize="20" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Tooltip_toggle_player_panel, Mode=OneWay}" Content="{Binding EffectivePlayerPanelState, ElementName=playbackPanelView, Mode=OneWay, Converter={StaticResource panelStateToStringConverter2}}" Click="gridBMSPlayerControlsRotatePanelStateButtonClicked2" />
        <Button Name="buttonBMSPlayerControlsRotatePanelState" FlowDirection="LeftToRight" Style="{StaticResource stylePlayerButtonSymbol}" FontSize="20" Content="{Binding EffectivePlayerPanelState, ElementName=playbackPanelView, Mode=OneWay, Converter={StaticResource panelStateToStringConverter}}" ToolTip="{Binding EffectivePlayerPanelState, ElementName=playbackPanelView, Mode=OneWay, Converter={StaticResource panelStateToTooltipConverter}}" Click="gridBMSPlayerControlsRotatePanelStateButtonClicked" />
        <Button Content="gear" Style="{StaticResource stylePlayerButtonSymbol}" FlowDirection="LeftToRight" FontSize="20" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_window_title, Mode=OneWay}" Command="{Binding SettingsCommand, ElementName=playbackPanelView}" />
        <v:DropDownMenuButton Width="25" Height="25" Template="{DynamicResource templateDropmenuButtonSetting}" FontSize="17" FlowDirection="LeftToRight" Margin="0,1,0,0" BorderThickness="0" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Tooltip_player_settings, Mode=OneWay}">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <ControlTemplate x:Key="templateDropmenuButtonSetting" TargetType="{x:Type ToggleButton}">
                <Border Name="border" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="2">
                  <Grid Name="grid" Background="#00FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight">
                    <TextBlock Name="textBlock" Text="setup" FontSize="{TemplateBinding Control.FontSize}" Foreground="{TemplateBinding Control.Foreground}" FontFamily="{StaticResource LigatureSymbols}" />
                    <Path Width="6" Height="5" Margin="13,0,0,0" Stretch="Fill" Fill="{TemplateBinding Control.Foreground}" Data="F1 M57.5692,88 L99.1384,16 L16,16 L57.5692,88" />
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Border.BorderBrush" Value="#FFFFFFFF" />
                    <Setter TargetName="border" Property="Border.BorderThickness" Value="1" />
                  </Trigger>
                  <Trigger Property="ButtonBase.IsPressed" Value="True">
                    <Setter TargetName="textBlock" Property="TextBlock.Foreground">
                      <Setter.Value>
                        <LinearGradientBrush EndPoint="0,0.5" StartPoint="0,0" SpreadMethod="Reflect">
                          <GradientStop Color="#ffb2b3b8" Offset="0.4" />
                          <GradientStop Color="#ff929398" Offset="1" />
                        </LinearGradientBrush>
                      </Setter.Value>
                    </Setter>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <Control.Foreground>
            <LinearGradientBrush EndPoint="0,0.5" StartPoint="0,0" SpreadMethod="Reflect">
              <GradientStop Color="#ffe6e5e5" Offset="0.4" />
              <GradientStop Color="#ffb2b3b8" Offset="1" />
            </LinearGradientBrush>
          </Control.Foreground>
          <v:DropDownMenuButton.DropDownContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem>
                <HeaderedItemsControl.Header>
                  <UniformGrid Rows="1" Columns="2" Width="150" IsEnabled="{Binding CanChangeHighSpeed}">
                    <Button Content="HS UP" Padding="5,1" Command="{Binding IncreaseHighSpeedCommand}" />
                    <Button Content="HS DOWN" Padding="5,1" Command="{Binding DecreaseHighSpeedCommand}" />
                  </UniformGrid>
                </HeaderedItemsControl.Header>
              </MenuItem>
              <MenuItem>
                <HeaderedItemsControl.Header>
                  <UniformGrid Rows="1" Columns="3" Width="150">
                    <Button Content="Info" Padding="5,1" IsEnabled="{Binding CanShowInfo}" Click="gridBMSPlayerControlsShowInfoButtonClicked" />
                    <Button Content="Effect" Padding="3,1" IsEnabled="{Binding CanShowEffect}" Command="{Binding ShowEffectCommand}" />
                    <Button Content="1P/2P" Padding="5,1" IsEnabled="{Binding CanChangePlayside}" Command="{Binding ChangePlaysideCommand}" />
                  </UniformGrid>
                </HeaderedItemsControl.Header>
              </MenuItem>
              <MenuItem>
                <HeaderedItemsControl.Header>
                  <DockPanel Width="150">
                    <TextBlock DockPanel.Dock="Right" Margin="5,0,0,0" HorizontalAlignment="Right" Text="{Binding PlayerVolume, Converter={StaticResource addStringToEndConverter}, ConverterParameter=%|}" />
                    <Slider Style="{DynamicResource SimpleSlider}" DockPanel.Dock="Left" VerticalAlignment="Bottom" Margin="0" AutoToolTipPlacement="TopLeft" Maximum="100" LargeChange="10" SmallChange="1" Height="15" RenderTransformOrigin="0.5,0.5" Background="#FF4492F0" Value="{Binding PlayerVolume, Mode=TwoWay}" />
                  </DockPanel>
                </HeaderedItemsControl.Header>
              </MenuItem>
              <Separator />
              <MenuItem Header="REPEAT" IsCheckable="True" IsChecked="{Binding RepeatPlayMode, Mode=TwoWay}" />
              <MenuItem Header="FOLDER SKIP" IsCheckable="True" IsChecked="{Binding FolderSkipPlayMode, Mode=TwoWay}" />
              <MenuItem Header="SINGLE PLAY" IsCheckable="True" IsChecked="{Binding SinglePlayMode, Mode=TwoWay}" />
            </ContextMenu>
          </v:DropDownMenuButton.DropDownContextMenu>
        </v:DropDownMenuButton>
      </StackPanel>
      <TextBlock HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11" Margin="0,3,5,0" Visibility="{Binding CurrentlyPlayingDuration, Converter={StaticResource positiveTimeSpanToVisibilityHiddenConverter}}">
        <TextBlock.Foreground>
          <LinearGradientBrush EndPoint="0,0.5" StartPoint="0,0" SpreadMethod="Reflect">
            <GradientStop Color="#ffe6e5e5" Offset="0.4" />
            <GradientStop Color="#ffb2b3b8" Offset="1" />
          </LinearGradientBrush>
        </TextBlock.Foreground>
        <TextBlock.Text>
          <MultiBinding Converter="{StaticResource currentTimeConverter}" Mode="OneWay">
            <Binding Path="CurrentlyPlayingDuration" />
            <Binding Path="CurrentlyPlayingTime" />
          </MultiBinding>
        </TextBlock.Text>
      </TextBlock>
      <TextBlock Name="gridBMSPlayerControlsTitle2" DockPanel.Dock="Left" FontFamily="Meiryo" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,10,0" FontWeight="Bold" Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis" Opacity="1">
        <UIElement.Visibility>
          <MultiBinding Converter="{StaticResource panelStateToVisibilityConverter}">
            <Binding Path="Visibility" ElementName="gridPlayerTitle" />
            <Binding Path="EffectivePlayerPanelState" ElementName="playbackPanelView" />
          </MultiBinding>
        </UIElement.Visibility>
        <TextBlock.Text>
          <MultiBinding Converter="{StaticResource combineTitleAndArtistConverter}">
            <Binding Path="PlayerHeaderTitle" />
            <Binding Path="PlayerHeaderSubtitle" />
            <Binding Path="PlayerHeaderArtist" />
          </MultiBinding>
        </TextBlock.Text>
      </TextBlock>
    </DockPanel>
</Grid>
</UserControl>
