<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="BeMusicSeeker.Views.SettingDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:v="clr-namespace:BeMusicSeeker.Views" xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:prop="clr-namespace:BeMusicSeeker.Properties" x:Name="settingDialog">
  <Grid Name="settingDialogRootGrid" IsEnabled="{Binding IsEditCompletionEnabled}">
    <Grid Name="settingDialogOperationGrid" TextElement.Foreground="{DynamicResource App.TextBrush}">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <v:expanderDetailedLR2PathConverter x:Key="expanderDetailedLR2PathConverter" />
        <v:backupTargetConverter x:Key="backupTargetConverter" />
        <v:lr2DetailedPathAutoExpandConverter x:Key="lr2DetailedPathAutoExpandConverter" />
        <v:notOperatorBoolConverter x:Key="notOperatorBoolConverter" />
        <v:playerDriverSelectionEnabledConverter x:Key="playerDriverSelectionEnabledConverter" />
        <v:wasapiDriverSelectionEnabledConverter x:Key="wasapiDriverSelectionEnabledConverter" />
        <v:encoderDriverSelectionEnabledConverter x:Key="encoderDriverSelectionEnabledConverter" />
        <v:wasapiControlEnabledConverter x:Key="wasapiControlEnabledConverter" />
        <v:backupSpanRadioConverter x:Key="backupSpanRadioConverter" />
        <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource {x:Type TabControl}}">
          <Setter Property="Margin" Value="0,0,0,10" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type TabControl}">
                <Grid KeyboardNavigation.TabNavigation="Local">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <TabPanel Name="HeaderPanel" Grid.Row="0" Margin="0,0,4,-1" Background="#00FFFFFF" IsItemsHost="True" ZIndex="1" KeyboardNavigation.TabIndex="1" />
                  <Border Name="Border" Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource SolidBorderBrush}" BorderThickness="1" CornerRadius="0,4,4,4" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="2">
                    <ScrollViewer Margin="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <ContentPresenter Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                    </ScrollViewer>
                  </Border>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Value="{DynamicResource DisabledForegroundBrush}" Property="Foreground" />
                    <Setter Value="{DynamicResource DisabledBorderBrush}" TargetName="Border" Property="Border.BorderBrush" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
          <Setter Property="Padding" Value="10,4,10,4" />
          <Setter Property="FontFamily" Value="Meiryo UI" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type TabItem}">
                <Grid>
                  <Border Name="Border" Margin="0,0,-4,0" Background="{DynamicResource LightBrush}" BorderBrush="{DynamicResource SolidBorderBrush}" BorderThickness="1,1,1,1" CornerRadius="2,2,0,0">
                    <ContentPresenter Name="ContentSite" HorizontalAlignment="Center" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center" RecognizesAccessKey="True" ContentSource="Header" TextElement.Foreground="{TemplateBinding Control.Foreground}" />
                  </Border>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="TabItem.IsSelected" Value="True">
                    <Setter Property="Panel.ZIndex" Value="100" />
                    <Setter Value="{DynamicResource WindowBackgroundBrush}" TargetName="Border" Property="Border.Background" />
                    <Setter TargetName="Border" Property="Border.BorderThickness" Value="1,1,1,0" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Value="{DynamicResource DisabledBackgroundBrush}" TargetName="Border" Property="Border.Background" />
                    <Setter Value="{DynamicResource DisabledBorderBrush}" TargetName="Border" Property="Border.BorderBrush" />
                    <Setter Value="{DynamicResource DisabledForegroundBrush}" Property="Foreground" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource {x:Type GroupBox}}">
          <Setter Property="Margin" Value="0,0,0,8" />
          <Setter Property="Padding" Value="10,8,10,10" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type GroupBox}">
                <Grid SnapsToDevicePixels="True">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <ContentPresenter Grid.Row="0" Margin="2,0,0,3" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Control.Foreground}" TextElement.FontWeight="SemiBold" />
                  <Border Grid.Row="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}" CornerRadius="4">
                    <ContentPresenter Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Control.Foreground}" />
                  </Border>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
          <Setter Property="MinHeight" Value="24" />
          <Setter Property="Padding" Value="10,2" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
          <Setter Property="MinHeight" Value="24" />
          <Setter Property="Padding" Value="5,1" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
          <Setter Property="MinHeight" Value="24" />
          <Setter Property="Padding" Value="5,1" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type Label}" BasedOn="{StaticResource {x:Type Label}}">
          <Setter Property="MinHeight" Value="24" />
          <Setter Property="Padding" Value="0,4,8,4" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
          <Setter Property="MinHeight" Value="20" />
          <Setter Property="Padding" Value="4,1,0,1" />
        </Style>
        <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource {x:Type RadioButton}}">
          <Setter Property="MinHeight" Value="20" />
          <Setter Property="Padding" Value="4,1,0,1" />
        </Style>
        <Style x:Key="styleWrappingSettingCheckBox" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
          <Setter Property="MinHeight" Value="20" />
          <Setter Property="Padding" Value="4,1,0,1" />
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Setter Property="ContentTemplate">
            <Setter.Value>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="styleTextBlockActiveForeground" TargetType="{x:Type TextBlock}">
          <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Rectangle Fill="{DynamicResource App.DialogOverlayBrush}" Opacity="0.5" />
    <Border Width="640" Height="500" CornerRadius="8" Background="{DynamicResource App.DialogBackgroundBrush}" BorderBrush="{DynamicResource App.DialogBorderBrush}" BorderThickness="1" Padding="12" SnapsToDevicePixels="True">
      <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" LastChildFill="True">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Name="buttonOK" Content="OK" MinWidth="64" Margin="0,0,8,0" Click="buttonOKClick" />
            <Button Name="buttonCancel" Content="Cancel" MinWidth="64" IsEnabled="{Binding IsEditCancellationEnabled}" Command="{Binding CancelCommand}" />
          </StackPanel>
          <TabControl DockPanel.Dock="Top">
            <TabItem Name="tabItemGeneral" FontFamily="Meiryo UI" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.General, Mode=OneWay}">
              <StackPanel>
                <GroupBox Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Language, Mode=OneWay}">
                  <ComboBox Height="24" IsReadOnly="True" Width="150" MaxDropDownHeight="260" VerticalContentAlignment="Center" HorizontalAlignment="Center" ItemsSource="{Binding Languages, Mode=OneWay}" SelectedItem="{Binding Path=Language}" />
                </GroupBox>
                <GroupBox Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Operation_Mode, Mode=OneWay}">
                  <StackPanel>
                    <RadioButton Name="radioButtonNotUseLR2" Height="20" GroupName="Operation Mode" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Not_use_LR2DB, Mode=OneWay}" IsChecked="{Binding OperationModeLR2DB, Converter={StaticResource notOperatorBoolConverter}}" />
                    <RadioButton Name="radioButtonUseLR2" Height="20" GroupName="Operation Mode" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Use_LR2_DB, Mode=OneWay}" IsChecked="{Binding OperationModeLR2DB}" />
                    <Grid Margin="20,2,10,4" IsEnabled="{Binding IsChecked, ElementName=radioButtonUseLR2}">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Row="0" Grid.Column="1" Width="270" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Lr2PlayHistorySchemaDetailText, Mode=OneWay}">
                        <TextBlock.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="FontWeight" Value="Normal" />
                            <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding CanInstallOrRepairLr2PlayHistorySchema, Mode=OneWay}" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{DynamicResource App.WarningTextBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                        <Run Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_play_history_schema_label, Mode=OneWay}" />
                        <Run Text=": " />
                        <Run Text="{Binding Lr2PlayHistorySchemaStatusText, Mode=OneWay}" />
                      </TextBlock>
                      <Button Grid.Row="1" Grid.Column="0" Width="190" Height="24" HorizontalAlignment="Center" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_song_db_sync_data_resync, Mode=OneWay}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_song_db_sync_data_resync_tooltip, Mode=OneWay}" IsEnabled="{Binding CanRequestLr2SongDbSyncDataResync, Mode=OneWay}" Click="resyncLr2SongDbSyncDataButtonClicked" />
                      <Button Grid.Row="1" Grid.Column="1" Width="130" Height="24" HorizontalAlignment="Center" Content="{Binding Lr2PlayHistorySchemaInstallOrRepairButtonText, Mode=OneWay}" IsEnabled="{Binding CanInstallOrRepairLr2PlayHistorySchema, Mode=OneWay}" Click="installOrRepairLr2PlayHistorySchemaButtonClicked" />
                    </Grid>
                    <Grid Margin="10,0,0,4" IsEnabled="{Binding IsBmsSearchRootEditorEnabled}">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <DockPanel Grid.Row="0" LastChildFill="False">
                        <Button Width="75" DockPanel.Dock="Right" Height="24" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Add_BMSDirectory, Mode=OneWay}" Click="buttonAddBmsSearchRootPathsClicked" />
                        <Label Height="28" HorizontalContentAlignment="Right" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Standalone_BMSDirectories, Mode=OneWay}" />
                      </DockPanel>
                      <DockPanel Grid.Row="1" LastChildFill="True">
                        <Button Width="75" DockPanel.Dock="Right" Height="24" Margin="4,0,0,0" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Remove_BMSDirectory, Mode=OneWay}" Command="{Binding RemoveDirCommand}" CommandParameter="{Binding SelectedBmsSearchRootPath}" />
                        <ListBox Height="58" AllowDrop="True" Drop="bmsSearchRootPathListBoxDrop" PreviewDragEnter="bmsSearchRootPathListBoxDragOver" PreviewDragOver="bmsSearchRootPathListBoxDragOver" ItemsSource="{Binding AvailableBMSDirectories}" SelectedItem="{Binding SelectedBmsSearchRootPath, Mode=TwoWay}" />
                      </DockPanel>
                    </Grid>
                    <DockPanel LastChildFill="False">
                      <Button Width="75" DockPanel.Dock="Right" Height="24" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}" Click="browseLr2RootPathButtonClick">
                        <UIElement.IsEnabled>
                          <MultiBinding Converter="{StaticResource expanderDetailedLR2PathConverter}">
                            <Binding Path="IsChecked" ElementName="radioButtonUseLR2" />
                            <Binding Path="IsExpanded" ElementName="expanderDetailedLR2Path" />
                          </MultiBinding>
                        </UIElement.IsEnabled>
                      </Button>
                      <TextBox Name="textBox" Height="24" IsReadOnly="True" DockPanel.Dock="Right" VerticalContentAlignment="Center" Width="225">
                        <Binding x:Name="bindingLR2RootPath" Path="LR2RootPath" />
                        <UIElement.IsEnabled>
                          <MultiBinding Converter="{StaticResource expanderDetailedLR2PathConverter}">
                            <Binding Path="IsChecked" ElementName="radioButtonUseLR2" />
                            <Binding Path="IsExpanded" ElementName="expanderDetailedLR2Path" />
                          </MultiBinding>
                        </UIElement.IsEnabled>
                      </TextBox>
                      <Label Height="28" HorizontalContentAlignment="Right" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.DirPath_LR2, Mode=OneWay}" />
                    </DockPanel>
                    <Expander Name="expanderDetailedLR2Path" Margin="10,0,0,0" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details, Mode=OneWay}">
                      <Expander.IsExpanded>
                        <MultiBinding Mode="OneTime" Converter="{StaticResource lr2DetailedPathAutoExpandConverter}">
                          <Binding Path="LR2RootPath" />
                          <Binding Path="LR2SongDBPath" />
                          <Binding Path="LR2ConfigXmlPath" />
                        </MultiBinding>
                      </Expander.IsExpanded>
                      <StackPanel>
                        <DockPanel LastChildFill="False">
                          <Button Width="75" DockPanel.Dock="Right" Height="24" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}" IsEnabled="{Binding IsChecked, ElementName=radioButtonUseLR2}" Click="browseLr2SongDbPathButtonClick" />
                          <TextBox Height="24" IsReadOnly="True" DockPanel.Dock="Right" IsEnabled="{Binding IsChecked, ElementName=radioButtonUseLR2}" Width="{Binding ActualWidth, ElementName=textBox, Mode=OneWay}">
                            <Binding x:Name="bindingLR2SongDBPath" Path="LR2SongDBPath" />
                          </TextBox>
                          <Label Height="28" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.FilePath_songDB, Mode=OneWay}" />
                        </DockPanel>
                        <DockPanel LastChildFill="False">
                          <Button Width="75" DockPanel.Dock="Right" Height="24" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}" IsEnabled="{Binding IsChecked, ElementName=radioButtonUseLR2}" Click="browseLr2ConfigPathButtonClick" />
                          <TextBox Height="24" IsReadOnly="True" DockPanel.Dock="Right" IsEnabled="{Binding IsChecked, ElementName=radioButtonUseLR2}" Width="{Binding ActualWidth, ElementName=textBox, Mode=OneWay}">
                            <Binding x:Name="bindingLR2ConfigPath" Path="LR2ConfigXmlPath" />
                          </TextBox>
                          <Label Height="28" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.FilePath_configXml, Mode=OneWay}" />
                        </DockPanel>
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </GroupBox>
                <GroupBox Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Beatoraja_integration, Mode=OneWay}">
                  <StackPanel>
                    <DockPanel LastChildFill="False">
                      <Button Width="75" DockPanel.Dock="Right" Height="24" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}" Click="browseBeatorajaRootPathButtonClick" />
                      <TextBox Height="24" IsReadOnly="True" DockPanel.Dock="Right" Width="{Binding ActualWidth, ElementName=textBox, Mode=OneWay}">
                        <Binding x:Name="bindingBeatorajaRootPath" Path="BeatorajaRootPath" />
                      </TextBox>
                      <Label Height="28" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.FilePath_beatoraja_root, Mode=OneWay}" />
                    </DockPanel>
                    <Button Height="24" Margin="0,2,0,4" Padding="12,0" HorizontalAlignment="Center" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Import_beatoraja_table_urls_button, Mode=OneWay}" Click="importBeatorajaTableUrlsButtonClick" />
                    <CheckBox Height="20" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Use_beatoraja_scoreDB, Mode=OneWay}" IsChecked="{Binding UseBeatorajaScoreDb}" />
                    <DockPanel LastChildFill="False">
                      <ComboBox Width="160" Height="24" DockPanel.Dock="Right" IsEnabled="{Binding UseBeatorajaScoreDb}" ItemsSource="{Binding AvailableBeatorajaPlayers}" SelectedItem="{Binding BeatorajaPlayerId}" />
                      <Label Height="28" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Beatoraja_player, Mode=OneWay}" />
                    </DockPanel>
                    <CheckBox Height="20" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Use_beatoraja_bmt_output, Mode=OneWay}" IsChecked="{Binding EnableBeatorajaBmtOutput}" />
                    <DockPanel LastChildFill="False" Margin="16,0,0,0" IsEnabled="{Binding EnableBeatorajaBmtOutput}">
                      <ComboBox Width="180" Height="24" DockPanel.Dock="Right" ItemsSource="{Binding BeatorajaBmtHashOutputModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Key" SelectedValue="{Binding BeatorajaBmtHashOutputMode, Mode=TwoWay}" />
                      <Label Height="28" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Beatoraja_bmt_hash_output_mode, Mode=OneWay}" />
                    </DockPanel>
                    <CheckBox Height="20" Margin="16,0,0,0" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Keep_beatoraja_bmt_files_when_output_disabled, Mode=OneWay}" IsChecked="{Binding KeepBeatorajaBmtFilesWhenOutputDisabled}" />
                    <CheckBox Height="20" Margin="16,0,0,0" IsEnabled="{Binding EnableBeatorajaBmtOutput}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Register_beatoraja_bmt_urls, Mode=OneWay}" IsChecked="{Binding RegisterBeatorajaBmtUrls}" />
                  </StackPanel>
                </GroupBox>
              </StackPanel>
            </TabItem>
            <TabItem Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance, Mode=OneWay}">
              <StackPanel>
                <GroupBox Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance, Mode=OneWay}">
                  <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                      <ComboBox Name="comboBoxAppearanceTheme" Width="120" Height="24" DockPanel.Dock="Right" ItemsSource="{Binding AppearanceThemeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Key" SelectedValue="{Binding AppearanceTheme, Mode=TwoWay}" />
                      <Label Height="28" HorizontalContentAlignment="Right" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance_theme, Mode=OneWay}" />
                    </DockPanel>
                    <GroupBox Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance_table, Mode=OneWay}" Margin="0,2,0,6">
                      <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,3">
                          <TextBox Width="48" Height="24" DockPanel.Dock="Right" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Text="{Binding CustomTableFontSize, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F0}}" />
                          <Slider Width="160" Height="24" DockPanel.Dock="Right" Minimum="8" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CustomTableFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                          <Label Height="28" HorizontalContentAlignment="Right" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance_table_font_size, Mode=OneWay}" />
                        </DockPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,3">
                          <TextBox Width="48" Height="24" DockPanel.Dock="Right" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Text="{Binding CustomTableRowHeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F0}}" />
                          <Slider Width="160" Height="24" DockPanel.Dock="Right" Minimum="16" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CustomTableRowHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                          <Label Height="28" HorizontalContentAlignment="Right" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance_table_row_height, Mode=OneWay}" />
                        </DockPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                          <TextBox Width="48" Height="24" DockPanel.Dock="Right" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Text="{Binding CustomTableHeaderHeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F0}}" />
                          <Slider Width="160" Height="24" DockPanel.Dock="Right" Minimum="18" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CustomTableHeaderHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                          <Label Height="28" HorizontalContentAlignment="Right" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance_table_header_height, Mode=OneWay}" />
                        </DockPanel>
                        <Button Height="24" Padding="12,0" HorizontalAlignment="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance_table_reset_defaults, Mode=OneWay}" Click="resetCustomTableAppearanceDefaultsButtonClick" />
                      </StackPanel>
                    </GroupBox>
                    <CheckBox Name="checkBoxUseExternalPanelImage" IsChecked="{Binding UseExternalPanelImage}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Change_stage_file, Mode=OneWay}" />
                    <DockPanel LastChildFill="False" IsEnabled="{Binding IsChecked, ElementName=checkBoxUseExternalPanelImage}">
                      <Button Width="75" DockPanel.Dock="Right" Height="24" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}" Click="browseStagefilePathButtonClick" />
                      <TextBox Height="24" IsReadOnly="True" DockPanel.Dock="Right" VerticalContentAlignment="Center" Width="{Binding ActualWidth, ElementName=textBox, Mode=OneWay}">
                        <Binding x:Name="bindingStagefilePath" Path="StagefilePath" />
                      </TextBox>
                      <Label Height="28" HorizontalContentAlignment="Right" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.FilePath_StageFile, Mode=OneWay}" />
                    </DockPanel>
                  </StackPanel>
                </GroupBox>
              </StackPanel>
            </TabItem>
            <TabItem Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playback, Mode=OneWay}">
              <StackPanel>
                <GroupBox Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Player, Mode=OneWay}">
                  <StackPanel>
                    <Label Height="28" DockPanel.Dock="Top" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Player_Use, Mode=OneWay}" />
                    <DockPanel LastChildFill="False">
                      <RadioButton Name="radioButtonInternalPlayer" Height="20" GroupName="Player" Margin="30,0,0,0" IsChecked="{Binding UseInternalPlayer}" DockPanel.Dock="Top" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Player_Name_Internal, Mode=OneWay}" />
                      <DockPanel Dock="Bottom">
                        <StackPanel DockPanel.Dock="Bottom">
                          <TextBlock Margin="0,0,5,5" HorizontalAlignment="Right" Width="294" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Player_Internal_desc, Mode=OneWay}" Style="{StaticResource styleTextBlockActiveForeground}" Tag="{Binding IsChecked, ElementName=radioButtonInternalPlayer}" />
                        </StackPanel>
                      </DockPanel>
                    </DockPanel>
                    <DockPanel LastChildFill="False">
                      <RadioButton Name="radioButtonPlayuBMplay" Content="uBMplay: " Height="20" GroupName="Player" Margin="30,2,0,0" VerticalAlignment="Top" IsChecked="{Binding UsePlayeruBMplay}" />
                      <DockPanel Dock="Right">
                        <StackPanel DockPanel.Dock="Bottom">
                          <TextBlock Margin="5" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Player_uBMplay_desc, Mode=OneWay}" Style="{StaticResource styleTextBlockActiveForeground}" Tag="{Binding IsChecked, ElementName=radioButtonPlayuBMplay}" />
                        </StackPanel>
                        <Button Width="75" DockPanel.Dock="Right" Height="24" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}" IsEnabled="{Binding IsChecked, ElementName=radioButtonPlayuBMplay}" Click="browseUbmplayPathButtonClick" />
