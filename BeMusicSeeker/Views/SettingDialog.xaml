                    </DockPanel>
                    <TextBlock Name="textBlockVerNum" Text="0.0.0.0" VerticalAlignment="Bottom" FontWeight="Bold" HorizontalAlignment="Right"/>  
                    <TextBlock Name="textBlockBuildNum" Text="Build: 0.0.0.0" HorizontalAlignment="Right" />
