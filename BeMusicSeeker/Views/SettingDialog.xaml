<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="BeMusicSeeker.Views.SettingDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:l="http://schemas.livet-mvvm.net/2011/wpf" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:v="clr-namespace:BeMusicSeeker.Views" xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:qc="http://QuickConverter.CodePlex.com/" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:prop="clr-namespace:BeMusicSeeker.Properties" x:Name="settingDialog">
  <Grid Name="settingDialogRootGrid" TextElement.Foreground="{DynamicResource App.TextBrush}">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <v:expanderDetailedLR2PathConverter x:Key="expanderDetailedLR2PathConverter" />
        <v:backupTargetConverter x:Key="backupTargetConverter" />
        <v:lr2DetailedPathAutoExpandConverter x:Key="lr2DetailedPathAutoExpandConverter" />
        <v:pathToDirectoryOrSelfConverter x:Key="pathToDirectoryOrSelfConverter" />
        <v:firstNonEmptyStringConverter x:Key="firstNonEmptyStringConverter" />
        <v:firstNonEmptyStringOrDirectoryOfSecondConverter x:Key="firstNonEmptyStringOrDirectoryOfSecondConverter" />
        <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource {x:Type TabControl}}">
          <Setter Property="Margin" Value="0,0,0,10" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type TabControl}">
                <Grid KeyboardNavigation.TabNavigation="Local">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <TabPanel Name="HeaderPanel" Grid.Row="0" Margin="0,0,4,-1" Background="#00FFFFFF" IsItemsHost="True" ZIndex="1" KeyboardNavigation.TabIndex="1" />
                  <Border Name="Border" Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource SolidBorderBrush}" BorderThickness="1" CornerRadius="0,4,4,4" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="2">
                    <ScrollViewer Margin="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <ContentPresenter Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                    </ScrollViewer>
                  </Border>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Value="{DynamicResource DisabledForegroundBrush}" Property="Foreground" />
                    <Setter Value="{DynamicResource DisabledBorderBrush}" TargetName="Border" Property="Border.BorderBrush" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
          <Setter Property="Padding" Value="10,4,10,4" />
          <Setter Property="FontFamily" Value="Meiryo UI" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type TabItem}">
                <Grid>
                  <Border Name="Border" Margin="0,0,-4,0" Background="{DynamicResource LightBrush}" BorderBrush="{DynamicResource SolidBorderBrush}" BorderThickness="1,1,1,1" CornerRadius="2,2,0,0">
                    <ContentPresenter Name="ContentSite" HorizontalAlignment="Center" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center" RecognizesAccessKey="True" ContentSource="Header" TextElement.Foreground="{TemplateBinding Control.Foreground}" />
                  </Border>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="TabItem.IsSelected" Value="True">
                    <Setter Property="Panel.ZIndex" Value="100" />
                    <Setter Value="{DynamicResource WindowBackgroundBrush}" TargetName="Border" Property="Border.Background" />
                    <Setter TargetName="Border" Property="Border.BorderThickness" Value="1,1,1,0" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Value="{DynamicResource DisabledBackgroundBrush}" TargetName="Border" Property="Border.Background" />
                    <Setter Value="{DynamicResource DisabledBorderBrush}" TargetName="Border" Property="Border.BorderBrush" />
                    <Setter Value="{DynamicResource DisabledForegroundBrush}" Property="Foreground" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource {x:Type GroupBox}}">
          <Setter Property="Margin" Value="0,0,0,8" />
          <Setter Property="Padding" Value="10,8,10,10" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type GroupBox}">
                <Grid SnapsToDevicePixels="True">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <ContentPresenter Grid.Row="0" Margin="2,0,0,3" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Control.Foreground}" TextElement.FontWeight="SemiBold" />
                  <Border Grid.Row="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}" CornerRadius="4">
                    <ContentPresenter Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Control.Foreground}" />
                  </Border>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
          <Setter Property="MinHeight" Value="24" />
          <Setter Property="Padding" Value="10,2" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
          <Setter Property="MinHeight" Value="24" />
          <Setter Property="Padding" Value="5,1" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
          <Setter Property="MinHeight" Value="24" />
          <Setter Property="Padding" Value="5,1" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type Label}" BasedOn="{StaticResource {x:Type Label}}">
          <Setter Property="MinHeight" Value="24" />
          <Setter Property="Padding" Value="0,4,8,4" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
          <Setter Property="MinHeight" Value="20" />
          <Setter Property="Padding" Value="4,1,0,1" />
        </Style>
        <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource {x:Type RadioButton}}">
          <Setter Property="MinHeight" Value="20" />
          <Setter Property="Padding" Value="4,1,0,1" />
        </Style>
        <Style x:Key="styleWrappingSettingCheckBox" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
          <Setter Property="MinHeight" Value="20" />
          <Setter Property="Padding" Value="4,1,0,1" />
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Setter Property="ContentTemplate">
            <Setter.Value>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="styleTextBlockActiveForeground" TargetType="{x:Type TextBlock}">
          <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Rectangle Fill="{DynamicResource App.DialogOverlayBrush}" Opacity="0.5" />
    <Border Width="640" Height="500" CornerRadius="8" Background="{DynamicResource App.DialogBackgroundBrush}" BorderBrush="{DynamicResource App.DialogBorderBrush}" BorderThickness="1" Padding="12" SnapsToDevicePixels="True">
      <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" LastChildFill="True">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Name="buttonOK" Content="OK" MinWidth="64" Margin="0,0,8,0" Click="SaveAndClose" />
            <Button Name="buttonCancel" Content="Cancel" MinWidth="64" Click="CancelAndClose" />
          </StackPanel>
          <TabControl DockPanel.Dock="Top">
            <TabItem Name="tabItemGeneral" FontFamily="Meiryo UI" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.General, Mode=OneWay}">
              <StackPanel>
                <GroupBox Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Language, Mode=OneWay}">
                  <ComboBox Height="24" IsReadOnly="True" Width="150" MaxDropDownHeight="260" VerticalContentAlignment="Center" HorizontalAlignment="Center" ItemsSource="{Binding settingDialog.Languages, Mode=OneWay}" SelectedItem="{Binding Path=settingDialog.Language}" />
                </GroupBox>
                <GroupBox Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Operation_Mode, Mode=OneWay}">
                  <StackPanel>
                    <RadioButton Name="radioButtonNotUseLR2" Height="20" GroupName="Operation Mode" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Not_use_LR2DB, Mode=OneWay}" IsChecked="{Binding settingDialog.OperationModeLR2DB, Converter={qc:QuickConverter '!$P', ConvertBack='!$value'}}" />
                    <RadioButton Name="radioButtonUseLR2" Height="20" GroupName="Operation Mode" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Use_LR2_DB, Mode=OneWay}" IsChecked="{Binding settingDialog.OperationModeLR2DB}" />
                    <Grid Margin="0,0,0,4" IsEnabled="{Binding IsChecked, ElementName=radioButtonUseLR2}">
                      <Button Width="190" Height="24" HorizontalAlignment="Center" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_song_db_sync_data_resync, Mode=OneWay}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_song_db_sync_data_resync_tooltip, Mode=OneWay}" IsEnabled="{Binding CanRequestLr2SongDbSyncDataResync, Mode=OneWay}" Click="resyncLr2SongDbSyncDataButtonClicked" />
                    </Grid>
                    <Grid Margin="10,0,0,4" IsEnabled="{Binding settingDialog.IsBmsSearchRootEditorEnabled}">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <DockPanel Grid.Row="0" LastChildFill="False">
                        <Button Width="75" DockPanel.Dock="Right" Height="24" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Add_BMSDirectory, Mode=OneWay}" Click="buttonAddBmsSearchRootPathsClicked" />
                        <Label Height="28" HorizontalContentAlignment="Right" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Standalone_BMSDirectories, Mode=OneWay}" />
                      </DockPanel>
                      <DockPanel Grid.Row="1" LastChildFill="True">
                        <Button Width="75" DockPanel.Dock="Right" Height="24" Margin="4,0,0,0" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Remove_BMSDirectory, Mode=OneWay}" Command="{Binding settingDialog.RemoveDirCommand}" CommandParameter="{Binding settingDialog.SelectedBmsSearchRootPath}" />
                        <ListBox Height="58" AllowDrop="True" Drop="bmsSearchRootPathListBoxDrop" PreviewDragEnter="bmsSearchRootPathListBoxDragOver" PreviewDragOver="bmsSearchRootPathListBoxDragOver" ItemsSource="{Binding settingDialog.AvailableBMSDirectories}" SelectedItem="{Binding settingDialog.SelectedBmsSearchRootPath, Mode=TwoWay}" />
                      </DockPanel>
                    </Grid>
                    <DockPanel LastChildFill="False">
                      <Button Width="75" DockPanel.Dock="Right" Height="24" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger EventName="Click">
                            <v:CommonOpenFileDialogInteractionMessageAction>
                              <l:DirectInteractionMessage CallbackCommand="{Binding settingDialog.OpenRootFolderCommand}">
                                <l:FolderSelectionMessage MessageKey="{Binding Path.Path, ElementName=bindingLR2RootPath}" SelectedPath="{Binding settingDialog.LR2RootPath}" />
                              </l:DirectInteractionMessage>
                            </v:CommonOpenFileDialogInteractionMessageAction>
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <UIElement.IsEnabled>
                          <MultiBinding Converter="{StaticResource expanderDetailedLR2PathConverter}">
                            <Binding Path="IsChecked" ElementName="radioButtonUseLR2" />
                            <Binding Path="IsExpanded" ElementName="expanderDetailedLR2Path" />
                          </MultiBinding>
                        </UIElement.IsEnabled>
                      </Button>
                      <TextBox Name="textBox" Height="24" IsReadOnly="True" DockPanel.Dock="Right" VerticalContentAlignment="Center" Width="225">
                        <Binding x:Name="bindingLR2RootPath" Path="settingDialog.LR2RootPath" />
                        <UIElement.IsEnabled>
                          <MultiBinding Converter="{StaticResource expanderDetailedLR2PathConverter}">
                            <Binding Path="IsChecked" ElementName="radioButtonUseLR2" />
                            <Binding Path="IsExpanded" ElementName="expanderDetailedLR2Path" />
                          </MultiBinding>
                        </UIElement.IsEnabled>
                      </TextBox>
                      <Label Height="28" HorizontalContentAlignment="Right" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.DirPath_LR2, Mode=OneWay}" />
                    </DockPanel>
                    <Expander Name="expanderDetailedLR2Path" Margin="10,0,0,0" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details, Mode=OneWay}">
                      <Expander.IsExpanded>
                        <MultiBinding Mode="OneTime" Converter="{StaticResource lr2DetailedPathAutoExpandConverter}">
                          <Binding Path="settingDialog.LR2RootPath" />
                          <Binding Path="settingDialog.LR2SongDBPath" />
                          <Binding Path="settingDialog.LR2ConfigXmlPath" />
                        </MultiBinding>
                      </Expander.IsExpanded>
                      <StackPanel>
                        <DockPanel LastChildFill="False">
                          <Button Width="75" DockPanel.Dock="Right" Height="24" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}" IsEnabled="{Binding IsChecked, ElementName=radioButtonUseLR2}">
                            <i:Interaction.Triggers>
                              <i:EventTrigger EventName="Click">
                                <v:CommonOpenFileDialogInteractionMessageAction>
                                  <l:DirectInteractionMessage CallbackCommand="{Binding settingDialog.OpenFileCommand}">
                                    <l:OpeningFileSelectionMessage FileName="song.db" Filter="song.db (*.db)|*.db|すべてのファイル(*.*)|*.*" Title="song.db を開く" MessageKey="{Binding Path.Path, ElementName=bindingLR2SongDBPath}" InitialDirectory="{Binding settingDialog.LR2SongDBPath, Converter={StaticResource pathToDirectoryOrSelfConverter}}" />
                                  </l:DirectInteractionMessage>
                                </v:CommonOpenFileDialogInteractionMessageAction>
                              </i:EventTrigger>
                            </i:Interaction.Triggers>
                          </Button>
                          <TextBox Height="24" IsReadOnly="True" DockPanel.Dock="Right" IsEnabled="{Binding IsChecked, ElementName=radioButtonUseLR2}" Width="{Binding ActualWidth, ElementName=textBox, Mode=OneWay}">
                            <Binding x:Name="bindingLR2SongDBPath" Path="settingDialog.LR2SongDBPath" />
                          </TextBox>
                          <Label Height="28" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.FilePath_songDB, Mode=OneWay}" />
                        </DockPanel>
                        <DockPanel LastChildFill="False">
                          <Button Width="75" DockPanel.Dock="Right" Height="24" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}" IsEnabled="{Binding IsChecked, ElementName=radioButtonUseLR2}">
                            <i:Interaction.Triggers>
                              <i:EventTrigger EventName="Click">
                                <v:CommonOpenFileDialogInteractionMessageAction>
                                  <l:DirectInteractionMessage CallbackCommand="{Binding settingDialog.OpenFileCommand}">
                                    <l:OpeningFileSelectionMessage FileName="config.xml" Filter="|config.xm?|すべてのファイル(*.*)|*.*" Title="config.xml を開く" MessageKey="{Binding Path.Path, ElementName=bindingLR2ConfigPath}" InitialDirectory="{Binding settingDialog.LR2ConfigXmlPath, Converter={StaticResource pathToDirectoryOrSelfConverter}}" />
                                  </l:DirectInteractionMessage>
                                </v:CommonOpenFileDialogInteractionMessageAction>
                              </i:EventTrigger>
                            </i:Interaction.Triggers>
                          </Button>
                          <TextBox Height="24" IsReadOnly="True" DockPanel.Dock="Right" IsEnabled="{Binding IsChecked, ElementName=radioButtonUseLR2}" Width="{Binding ActualWidth, ElementName=textBox, Mode=OneWay}">
                            <Binding x:Name="bindingLR2ConfigPath" Path="settingDialog.LR2ConfigXmlPath" />
                          </TextBox>
                          <Label Height="28" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.FilePath_configXml, Mode=OneWay}" />
                        </DockPanel>
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </GroupBox>
                <GroupBox Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Beatoraja_integration, Mode=OneWay}">
                  <StackPanel>
                    <DockPanel LastChildFill="False">
                      <Button Width="75" DockPanel.Dock="Right" Height="24" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger EventName="Click">
                            <v:CommonOpenFileDialogInteractionMessageAction>
                              <l:DirectInteractionMessage CallbackCommand="{Binding settingDialog.OpenRootFolderCommand}">
                                <l:FolderSelectionMessage DialogPreference="FolderBrowser" MessageKey="{Binding Path.Path, ElementName=bindingBeatorajaRootPath}" SelectedPath="{Binding settingDialog.BeatorajaRootPath}" />
                              </l:DirectInteractionMessage>
                            </v:CommonOpenFileDialogInteractionMessageAction>
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                      </Button>
                      <TextBox Height="24" IsReadOnly="True" DockPanel.Dock="Right" Width="{Binding ActualWidth, ElementName=textBox, Mode=OneWay}">
                        <Binding x:Name="bindingBeatorajaRootPath" Path="settingDialog.BeatorajaRootPath" />
                      </TextBox>
                      <Label Height="28" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.FilePath_beatoraja_root, Mode=OneWay}" />
                    </DockPanel>
                    <CheckBox Height="20" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Use_beatoraja_scoreDB, Mode=OneWay}" IsChecked="{Binding settingDialog.UseBeatorajaScoreDb}" />
                    <DockPanel LastChildFill="False">
                      <ComboBox Width="160" Height="24" DockPanel.Dock="Right" IsEnabled="{Binding settingDialog.UseBeatorajaScoreDb}" ItemsSource="{Binding settingDialog.AvailableBeatorajaPlayers}" SelectedItem="{Binding settingDialog.BeatorajaPlayerId}" />
                      <Label Height="28" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Beatoraja_player, Mode=OneWay}" />
                    </DockPanel>
                    <CheckBox Height="20" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Use_beatoraja_bmt_output, Mode=OneWay}" IsChecked="{Binding settingDialog.EnableBeatorajaBmtOutput}" />
                    <DockPanel LastChildFill="False" Margin="16,0,0,0" IsEnabled="{Binding settingDialog.EnableBeatorajaBmtOutput}">
                      <ComboBox Width="180" Height="24" DockPanel.Dock="Right" ItemsSource="{Binding settingDialog.BeatorajaBmtHashOutputModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Key" SelectedValue="{Binding settingDialog.BeatorajaBmtHashOutputMode, Mode=TwoWay}" />
                      <Label Height="28" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Beatoraja_bmt_hash_output_mode, Mode=OneWay}" />
                    </DockPanel>
                    <CheckBox Height="20" Margin="16,0,0,0" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Keep_beatoraja_bmt_files_when_output_disabled, Mode=OneWay}" IsChecked="{Binding settingDialog.KeepBeatorajaBmtFilesWhenOutputDisabled}" />
                    <CheckBox Height="20" Margin="16,0,0,0" IsEnabled="{Binding settingDialog.EnableBeatorajaBmtOutput}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Register_beatoraja_bmt_urls, Mode=OneWay}" IsChecked="{Binding settingDialog.RegisterBeatorajaBmtUrls}" />
                  </StackPanel>
                </GroupBox>
              </StackPanel>
            </TabItem>
            <TabItem Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance, Mode=OneWay}">
              <StackPanel>
                <GroupBox Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance, Mode=OneWay}">
                  <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                      <ComboBox Name="comboBoxAppearanceTheme" Width="120" Height="24" DockPanel.Dock="Right" ItemsSource="{Binding settingDialog.AppearanceThemeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Key" SelectedValue="{Binding settingDialog.AppearanceTheme, Mode=TwoWay}" />
                      <Label Height="28" HorizontalContentAlignment="Right" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance_theme, Mode=OneWay}" />
                    </DockPanel>
                    <CheckBox Name="checkBoxUseExternalPanelImage" IsChecked="{Binding settingDialog.UseExternalPanelImage}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Change_stage_file, Mode=OneWay}" />
                    <DockPanel LastChildFill="False" IsEnabled="{Binding IsChecked, ElementName=checkBoxUseExternalPanelImage}">
                      <Button Width="75" DockPanel.Dock="Right" Height="24" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger EventName="Click">
                            <v:CommonOpenFileDialogInteractionMessageAction>
                              <l:DirectInteractionMessage CallbackCommand="{Binding settingDialog.OpenFileCommand}">
                                <l:OpeningFileSelectionMessage Filter="Image file|*.bmp;*.gif;*.jpg;*.jpeg;*.png;*.tif;*.tiff|BMP file (*.bmp)|*.bmp|GIF file (*.gif)|*.gif|JPEG file (*.jpg;*.jpeg)|*.jpg;*.jpeg|PNG file (*.png)|*.png|TIFF file (*.tif;*.tiff)|*.tif;*.tiff" MessageKey="{Binding Path.Path, ElementName=bindingStagefilePath}" Title="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Open_image, Mode=OneWay}" InitialDirectory="{Binding settingDialog.StagefilePath, Converter={StaticResource pathToDirectoryOrSelfConverter}}" />
                              </l:DirectInteractionMessage>
                            </v:CommonOpenFileDialogInteractionMessageAction>
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                      </Button>
                      <TextBox Height="24" IsReadOnly="True" DockPanel.Dock="Right" VerticalContentAlignment="Center" Width="{Binding ActualWidth, ElementName=textBox, Mode=OneWay}">
                        <Binding x:Name="bindingStagefilePath" Path="settingDialog.StagefilePath" />
                      </TextBox>
                      <Label Height="28" HorizontalContentAlignment="Right" DockPanel.Dock="Right" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.FilePath_StageFile, Mode=OneWay}" />
                    </DockPanel>
                  </StackPanel>
                </GroupBox>
              </StackPanel>
            </TabItem>
            <TabItem Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playback, Mode=OneWay}">
              <StackPanel>
                <GroupBox Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Player, Mode=OneWay}">
                  <StackPanel>
                    <Label Height="28" DockPanel.Dock="Top" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Player_Use, Mode=OneWay}" />
                    <DockPanel LastChildFill="False">
                      <RadioButton Name="radioButtonInternalPlayer" Height="20" GroupName="Player" Margin="30,0,0,0" IsChecked="True" DockPanel.Dock="Top" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Player_Name_Internal, Mode=OneWay}" />
                      <DockPanel Dock="Bottom">
                        <StackPanel DockPanel.Dock="Bottom">
                          <TextBlock Margin="0,0,5,5" HorizontalAlignment="Right" Width="294" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Player_Internal_desc, Mode=OneWay}" Style="{StaticResource styleTextBlockActiveForeground}" Tag="{Binding IsChecked, ElementName=radioButtonInternalPlayer}" />
                        </StackPanel>
                      </DockPanel>
                    </DockPanel>
                    <DockPanel LastChildFill="False">
                      <RadioButton Name="radioButtonPlayuBMplay" Content="uBMplay: " Height="20" GroupName="Player" Margin="30,2,0,0" VerticalAlignment="Top" IsChecked="{Binding settingDialog.UsePlayeruBMplay}" />
                      <DockPanel Dock="Right">
                        <StackPanel DockPanel.Dock="Bottom">
                          <TextBlock Margin="5" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Player_uBMplay_desc, Mode=OneWay}" Style="{StaticResource styleTextBlockActiveForeground}" Tag="{Binding IsChecked, ElementName=radioButtonPlayuBMplay}" />
                        </StackPanel>
                        <Button Width="75" DockPanel.Dock="Right" Height="24" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}" IsEnabled="{Binding IsChecked, ElementName=radioButtonPlayuBMplay}">
                          <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                              <v:CommonOpenFileDialogInteractionMessageAction>
                                <l:DirectInteractionMessage CallbackCommand="{Binding settingDialog.OpenFileCommand}">
                                  <l:OpeningFileSelectionMessage FileName="uBMplay.exe" Filter="|uBMplay.exe|すべてのファイル(*.*)|*.*" Title="uBMplay.exe を開く" MessageKey="{Binding Path.Path, ElementName=bindinguBMplayPath}" InitialDirectory="{Binding settingDialog.uBMplayPath, Converter={StaticResource pathToDirectoryOrSelfConverter}}" />
                                </l:DirectInteractionMessage>
                              </v:CommonOpenFileDialogInteractionMessageAction>
                            </i:EventTrigger>
                          </i:Interaction.Triggers>
                        </Button>
                        <TextBox Height="24" IsReadOnly="True" DockPanel.Dock="Right" VerticalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=radioButtonPlayuBMplay}" Width="{Binding ActualWidth, ElementName=textBox, Mode=OneWay}">
