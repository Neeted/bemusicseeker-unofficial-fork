<?xml version="1.0" encoding="utf-8"?>
<views:ThemedWindow x:Class="BeMusicSeeker.Views.Lr2PlayHistorySchemaUninstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BeMusicSeeker.Views"
        xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels"
        Title="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_play_history_schema_uninstall_title, Mode=OneWay}"
        Width="560"
        SizeToContent="Height"
        MaxHeight="620"
        MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource App.DialogBackgroundBrush}"
        Foreground="{DynamicResource App.TextBrush}">
  <views:ThemedWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/BeMusicSeeker;component/Themes/CanonicalDialogStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </views:ThemedWindow.Resources>
  <DockPanel LastChildFill="True">
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,16,16">
    <Button MinWidth="72" Margin="0,0,8,0" Style="{StaticResource App.Canonical.DialogDangerActionStyle}" Content="OK" IsDefault="True" AutomationProperties.AutomationId="Lr2PlayHistorySchemaUninstall" Click="SaveAndClose" />
    <Button MinWidth="72" Style="{StaticResource App.Canonical.DialogQuietActionStyle}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Cancel, Mode=OneWay}" IsCancel="True" AutomationProperties.AutomationId="Lr2PlayHistorySchemaCancel" />
  </StackPanel>
  <ScrollViewer Style="{StaticResource App.Canonical.WindowBodyScrollViewerStyle}"
                MaxHeight="500"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                CanContentScroll="False">
  <StackPanel>
    <TextBlock TextWrapping="Wrap" Margin="{StaticResource App.Layout.SectionMargin}" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_play_history_schema_uninstall_desc, Mode=OneWay}" />
    <GroupBox Style="{StaticResource App.Canonical.GroupBoxStyle}" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_play_history_schema_uninstall_score_db, Mode=OneWay}" Margin="{StaticResource App.Layout.SectionMargin}">
      <TextBox Style="{StaticResource App.Canonical.TextBoxStyle}" Text="{Binding ScoreDbPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
    </GroupBox>
    <GroupBox Margin="0" Style="{StaticResource App.Canonical.GroupBoxStyle}" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_play_history_schema_uninstall_mode, Mode=OneWay}">
      <StackPanel>
        <RadioButton Style="{StaticResource App.Canonical.RadioButtonStyle}" x:Name="radioButtonTriggersOnly" Margin="0,0,0,8" IsChecked="True" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_play_history_schema_uninstall_triggers_only, Mode=OneWay}" />
        <RadioButton Style="{StaticResource App.Canonical.RadioButtonStyle}" x:Name="radioButtonTablesAndTriggers" Margin="0,0,0,8" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_play_history_schema_uninstall_tables_and_triggers, Mode=OneWay}" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource App.WarningTextBrush}" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_play_history_schema_uninstall_warning, Mode=OneWay}" />
      </StackPanel>
    </GroupBox>
  </StackPanel>
  </ScrollViewer>
  </DockPanel>

</views:ThemedWindow>
