<?xml version="1.0" encoding="utf-8"?>
<v:ThemedWindow x:Class="BeMusicSeeker.Views.ChartPropertiesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="clr-namespace:BeMusicSeeker.Views"
    xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels"
    Width="820" Height="620" MinWidth="580" MinHeight="380" ResizeMode="CanResize"
    ShowInTaskbar="True" WindowStartupLocation="CenterOwner"
    Title="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.ChartProperties, Mode=OneWay}" Closed="WindowClosed" PreviewKeyDown="WindowKeyDown">
  <Grid TextElement.Foreground="{DynamicResource App.TextBrush}">
    <Grid.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/BeMusicSeeker;component/Themes/CanonicalDialogStyles.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <v:stringToBooleanConverter x:Key="hasFailureText" />
        <Style x:Key="ReadOnlyValue" TargetType="TextBox" BasedOn="{StaticResource App.Canonical.TextBoxStyle}">
          <Setter Property="IsReadOnly" Value="True" />
          <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ResourceList" TargetType="TextBox" BasedOn="{StaticResource ReadOnlyValue}">
          <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style x:Key="FailureValue" TargetType="TextBox" BasedOn="{StaticResource ReadOnlyValue}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Status, Converter={StaticResource hasFailureText}}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="Page0" TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedIndex, ElementName=categoryNavigation}" Value="0">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="Page1" TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedIndex, ElementName=categoryNavigation}" Value="1">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="Page2" TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedIndex, ElementName=categoryNavigation}" Value="2">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ResourceDictionary>
    </Grid.Resources>
    <Border Style="{StaticResource App.Canonical.NativeWindowContentStyle}">
      <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="0,4,12,0" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Title, Mode=OneWay}" />
        <TextBox x:Name="valueTitle" Grid.Row="0" Grid.Column="1" Style="{StaticResource ReadOnlyValue}" Text="{Binding Title, Mode=OneWay}" />
        <TextBlock Grid.Row="1" Margin="0,4,12,0" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Artist, Mode=OneWay}" />
        <TextBox x:Name="valueArtist" Grid.Row="1" Grid.Column="1" Style="{StaticResource ReadOnlyValue}" Text="{Binding Artist, Mode=OneWay}" />
        <TextBlock Grid.Row="2" Margin="0,4,12,0" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.ChartPropertiesPath, Mode=OneWay}" />
        <TextBox x:Name="valuePath" Grid.Row="2" Grid.Column="1" Style="{StaticResource ReadOnlyValue}" Text="{Binding Path, Mode=OneWay}" />
        <TextBlock Grid.Row="3" Margin="0,4,12,0" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.ChartPropertiesVerificationBasis, Mode=OneWay}" />
        <TextBox x:Name="valueVerificationBasis" Grid.Row="3" Grid.Column="1" Style="{StaticResource ReadOnlyValue}" Text="{Binding VerificationBasis, Mode=OneWay}" />
        <TextBlock Grid.Row="4" Margin="0,4,12,0" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.ChartPropertiesVerificationPath, Mode=OneWay}" />
        <TextBox x:Name="valueVerificationPath" Grid.Row="4" Grid.Column="1" Style="{StaticResource ReadOnlyValue}" Text="{Binding VerificationPath, Mode=OneWay}" />
          <TextBox x:Name="readStatus" Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource FailureValue}" Text="{Binding Status, Mode=OneWay}" />
        </Grid>
        <ListBox x:Name="categoryNavigation" DockPanel.Dock="Top" SelectedIndex="0" Margin="0,0,0,8"
                 Style="{StaticResource App.Canonical.TopNavigationStyle}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBoxItem Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.ChartPropertiesIssues, Mode=OneWay}" />
          <ListBoxItem Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.ChartPropertiesUnusedDefinitions, Mode=OneWay}" />
          <ListBoxItem Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.ChartPropertiesUndefinedReferences, Mode=OneWay}" />
        </ListBox>
        <ContentControl Style="{StaticResource App.Canonical.TopNavigationContentStyle}">
          <Grid>
            <Grid Style="{StaticResource Page0}">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <TextBox x:Name="listIssues" Grid.Row="1" Style="{StaticResource ResourceList}" Text="{Binding Issues, Mode=OneWay}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </Grid>
            <Grid Style="{StaticResource Page1}">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Text="{Binding UnusedDescription, Mode=OneWay}" />
              <TextBox x:Name="listUnusedDefinitions" Grid.Row="1" Style="{StaticResource ResourceList}" Text="{Binding UnusedDefinitions, Mode=OneWay}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </Grid>
            <Grid Style="{StaticResource Page2}">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Text="{Binding UndefinedDescription, Mode=OneWay}" />
              <TextBox x:Name="listUndefinedReferences" Grid.Row="1" Style="{StaticResource ResourceList}" Text="{Binding UndefinedReferences, Mode=OneWay}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </Grid>
          </Grid>
        </ContentControl>
      </DockPanel>
    </Border>
  </Grid>
</v:ThemedWindow>
