<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="BeMusicSeeker.Views.LoadPlaylistURIDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:v="clr-namespace:BeMusicSeeker.Views" xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" x:Name="settingDialog">
  <Grid Name="loadPlaylistURIDialogRootGrid" TextElement.Foreground="{DynamicResource App.TextBrush}">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/BeMusicSeeker;component/BeMusicSeeker/Themes/CanonicalDialogStyles.xaml" />
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Rectangle Style="{StaticResource App.Canonical.DialogOverlayStyle}" />
    <Border Style="{StaticResource App.Canonical.DialogContentStyle}" Width="560" Height="220">
      <Border Style="{StaticResource App.Canonical.DialogSurfaceStyle}">
        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" LastChildFill="True">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,2,0,0">
            <Button x:Name="openLocalFileButton" Style="{StaticResource App.Canonical.DialogActionStyle}" Content="Open" MinWidth="50" Margin="5,3" Click="OpenLocalFile" />
            <Button Style="{StaticResource App.Canonical.DialogPrimaryActionStyle}" Content="OK" MinWidth="50" Margin="5,3" Click="SaveAndClose" />
            <Button Style="{StaticResource App.Canonical.DialogQuietActionStyle}" Content="Cancel" MinWidth="50" Margin="5,3" Click="CancelAndClose" />
          </StackPanel>
          <StackPanel Margin="5,5,5,0">
            <TextBlock Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Load_PlaylistURI, Mode=OneWay}" />
            <TextBox Style="{StaticResource App.Canonical.TextBoxStyle}" Name="textBoxURIInput" Height="128" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
