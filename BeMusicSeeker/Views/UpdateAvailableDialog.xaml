<Window x:Class="BeMusicSeeker.Views.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels"
        Title="{Binding Title}"
        Width="560"
        SizeToContent="Height"
        MinWidth="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource App.DialogBackgroundBrush}"
        Foreground="{DynamicResource App.TextBrush}">
  <Border Padding="14" Background="{DynamicResource App.DialogBackgroundBrush}">
    <StackPanel>
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,8" />
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding CurrentVersionLabel}" Margin="0,0,8,4" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentVersionText}" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LatestVersionLabel}" Margin="0,0,8,0" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatestVersionText}" />
      </Grid>

      <GroupBox Header="{Binding PackageLabel}" Margin="0,0,0,10">
        <ListBox ItemsSource="{Binding Packages}"
                 SelectedItem="{Binding SelectedPackage, Mode=TwoWay}"
                 BorderThickness="0"
                 Background="{DynamicResource App.ControlBackgroundBrush}"
                 Foreground="{DynamicResource App.TextBrush}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="4">
                <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="{Binding FileName}" Opacity="0.75" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </GroupBox>

      <TextBlock Text="{Binding StartBlockedReason}"
                 Margin="0,0,0,10"
                 Foreground="{DynamicResource App.WarningTextBrush}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding CanStartUpdate}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Width="112" Margin="0,0,8,0" Content="{Binding UpdateButtonLabel}" IsEnabled="{Binding CanStartUpdate}" IsDefault="True" Click="ApplyButtonClick" />
        <Button Width="112" Margin="0,0,8,0" Content="{Binding ReleasePageButtonLabel}" Click="OpenReleasePageButtonClick" />
        <Button Width="72" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Close, Mode=OneWay}" IsCancel="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
