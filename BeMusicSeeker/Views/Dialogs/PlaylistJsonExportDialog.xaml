<v:ThemedWindow x:Class="BeMusicSeeker.Views.Dialogs.PlaylistJsonExportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="clr-namespace:BeMusicSeeker.Views" xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels"
    Width="680" MinWidth="480" SizeToContent="Height" ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
    Title="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_json_export_title}">
  <v:ThemedWindow.Resources>
    <ResourceDictionary Source="/BeMusicSeeker;component/Themes/CanonicalDialogStyles.xaml" />
  </v:ThemedWindow.Resources>
  <StackPanel Margin="{StaticResource App.Layout.BodyPadding}">
    <TextBlock Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Save_header_file}" Margin="0,0,0,4" />
    <DockPanel>
      <Button x:Name="browseHeaderButton" DockPanel.Dock="Right" Style="{StaticResource App.Canonical.DialogActionStyle}" Margin="8,0,0,0"
              Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse}" Click="BrowseHeader" />
      <TextBox Style="{StaticResource App.Canonical.TextBoxStyle}" x:Name="headerPathInput" Text="{Binding HeaderPath, UpdateSourceTrigger=PropertyChanged}" />
    </DockPanel>
    <TextBlock Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Save_data_file}" Margin="0,16,0,4" />
    <DockPanel>
      <Button x:Name="browseDataButton" DockPanel.Dock="Right" Style="{StaticResource App.Canonical.DialogActionStyle}" Margin="8,0,0,0"
              Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse}" Click="BrowseData" />
      <TextBox Style="{StaticResource App.Canonical.TextBoxStyle}" x:Name="dataPathInput" Text="{Binding DataPath, UpdateSourceTrigger=PropertyChanged}" />
    </DockPanel>
    <TextBlock x:Name="validationMessage" Text="{Binding ValidationMessage}" TextWrapping="Wrap" Margin="0,4,0,0">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="exportButton" Style="{StaticResource App.Canonical.DialogActionStyle}" IsEnabled="{Binding CanExport}" IsDefault="True"
              Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Export}" Click="AcceptExport" />
      <Button Style="{StaticResource App.Canonical.DialogActionStyle}" Margin="8,0,0,0" IsCancel="True"
              Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Cancel}" />
    </StackPanel>
  </StackPanel>
</v:ThemedWindow>
