<views:ThemedWindow x:Class="BeMusicSeeker.Views.GitHubStarPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BeMusicSeeker.Views"
        xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels"
        Title="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.About_application_name, Mode=OneWay}"
        AutomationProperties.AutomationId="GitHubStarPromptDialog"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource App.DialogBackgroundBrush}"
        Foreground="{DynamicResource App.TextBrush}">
  <views:ThemedWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/BeMusicSeeker;component/Themes/CanonicalDialogStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </views:ThemedWindow.Resources>
  <StackPanel Margin="{StaticResource App.Layout.BodyPadding}">
    <views:AppFontIcon Style="{StaticResource App.Canonical.FontIconStyle}"
                       Glyph="{StaticResource App.IconGlyph.Star}"
                       FontSize="32"
                       Foreground="{DynamicResource App.AccentBrush}"
                       Margin="{StaticResource App.Layout.FieldMargin}" />
    <TextBlock Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.GitHubStarPrompt_title, Mode=OneWay}"
               AutomationProperties.AutomationId="GitHubStarPromptTitle"
               FontSize="17"
               FontWeight="SemiBold"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Margin="0,0,0,8" />
    <TextBlock Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.GitHubStarPrompt_message, Mode=OneWay}"
               AutomationProperties.AutomationId="GitHubStarPromptMessage"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Margin="{StaticResource App.Layout.SectionMargin}" />
    <Button x:Name="starButton"
            Style="{StaticResource App.Canonical.DialogPrimaryActionStyle}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Margin="0,0,0,8"
            IsDefault="True"
            AutomationProperties.AutomationId="GitHubStarPromptStar"
            AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.GitHubStarPrompt_star_button, Mode=OneWay}"
            Click="StarButtonClick">
      <StackPanel Orientation="Horizontal">
        <views:AppFontIcon Style="{StaticResource App.Canonical.FontIconStyle}"
                           Glyph="{StaticResource App.IconGlyph.Star}"
                           FontSize="14"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                           Margin="0,0,8,0" />
        <TextBlock VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.GitHubStarPrompt_star_button, Mode=OneWay}" />
      </StackPanel>
    </Button>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button x:Name="laterButton"
              Grid.Column="0"
              Style="{StaticResource App.Canonical.DialogActionStyle}"
              HorizontalAlignment="Stretch"
              IsCancel="True"
              AutomationProperties.AutomationId="GitHubStarPromptLater"
              Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.GitHubStarPrompt_later_button, Mode=OneWay}" />
      <Button x:Name="neverButton"
              Grid.Column="2"
              Style="{StaticResource App.Canonical.DialogActionStyle}"
              HorizontalAlignment="Stretch"
              AutomationProperties.AutomationId="GitHubStarPromptNever"
              Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.GitHubStarPrompt_never_button, Mode=OneWay}"
              Click="NeverButtonClick" />
    </Grid>
  </StackPanel>
</views:ThemedWindow>
