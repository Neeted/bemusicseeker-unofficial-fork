<views:ThemedWindow x:Class="BeMusicSeeker.Views.PendingDeleteConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BeMusicSeeker.Views"
        xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels"
        Title="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Confirm, Mode=OneWay}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource App.DialogBackgroundBrush}"
        Foreground="{DynamicResource App.TextBrush}">
  <views:ThemedWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/BeMusicSeeker;component/Themes/CanonicalDialogStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </views:ThemedWindow.Resources>
  <StackPanel MinWidth="420" Margin="{StaticResource App.Layout.BodyPadding}">
    <TextBlock Margin="{StaticResource App.Layout.FieldMargin}"
               Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Msg_move_to_recycle, Mode=OneWay}"
               TextWrapping="Wrap" />
    <CheckBox Style="{StaticResource App.Canonical.CheckBoxStyle}" x:Name="checkBoxDeleteContainingFolder"
              Margin="{StaticResource App.Layout.FieldMargin}"
              IsChecked="True"
              Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Confirm_DeletePendingFolderWhenNoBms, Mode=OneWay}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Width="72" Margin="0,0,8,0" Style="{StaticResource App.Canonical.DialogPrimaryActionStyle}" IsDefault="True" AutomationProperties.AutomationId="PendingDeleteConfirm" Click="OkButtonClick">OK</Button>
      <Button Width="72" Style="{StaticResource App.Canonical.DialogQuietActionStyle}" IsCancel="True" AutomationProperties.AutomationId="PendingDeleteCancel">Cancel</Button>
    </StackPanel>
  </StackPanel>

</views:ThemedWindow>
