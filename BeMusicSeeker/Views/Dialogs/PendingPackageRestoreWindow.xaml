<?xml version="1.0" encoding="utf-8"?>
<views:ThemedWindow x:Class="BeMusicSeeker.Views.PendingPackageRestoreWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels"
                    xmlns:views="clr-namespace:BeMusicSeeker.Views"
                    Width="620" SizeToContent="Height" ResizeMode="NoResize"
                    ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
                    PreviewKeyDown="WindowPreviewKeyDown"
                    Title="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PendingRestoreTitle, Mode=OneWay}">
  <views:ThemedWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/BeMusicSeeker;component/Themes/CanonicalDialogStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </views:ThemedWindow.Resources>
  <StackPanel Margin="20">
    <TextBlock x:Name="FailureMessage" TextWrapping="Wrap" Margin="0,0,0,12"
               Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PendingRestoreMessage, Mode=OneWay}" />
    <ScrollViewer Style="{StaticResource App.Canonical.WindowBodyScrollViewerStyle}" MaxHeight="180" Margin="0,0,0,12"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <TextBlock x:Name="FailureCause" TextWrapping="Wrap" />
    </ScrollViewer>
    <TextBlock x:Name="ResetWarning" TextWrapping="Wrap" Margin="0,0,0,16"
               Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PendingRestoreResetWarning, Mode=OneWay}" />
    <WrapPanel HorizontalAlignment="Right">
      <Button x:Name="RetryButton" Margin="0,0,8,0" MinWidth="90" IsDefault="True"
              Style="{StaticResource App.Canonical.DialogPrimaryActionStyle}" Click="RetryClick"
              AutomationProperties.AutomationId="PendingRestoreRetry"
              Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PendingRestoreRetry, Mode=OneWay}" />
      <Button x:Name="ResetButton" Margin="0,0,8,0"
              Style="{StaticResource App.Canonical.DialogDangerActionStyle}" Click="ResetClick"
              AutomationProperties.AutomationId="PendingRestoreReset"
              Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PendingRestoreReset, Mode=OneWay}" />
      <Button x:Name="ExitButton" MinWidth="90"
              Style="{StaticResource App.Canonical.DialogActionStyle}" Click="ExitClick"
              AutomationProperties.AutomationId="PendingRestoreExit"
              Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PendingRestoreExit, Mode=OneWay}" />
    </WrapPanel>
  </StackPanel>
</views:ThemedWindow>
