<v:ThemedWindow x:Class="BeMusicSeeker.Views.Dialogs.DuplicatePreferredDestinationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="clr-namespace:BeMusicSeeker.Views" xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels"
    Width="640" Height="420" MinWidth="440" MinHeight="300" ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
    Title="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Duplicate_merge_preferred_destination_title}">
  <v:ThemedWindow.Resources>
    <ResourceDictionary Source="/BeMusicSeeker;component/Themes/CanonicalDialogStyles.xaml" />
  </v:ThemedWindow.Resources>
  <DockPanel Margin="{StaticResource App.Layout.BodyPadding}">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Duplicate_merge_preferred_destination_description}" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="okButton" AutomationProperties.AutomationId="DuplicatePreferredDestinationOk" Style="{StaticResource App.Canonical.DialogActionStyle}" IsDefault="True"
              Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.DialogButtonOk}" Click="AcceptClick" />
      <Button x:Name="cancelButton" AutomationProperties.AutomationId="DuplicatePreferredDestinationCancel" Style="{StaticResource App.Canonical.DialogActionStyle}" Margin="8,0,0,0" IsCancel="True"
              Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Cancel}" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" Width="96">
      <Button x:Name="addButton" AutomationProperties.AutomationId="DuplicatePreferredDestinationAdd" Style="{StaticResource App.Canonical.DialogActionStyle}"
              Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Add}" Click="AddClick" />
      <Button x:Name="removeButton" AutomationProperties.AutomationId="DuplicatePreferredDestinationRemove" Style="{StaticResource App.Canonical.DialogActionStyle}" Margin="0,8,0,0"
              Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Remove}" Click="RemoveClick" />
    </StackPanel>
    <ListBox x:Name="destinationList" AutomationProperties.AutomationId="DuplicatePreferredDestinationList" SelectionMode="Extended" ItemsSource="{Binding Destinations}" />
  </DockPanel>
</v:ThemedWindow>
