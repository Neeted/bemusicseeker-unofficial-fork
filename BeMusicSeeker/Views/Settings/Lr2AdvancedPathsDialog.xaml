<?xml version="1.0" encoding="utf-8"?>
<views:ThemedWindow x:Class="BeMusicSeeker.Views.Settings.Lr2AdvancedPathsDialog" x:Name="DialogRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:BeMusicSeeker.Views.Settings" xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels"
        xmlns:views="clr-namespace:BeMusicSeeker.Views"
        Title="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_lr2_advanced_title, Mode=OneWay}"
        Width="680" SizeToContent="Height" MaxHeight="620" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <views:ThemedWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SettingsControls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </views:ThemedWindow.Resources>
  <Border Style="{StaticResource App.Canonical.NativeWindowContentStyle}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel>
      <TextBlock Margin="0,0,0,18" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_lr2_advanced_description, Mode=OneWay}" TextWrapping="Wrap" />
      <settings:SettingsStatusBanner Margin="0,0,0,12" Icon="!" Status="Error" Content="{Binding ValidationError, ElementName=DialogRoot, Mode=OneWay}" />
      <settings:SettingsPathPicker x:Name="SongDbPathPicker" Label="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.FilePath_songDB, Mode=OneWay}" Path="{Binding SongDbPath, ElementName=DialogRoot, Mode=TwoWay}" IsPathReadOnly="False" BrowseText="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}" BrowseRequested="BrowseSongDb" />
      <settings:SettingsPathPicker x:Name="ConfigPathPicker" Label="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.FilePath_configXml, Mode=OneWay}" Path="{Binding ConfigPath, ElementName=DialogRoot, Mode=TwoWay}" IsPathReadOnly="False" BrowseText="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}" BrowseRequested="BrowseConfig" />
      <settings:SettingsStatusBanner Icon="!" Status="Warning" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_lr2_advanced_persistence_note, Mode=OneWay}" />
    </StackPanel>
      <StackPanel Grid.Row="1" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button MinWidth="96" Margin="0,0,8,0" Style="{StaticResource App.Canonical.DialogQuietActionStyle}" IsCancel="True" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Cancel, Mode=OneWay}" AutomationProperties.AutomationId="Lr2AdvancedPathsCancel" Click="CancelClick" />
        <Button MinWidth="96" Style="{StaticResource App.Canonical.DialogPrimaryActionStyle}" IsDefault="True" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_done, Mode=OneWay}" AutomationProperties.AutomationId="Lr2AdvancedPathsDone" Click="DoneClick" />
      </StackPanel>
    </Grid>
  </Border>
</views:ThemedWindow>
