<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="BeMusicSeeker.Views.Settings.Pages.AudioSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:BeMusicSeeker.Views.Settings" xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels"
             x:Name="page" HorizontalContentAlignment="Stretch" IsVisibleChanged="AudioSettingsPageIsVisibleChanged">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../SettingsControls.xaml" /></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></ResourceDictionary></UserControl.Resources>
  <StackPanel>
    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting, Mode=OneWay}"
                              Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_audio_output_description, Mode=OneWay}">
      <StackPanel>
        <settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_driver, Mode=OneWay}"><ComboBox x:Name="comboBoxPlayerDriver" IsEnabled="{Binding IsAudioOutputSelectionEnabled}" IsReadOnly="True" ItemsSource="{Binding PlayerDriverNames}" SelectedIndex="{Binding PlayerDriverIndex, Mode=TwoWay}" /></settings:SettingsField>
        <settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_device, Mode=OneWay}"><ComboBox DisplayMemberPath="FriendlyName" IsEnabled="{Binding IsAudioOutputSelectionEnabled}" IsReadOnly="True" ItemsSource="{Binding PlayerDeviceNames}" SelectedItem="{Binding SelectedPlayerDevice, Mode=TwoWay}" /></settings:SettingsField>
        <UniformGrid Columns="2">
          <settings:SettingsField Margin="0,0,6,14" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_samplerate, Mode=OneWay}">
            <Grid IsEnabled="{Binding IsAudioOutputSelectionEnabled}">
              <ComboBox x:Name="comboBoxPlayerSampleRate" Visibility="{Binding IsPlayerSampleRateSelectionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" SelectedValuePath="Key" DisplayMemberPath="Value" IsReadOnly="True" ItemsSource="{Binding PlayerSampleRateNames}" SelectedValue="{Binding SelectedPlayerSampleRate, Mode=TwoWay}" />
              <TextBlock x:Name="textPlayerCapabilityRate" Visibility="{Binding IsPlayerSampleRateReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}" Text="{Binding AudioDeviceCapabilityRateDescription}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
          </settings:SettingsField>
          <settings:SettingsField Margin="6,0,0,14" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_format, Mode=OneWay}">
            <Grid IsEnabled="{Binding IsAudioOutputSelectionEnabled}">
              <ComboBox x:Name="comboBoxPlayerFormat" Visibility="{Binding IsPlayerFormatSelectionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" SelectedValuePath="Key" DisplayMemberPath="Value" IsReadOnly="True" ItemsSource="{Binding PlayerFormatNames}" SelectedValue="{Binding SelectedPlayerFormat, Mode=TwoWay}" />
              <TextBlock x:Name="textPlayerCapabilityFormat" Visibility="{Binding IsPlayerFormatReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}" Text="{Binding AudioDeviceCapabilityFormatDescription}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
          </settings:SettingsField>
        </UniformGrid>
        <settings:SettingsStatusBanner Margin="0,0,0,8" Icon="i" Status="Information" Style="{StaticResource SettingsMultilineStringStatusBannerStyle}" Content="{Binding AudioOutputSelectionResetMessage}" />
        <settings:SettingsStatusBanner Margin="0,0,0,8" Icon="!" Status="Warning" Style="{StaticResource SettingsMultilineStringStatusBannerStyle}" Content="{Binding UnavailablePlayerDriverDescription}" />
        <settings:SettingsStatusBanner Margin="0,0,0,8" Icon="i" Status="Information" Style="{StaticResource SettingsMultilineStringStatusBannerStyle}" Content="{Binding AudioDeviceCapabilityStatusMessage}" />
        <Expander Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.AudioDeviceTechnicalDetails, Mode=OneWay}" IsExpanded="False" Visibility="{Binding HasAudioDeviceCapabilityDiagnostics, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock Text="{Binding AudioDeviceCapabilityDiagnosticMessage}" TextWrapping="Wrap" />
        </Expander>
      </StackPanel>
    </settings:SettingsSection>

    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_volume, Mode=OneWay}">
      <StackPanel>
        <settings:SettingsField Margin="0,0,0,0" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_volume, Mode=OneWay}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions><Slider Maximum="100" LargeChange="2" SmallChange="1" IsSnapToTickEnabled="True" Value="{Binding PlaybackPanel.PlayerVolume, ElementName=page, Mode=TwoWay}" /><TextBlock Grid.Column="1" Margin="12,0,0,0" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding PlaybackPanel.PlayerVolume, ElementName=page, StringFormat={}{0}%}" /></Grid></settings:SettingsField>
        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource App.DisabledTextBrush}" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_desc2, Mode=OneWay}" TextWrapping="Wrap" />
      </StackPanel>
    </settings:SettingsSection>

    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_test, Mode=OneWay}">
      <StackPanel>
        <Button x:Name="buttonPlayerTest" HorizontalAlignment="Left" Style="{StaticResource SettingsQuietButtonStyle}" IsEnabled="{Binding IsAudioDeviceTestAvailable}" Content="{Binding AudioDeviceTestButtonContent, Mode=OneWay}" Click="buttonPlayerTestClick" />
        <settings:SettingsStatusBanner Margin="0,10,0,0" Icon="i" Status="Information" Style="{StaticResource SettingsMultilineStringStatusBannerStyle}" Content="{Binding AudioDeviceTestStatusMessage}" />
        <Expander Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.AudioDeviceTechnicalDetails, Mode=OneWay}" IsExpanded="False" Visibility="{Binding HasAudioDeviceTestDiagnostics, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock Text="{Binding AudioDeviceTestDiagnosticMessage}" TextWrapping="Wrap" />
        </Expander>
      </StackPanel>
    </settings:SettingsSection>

    <settings:SettingsSection x:Name="audioAdvancedSettings" IsEnabled="{Binding IsAudioOutputSelectionEnabled}" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_audio_advanced, Mode=OneWay}">
      <StackPanel>
        <CheckBox Visibility="{Binding IsPlayerWasapiDriver, Converter={StaticResource BooleanToVisibilityConverter}}" x:Name="checkBoxWasapiLowLatency" IsEnabled="{Binding IsAudioOutputSelectionEnabled}" IsChecked="{Binding PlayerWASAPIParam, Mode=TwoWay}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_lowlatency, Mode=OneWay}" />
        <TextBlock x:Name="textWasapiLowLatencyDescription" Visibility="{Binding IsPlayerWasapiDriver, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,6,0,0" Foreground="{DynamicResource App.DisabledTextBrush}" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_lowlatency_desc, Mode=OneWay}" TextWrapping="Wrap" />
        <settings:SettingsField Visibility="{Binding IsPlayerBufferControlEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,12,0,0" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_buffersize, Mode=OneWay}">
          <Grid IsEnabled="{Binding IsPlayerBufferControlEnabled}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions><Slider Maximum="100" LargeChange="2" SmallChange="1" IsSnapToTickEnabled="True" Value="{Binding PlayerBufferSize, Mode=TwoWay}" /><TextBlock Grid.Column="1" Margin="12,0,0,0" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding PlayerBufferSize, StringFormat={}{0:F0} ms}" /></Grid>
        </settings:SettingsField>
        <TextBlock Visibility="{Binding IsPlayerBufferControlEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,6,0,0" Foreground="{DynamicResource App.DisabledTextBrush}" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_desc1, Mode=OneWay}" TextWrapping="Wrap" />
        <settings:SettingsField Margin="0,12,0,0" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_resampling_quality, Mode=OneWay}">
          <ComboBox x:Name="comboBoxPlayerResamplingQuality" IsEnabled="{Binding IsAudioOutputSelectionEnabled}" SelectedValuePath="Key" DisplayMemberPath="Value" IsReadOnly="True" ItemsSource="{Binding PlayerResamplingQualityNames}" SelectedValue="{Binding PlayerResamplingQuality, Mode=TwoWay}" />
        </settings:SettingsField>
        <TextBlock x:Name="textPlayerResamplingQualityDescription" Margin="0,6,0,0" Foreground="{DynamicResource App.DisabledTextBrush}" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_resampling_quality_desc, Mode=OneWay}" TextWrapping="Wrap" />
        <settings:SettingsField Margin="0,12,0,0" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_resampling_parallelism, Mode=OneWay}">
          <ComboBox x:Name="comboBoxPlayerMixerThreadCount" IsEnabled="{Binding IsAudioOutputSelectionEnabled}" SelectedValuePath="Key" DisplayMemberPath="Value" IsReadOnly="True" ItemsSource="{Binding PlayerMixerThreadCountNames}" SelectedValue="{Binding PlayerMixerThreadCount, Mode=TwoWay}" />
        </settings:SettingsField>
        <TextBlock x:Name="textPlayerMixerThreadCountDescription" Margin="0,6,0,0" Foreground="{DynamicResource App.DisabledTextBrush}" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_resampling_parallelism_desc, Mode=OneWay}" TextWrapping="Wrap" />
      </StackPanel>
    </settings:SettingsSection>
  </StackPanel>
</UserControl>
