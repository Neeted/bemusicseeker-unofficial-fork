<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="BeMusicSeeker.Views.Settings.Pages.AudioSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:BeMusicSeeker.Views.Settings" xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels"
             x:Name="page" HorizontalContentAlignment="Stretch">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../SettingsControls.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <StackPanel>
    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting, Mode=OneWay}"
                              Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_audio_output_description, Mode=OneWay}">
      <StackPanel>
        <settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_driver, Mode=OneWay}"><ComboBox x:Name="comboBoxPlayerDriver" IsReadOnly="True" ItemsSource="{Binding PlayerDriverNames}" SelectedIndex="{Binding PlayerDriverIndex, Mode=TwoWay}" /></settings:SettingsField>
        <settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_device, Mode=OneWay}"><ComboBox DisplayMemberPath="FriendlyName" IsReadOnly="True" ItemsSource="{Binding PlayerDeviceNames}" SelectedItem="{Binding SelectedPlayerDevice, Mode=TwoWay}" /></settings:SettingsField>
        <UniformGrid Columns="2">
          <settings:SettingsField Margin="0,0,6,14" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_samplerate, Mode=OneWay}"><ComboBox SelectedValuePath="Key" DisplayMemberPath="Value" IsReadOnly="True" IsEnabled="{Binding IsPlayerFormatSelectionEnabled}" ItemsSource="{Binding PlayerSampleRateNames}" SelectedValue="{Binding PlayerSampleRate, Mode=TwoWay}" /></settings:SettingsField>
          <settings:SettingsField Margin="6,0,0,14" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_format, Mode=OneWay}"><ComboBox SelectedValuePath="Key" DisplayMemberPath="Value" IsReadOnly="True" IsEnabled="{Binding IsPlayerFormatSelectionEnabled}" ItemsSource="{Binding PlayerFormatNames}" SelectedValue="{Binding PlayerFormat, Mode=TwoWay}" /></settings:SettingsField>
        </UniformGrid>
        <settings:SettingsStatusBanner Icon="!" Status="Warning" Style="{StaticResource SettingsMultilineStringStatusBannerStyle}" Content="{Binding UnavailablePlayerDriverDescription}" />
      </StackPanel>
    </settings:SettingsSection>

    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_audio_advanced, Mode=OneWay}">
      <StackPanel>
        <CheckBox x:Name="checkBoxWasapiLowLatency" IsEnabled="{Binding IsPlayerWasapiDriver}" IsChecked="{Binding PlayerWASAPIParam, Mode=TwoWay}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_lowlatency, Mode=OneWay}" />
        <settings:SettingsField Margin="0,12,0,0" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_buffersize, Mode=OneWay}">
          <Grid IsEnabled="{Binding IsPlayerBufferControlEnabled}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions><Slider Maximum="100" LargeChange="2" SmallChange="1" IsSnapToTickEnabled="True" Value="{Binding PlayerBufferSize, Mode=TwoWay}" /><TextBlock Grid.Column="1" Margin="12,0,0,0" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding PlayerBufferSize, StringFormat={}{0:F0} ms}" /></Grid>
        </settings:SettingsField>
        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource App.DisabledTextBrush}" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_desc1, Mode=OneWay}" TextWrapping="Wrap" />
      </StackPanel>
    </settings:SettingsSection>

    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_test, Mode=OneWay}">
      <StackPanel>
        <settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_latency, Mode=OneWay}">
          <settings:SettingsStatusBanner Icon="i" Status="Information"><TextBlock Text="{Binding PlayerLatency, StringFormat={}{0:N1} ms}" TextWrapping="Wrap" /></settings:SettingsStatusBanner>
        </settings:SettingsField>
        <Button HorizontalAlignment="Left" Style="{StaticResource SettingsQuietButtonStyle}" IsEnabled="{Binding IsAudioDeviceTestAvailable}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_test, Mode=OneWay}" Click="buttonPlayerTestClick" />
        <settings:SettingsStatusBanner Margin="0,10,0,0" Icon="i" Status="Information" Style="{StaticResource SettingsMultilineStringStatusBannerStyle}" Content="{Binding AudioDeviceTestStatusMessage}" />
      </StackPanel>
    </settings:SettingsSection>

    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_volume, Mode=OneWay}">
      <StackPanel>
        <settings:SettingsField Margin="0,0,0,0" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_volume, Mode=OneWay}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions><Slider Maximum="100" LargeChange="2" SmallChange="1" IsSnapToTickEnabled="True" Value="{Binding PlaybackPanel.PlayerVolume, ElementName=page, Mode=TwoWay}" /><TextBlock Grid.Column="1" Margin="12,0,0,0" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding PlaybackPanel.PlayerVolume, ElementName=page, StringFormat={}{0}%}" /></Grid></settings:SettingsField>
        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource App.DisabledTextBrush}" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Device_setting_desc2, Mode=OneWay}" TextWrapping="Wrap" />
      </StackPanel>
    </settings:SettingsSection>
  </StackPanel>
</UserControl>
