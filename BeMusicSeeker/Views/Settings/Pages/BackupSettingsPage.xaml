<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="BeMusicSeeker.Views.Settings.Pages.BackupSettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels" xmlns:v="clr-namespace:BeMusicSeeker.Views" xmlns:settings="clr-namespace:BeMusicSeeker.Views.Settings" xmlns:sys="clr-namespace:System;assembly=System.Runtime" HorizontalContentAlignment="Stretch">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../SettingsControls.xaml" /></ResourceDictionary.MergedDictionaries><v:backupTargetConverter x:Key="backupTargetConverter" /><v:backupSpanRadioConverter x:Key="backupSpanRadioConverter" /></ResourceDictionary></UserControl.Resources>
  <StackPanel>
    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Backup_and_restore, Mode=OneWay}"><WrapPanel><Button MinWidth="180" Margin="0,0,8,8" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Backup_playlist, Mode=OneWay}" Click="detailTabItemBackupButtonClicked" /><Button MinWidth="180" Margin="0,0,0,8" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Backup_restore_playlist, Mode=OneWay}" Click="detailTabItemRestoreButtonClicked" /></WrapPanel></settings:SettingsSection>
    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Backup_lr2backup_optimize, Mode=OneWay}" Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Backup_desc, Mode=OneWay}" IsEnabled="{Binding OperationModeLR2DB}">
      <StackPanel><CheckBox Margin="0,0,0,14" IsChecked="{Binding IsLR2BackupEnabled}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Backup_lr2backup_optimize, Mode=OneWay}" /><StackPanel IsEnabled="{Binding IsLR2BackupEnabled}"><settings:SettingsPathPicker Label="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Backup_lr2backup_saveto, Mode=OneWay}" Path="{Binding LR2BackupPath, Mode=OneWay}" IsPathReadOnly="True" BrowseText="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}" BrowseRequested="browseLr2BackupPathButtonClick" /><settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Target, Mode=OneWay}"><UniformGrid Columns="3"><CheckBox Content="config.xml" IsChecked="{Binding LR2BackupTarget, ConverterParameter=Config, Converter={StaticResource backupTargetConverter}}" /><CheckBox Content="song.db" IsChecked="{Binding LR2BackupTarget, ConverterParameter=SongDB, Converter={StaticResource backupTargetConverter}}" /><CheckBox Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.ScoreDB, Mode=OneWay}" IsChecked="{Binding LR2BackupTarget, ConverterParameter=ScoreDB, Converter={StaticResource backupTargetConverter}}" /></UniformGrid></settings:SettingsField><settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Schedule, Mode=OneWay}"><StackPanel><WrapPanel><RadioButton GroupName="BackupTimespan" Margin="0,0,16,8" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Daily, Mode=OneWay}" IsChecked="{Binding LR2BackupSpan, Converter={StaticResource backupSpanRadioConverter}, ConverterParameter=1}" /><RadioButton GroupName="BackupTimespan" Margin="0,0,16,8" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Weekly, Mode=OneWay}" IsChecked="{Binding LR2BackupSpan, Converter={StaticResource backupSpanRadioConverter}, ConverterParameter=7}" /><RadioButton GroupName="BackupTimespan" Margin="0,0,16,8" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Monthly, Mode=OneWay}" IsChecked="{Binding LR2BackupSpan, Converter={StaticResource backupSpanRadioConverter}, ConverterParameter=30}" /></WrapPanel><ComboBox Width="120" HorizontalAlignment="Left" SelectedValue="{Binding LR2BackupNum}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Backup_numgen, Mode=OneWay}"><sys:Int32>1</sys:Int32><sys:Int32>2</sys:Int32><sys:Int32>3</sys:Int32><sys:Int32>4</sys:Int32><sys:Int32>5</sys:Int32><sys:Int32>6</sys:Int32><sys:Int32>7</sys:Int32><sys:Int32>8</sys:Int32><sys:Int32>9</sys:Int32><sys:Int32>10</sys:Int32></ComboBox></StackPanel></settings:SettingsField></StackPanel></StackPanel>
    </settings:SettingsSection>
  </StackPanel>
</UserControl>
