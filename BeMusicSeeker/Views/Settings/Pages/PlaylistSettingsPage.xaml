<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="BeMusicSeeker.Views.Settings.Pages.PlaylistSettingsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels" xmlns:settings="clr-namespace:BeMusicSeeker.Views.Settings"
 HorizontalContentAlignment="Stretch">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../SettingsControls.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <StackPanel>
    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.CustomFolder, Mode=OneWay}" Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_output_desc, Mode=OneWay}" IsEnabled="{Binding OperationModeLR2DB}">
      <StackPanel>
        <settings:SettingsPathPicker x:Name="customFolderOutputPathPicker" Label="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_output, Mode=OneWay}" Path="{Binding LR2CustomFolderOutputDir, Mode=OneWay}" IsPathReadOnly="True" BrowseText="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}" BrowseRequested="browseLr2CustomFolderOutputDirButtonClick" />
        <settings:SettingsPathPicker x:Name="customFolderRootOutputPathPicker" Label="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_output_root, Mode=OneWay}" Path="{Binding LR2CustomFolderAsRootOutputDir, Mode=OneWay}" IsPathReadOnly="True" BrowseText="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}" BrowseRequested="browseLr2CustomFolderAsRootOutputDirButtonClick" />
        <settings:SettingsListEditor Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_output_additional, Mode=OneWay}">
          <Grid MinWidth="360"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ListBox x:Name="additionalOutputList" Grid.Column="0" MinHeight="128" MinWidth="240" ItemsSource="{Binding CustomFolderAdditionalOutputBaseDirList}" SelectedItem="{Binding SelectedCustomFolderAdditionalOutputBaseDir, Mode=TwoWay}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            <StackPanel Grid.Column="1" Margin="8,0,0,0"><Button MinWidth="96" Margin="0,0,0,8" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Add, Mode=OneWay}" Click="buttonAddCustomFolderAdditionalOutputBaseClicked" /><Button MinWidth="96" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Delete_from_list, Mode=OneWay}" Click="buttonRemoveCustomFolderAdditionalOutputBaseClicked" /></StackPanel>
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding SelectedCustomFolderAdditionalOutputBaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_output_additional_name, Mode=OneWay}" /><Button Grid.Column="1" MinWidth="96" Margin="8,0,0,0" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Rename_folder, Mode=OneWay}" Click="buttonRenameCustomFolderAdditionalOutputBaseClicked" /></Grid>
          </Grid>
        </settings:SettingsListEditor>
        <settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_output_default_folder_types, Mode=OneWay}" Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_output_default_folder_types_desc, Mode=OneWay}">
          <UniformGrid Columns="2">
            <CheckBox Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_all_songs, Mode=OneWay}" IsChecked="{Binding DefaultOutputAllSongsFolder, Mode=TwoWay}" /><CheckBox Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_user, Mode=OneWay}" IsChecked="{Binding DefaultOutputUserFolder, Mode=TwoWay}" />
            <CheckBox Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_level, Mode=OneWay}" IsChecked="{Binding DefaultOutputLevelFolder, Mode=TwoWay}" /><CheckBox Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_alphabet, Mode=OneWay}" IsChecked="{Binding DefaultOutputAlphabetFolder, Mode=TwoWay}" />
            <CheckBox Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_clear, Mode=OneWay}" IsChecked="{Binding DefaultOutputClearFolder, Mode=TwoWay}" /><CheckBox Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_djlevel, Mode=OneWay}" IsChecked="{Binding DefaultOutputDJLevelFolder, Mode=TwoWay}" />
            <CheckBox Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_all, Mode=OneWay}" IsChecked="{Binding DefaultOutputCategoryAllFolder, Mode=TwoWay}" /><CheckBox Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_etc, Mode=OneWay}" IsChecked="{Binding DefaultOutputOtherFolder, Mode=TwoWay}" />
            <CheckBox Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_random, Mode=OneWay}" IsChecked="{Binding DefaultOutputRandomFolder, Mode=TwoWay}" /><CheckBox Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_bpm_sort, Mode=OneWay}" IsChecked="{Binding DefaultOutputBpmSortFolder, Mode=TwoWay}" />
            <CheckBox Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_bp_sort, Mode=OneWay}" IsChecked="{Binding DefaultOutputBpSortFolder, Mode=TwoWay}" /><CheckBox Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_play_count_sort, Mode=OneWay}" IsChecked="{Binding DefaultOutputPlayCountSortFolder, Mode=TwoWay}" />
            <CheckBox Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistProp_ftype_last_play_sort, Mode=OneWay}" IsChecked="{Binding DefaultOutputLastPlaySortFolder, Mode=TwoWay}" />
          </UniformGrid>
        </settings:SettingsField>
      </StackPanel>
    </settings:SettingsSection>
    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_table_uri, Mode=OneWay}"><settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_table_uri, Mode=OneWay}" ValidationMessage="{Binding TableListUriValidationMessage, Mode=OneWay}"><TextBox Text="{Binding TableListURL, UpdateSourceTrigger=LostFocus}" /></settings:SettingsField></settings:SettingsSection>
    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_md5_url_mapping_tsv_uri, Mode=OneWay}">
      <StackPanel><settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_md5_url_mapping_tsv_uri, Mode=OneWay}" ValidationMessage="{Binding PlaylistMd5UrlMappingTsvUriValidationMessage, Mode=OneWay}"><TextBox Text="{Binding PlaylistMd5UrlMappingTsvUri, UpdateSourceTrigger=LostFocus}" /></settings:SettingsField><CheckBox IsChecked="{Binding EnablePlaylistUrlCompletion}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_url_completion_enable, Mode=OneWay}" /><CheckBox IsChecked="{Binding OverwritePlaylistUrlsWithCompletion}" IsEnabled="{Binding EnablePlaylistUrlCompletion}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_url_completion_overwrite, Mode=OneWay}" /><CheckBox IsChecked="{Binding EnableStellaFullPlaylistUrlCompletion}" IsEnabled="{Binding EnablePlaylistUrlCompletion}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_url_completion_stella_full_enable, Mode=OneWay}" /></StackPanel>
    </settings:SettingsSection>
    <settings:SettingsListEditor Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Play_history_folder_display_preset, Mode=OneWay}" Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Play_history_folder_display_preset_desc, Mode=OneWay}">
      <Grid MinWidth="360"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ListBox x:Name="playHistoryPresetList" MinHeight="136" MinWidth="240" ItemsSource="{Binding PlayHistoryFolderDisplayPresets}" SelectedItem="{Binding SelectedPlayHistoryFolderDisplayPreset, Mode=TwoWay}" DisplayMemberPath="Name" ScrollViewer.HorizontalScrollBarVisibility="Disabled" /><StackPanel Grid.Column="1" Margin="8,0,0,0"><Button MinWidth="96" Margin="0,0,0,8" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Add, Mode=OneWay}" Click="buttonAddPlayHistoryFolderDisplayPresetClicked" /><Button MinWidth="96" Margin="0,0,0,8" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Delete_from_list, Mode=OneWay}" IsEnabled="{Binding CanRemovePlayHistoryFolderDisplayPreset}" Click="buttonRemovePlayHistoryFolderDisplayPresetClicked" /><Button MinWidth="96" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Play_history_folder_display_preset_edit, Mode=OneWay}" IsEnabled="{Binding CanEditPlayHistoryFolderDisplayPreset}" Click="buttonEditPlayHistoryFolderDisplayPresetClicked" /></StackPanel></Grid>
    </settings:SettingsListEditor>
  </StackPanel>
</UserControl>
