<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="BeMusicSeeker.Views.Settings.Pages.InstallSettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels" xmlns:settings="clr-namespace:BeMusicSeeker.Views.Settings" HorizontalContentAlignment="Stretch">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../SettingsControls.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <StackPanel>
    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_install_destination_section, Mode=OneWay}"><settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Install_Dst, Mode=OneWay}" ValidationMessage="{Binding BmsInstallDirValidationMessage, Mode=OneWay}" ValidationStatus="{Binding BmsInstallDirValidationStatus, Mode=OneWay}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox MinWidth="240" Style="{StaticResource SettingsValidatedComboBoxStyle}" ItemsSource="{Binding ConfirmedBMSDirectories, Mode=OneWay}" SelectedItem="{Binding BMSInstallDir}" /><Button Grid.Column="1" MinWidth="96" Margin="8,0,0,0" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Add, Mode=OneWay}" Click="addBmsInstallDirButtonClick" /></Grid></settings:SettingsField></settings:SettingsSection>
    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Install_new_folder, Mode=OneWay}" Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Install_new_folder_desc, Mode=OneWay}">
      <StackPanel><settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Install_foldername, Mode=OneWay}"><TextBox Text="{Binding FolderNameFormat}" /></settings:SettingsField><settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Record_setting_replacepattern, Mode=OneWay}"><WrapPanel><Border Style="{StaticResource SettingsTokenChipStyle}"><TextBlock Text="%ARTIST%" /></Border><Border Style="{StaticResource SettingsTokenChipStyle}"><TextBlock Text="%TITLE%" /></Border></WrapPanel></settings:SettingsField><settings:SettingsOptionRow Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Install_desc, Mode=OneWay}" Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Install_shift_jis_description, Mode=OneWay}"><CheckBox IsChecked="{Binding UseOnlyShiftJISChars}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Enable, Mode=OneWay}" /></settings:SettingsOptionRow></StackPanel>
    </settings:SettingsSection>
    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_install_import_section, Mode=OneWay}">
      <StackPanel>
        <settings:SettingsCheckBoxOption Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_test_download_and_install_description, Mode=OneWay}"><CheckBox IsChecked="{Binding EnableAutoInstall}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_test_download_and_install, Mode=OneWay}" /></settings:SettingsCheckBoxOption>
        <settings:SettingsCheckBoxOption Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_test_keep_installable_pending_description, Mode=OneWay}"><CheckBox IsChecked="{Binding KeepInstallablePackagesPending}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_test_keep_installable_pending, Mode=OneWay}" /></settings:SettingsCheckBoxOption>
        <settings:SettingsCheckBoxOption Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_require_complete_used_resources_for_auto_install_description, Mode=OneWay}"><CheckBox IsChecked="{Binding RequireCompleteUsedResourcesForAutoInstall}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_require_complete_used_resources_for_auto_install, Mode=OneWay}" /></settings:SettingsCheckBoxOption>
      </StackPanel>
    </settings:SettingsSection>
    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_install_estimation_section, Mode=OneWay}">
      <StackPanel>
        <settings:SettingsCheckBoxOption Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_auto_apply_ambiguous_install_destination_description, Mode=OneWay}"><CheckBox IsChecked="{Binding AutoApplyAmbiguousInstallDestination}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_auto_apply_ambiguous_install_destination, Mode=OneWay}" /></settings:SettingsCheckBoxOption>
        <settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_install_destination_min_audio_health, Mode=OneWay}" Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_install_destination_min_audio_health_description, Mode=OneWay}"><StackPanel><ComboBox ItemsSource="{Binding InstallDestinationAutoApplyMinAudioHealthOptions}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding InstallDestinationAutoApplyMinAudioHealth, Mode=TwoWay}" IsReadOnly="True" /><settings:SettingsStatusBanner Icon="!" Status="Warning" Style="{StaticResource SettingsMultilineStringStatusBannerStyle}" Content="{Binding InstallDestinationAutoApplyMinAudioHealthWarning, Mode=OneWay}" /></StackPanel></settings:SettingsField>
        <settings:SettingsCheckBoxOption Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_auto_install_after_automatic_estimation_description, Mode=OneWay}"><CheckBox IsChecked="{Binding AutoInstallAfterAutomaticEstimation}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_auto_install_after_automatic_estimation, Mode=OneWay}" /></settings:SettingsCheckBoxOption>
      </StackPanel>
    </settings:SettingsSection>
    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_install_file_handling_section, Mode=OneWay}" Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_install_file_handling_description, Mode=OneWay}">
      <StackPanel>
        <settings:SettingsCheckBoxOption Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_test_smart_component_overwrite_description, Mode=OneWay}"><CheckBox IsChecked="{Binding EnableSmartComponentOverwrite}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_test_smart_component_overwrite, Mode=OneWay}" /></settings:SettingsCheckBoxOption>
        <settings:SettingsCheckBoxOption Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_test_keep_smart_overwrite_protected_by_rename_description, Mode=OneWay}"><CheckBox IsChecked="{Binding KeepSmartOverwriteProtectedFilesByRenaming}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_test_keep_smart_overwrite_protected_by_rename, Mode=OneWay}" /></settings:SettingsCheckBoxOption>
        <settings:SettingsCheckBoxOption Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_test_delete_pending_source_after_install_description, Mode=OneWay}"><CheckBox IsChecked="{Binding DeletePendingPackageSourceAfterInstall}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_test_delete_pending_source_after_install, Mode=OneWay}" /></settings:SettingsCheckBoxOption>
      </StackPanel>
    </settings:SettingsSection>
    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_install_confirmation_section, Mode=OneWay}">
      <StackPanel>
        <CheckBox IsChecked="{Binding ShowDiffBMSInstallConfirmMsg}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_show_diag_diff_install, Mode=OneWay}" />
        <settings:SettingsCheckBoxOption Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_show_diag_new_install_description, Mode=OneWay}"><CheckBox IsChecked="{Binding ShowNewPackageInstallConfirmMsg}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_show_diag_new_install, Mode=OneWay}" /></settings:SettingsCheckBoxOption>
      </StackPanel>
    </settings:SettingsSection>
  </StackPanel>
</UserControl>
