<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="BeMusicSeeker.Views.Settings.Pages.GeneralSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:BeMusicSeeker.Views.Settings" xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels"
             HorizontalContentAlignment="Stretch">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../SettingsControls.xaml" /></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></ResourceDictionary></UserControl.Resources>
  <StackPanel>
    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Language, Mode=OneWay}">
      <ComboBox AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Language, Mode=OneWay}" x:Name="languageComboBox" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" />
    </settings:SettingsSection>

    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_environment, Mode=OneWay}"
                              Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_library_composition_description, Mode=OneWay}">
      <StackPanel IsEnabled="{Binding IsEnvironmentSelectionEnabled}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <RadioButton x:Name="radioButtonNotUseLR2" Style="{StaticResource SettingsEnvironmentRadioStyle}"
                       GroupName="OperationMode" IsChecked="{Binding IsStandaloneOperationMode, Mode=OneWay}"
                       Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Operation_Mode_Standalone, Mode=OneWay}"
                       AutomationProperties.HelpText="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_standalone_description, Mode=OneWay}"
                       Click="operationModeRadioButtonClick" />
          <RadioButton x:Name="radioButtonUseLR2" Grid.Column="2" Style="{StaticResource SettingsEnvironmentRadioStyle}"
                       GroupName="OperationMode" IsChecked="{Binding OperationModeLR2DB, Mode=OneWay}"
                       Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Operation_Mode_LR2, Mode=OneWay}"
                       AutomationProperties.HelpText="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_lr2_linked_description, Mode=OneWay}"
                       Click="operationModeRadioButtonClick" />
        </Grid>
      <StackPanel Margin="0,8,0,0" IsEnabled="{Binding IsChecked, ElementName=radioButtonUseLR2}">
        <settings:SettingsStatusBanner Margin="0,0,0,16" Icon="!" Status="Error" Content="{Binding Lr2PathSelectionError}" Visibility="{Binding HasLr2PathSelectionError, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <settings:SettingsPathPicker Label="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.DirPath_LR2, Mode=OneWay}" Path="{Binding LR2RootPath, Mode=OneWay}" IsPathReadOnly="True" BrowseText="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}" ValidationMessage="{Binding Lr2RootPathValidationMessage, Mode=OneWay}" ValidationStatus="{Binding Lr2RootPathValidationStatus, Mode=OneWay}" BrowseRequested="browseLr2RootPathButtonClick" />
        <Expander IsExpanded="False" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details, Mode=OneWay}"><StackPanel>
        <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource App.DisabledTextBrush}" TextWrapping="Wrap" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_lr2_paths_description}" />
        <settings:SettingsPathPicker Margin="0" Label="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.FilePath_songDB, Mode=OneWay}" Path="{Binding LR2SongDBPath, Mode=OneWay}" IsPathReadOnly="True" BrowseText="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}" BrowseRequested="browseLr2SongDbPathButtonClick" />
        <settings:SettingsStatusBanner Icon="{Binding Lr2SongDbPathStatusIcon}" Status="{Binding Lr2SongDbPathStatusKind}" Content="{Binding Lr2SongDbPathStatusText}" />
        <settings:SettingsPathPicker Margin="0" Label="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.FilePath_configXml, Mode=OneWay}" Path="{Binding LR2ConfigXmlPath, Mode=OneWay}" IsPathReadOnly="True" BrowseText="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}" BrowseRequested="browseLr2ConfigPathButtonClick" />
        <settings:SettingsStatusBanner Icon="{Binding Lr2ConfigPathStatusIcon}" Status="{Binding Lr2ConfigPathStatusKind}" Content="{Binding Lr2ConfigPathStatusText}" />
<StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Tag="confirm:environment" Style="{StaticResource SettingsPrimaryButtonStyle}" IsEnabled="{Binding CanConfirmEnvironment}" AutomationProperties.AutomationId="SettingsConfirmenvironment" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_confirm_environment, Mode=OneWay}" /><Button Tag="cancel:environment" Style="{StaticResource SettingsQuietButtonStyle}" AutomationProperties.AutomationId="SettingsCancelenvironment" Margin="8,0,0,0" IsEnabled="{Binding CanCancelEnvironment}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_cancel_changes, Mode=OneWay}" /></StackPanel>
        </StackPanel></Expander>
      </StackPanel>

      </StackPanel>
    </settings:SettingsSection>

    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Standalone_BMSDirectories, Mode=OneWay}"
                              Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_bms_directories_description, Mode=OneWay}"><StackPanel>
      <settings:SettingsListEditor IsHeaderVisible="False" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Standalone_BMSDirectories, Mode=OneWay}" IsEnabled="{Binding IsBmsSearchRootEditorEnabled}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <ListBox x:Name="bmsSearchRootPathListBox" MinHeight="112" ItemsSource="{Binding AvailableBMSDirectories}" SelectedItem="{Binding SelectedBmsSearchRootPath, Mode=TwoWay}" AllowDrop="True" Drop="bmsSearchRootPathListBoxDrop" PreviewDragEnter="bmsSearchRootPathListBoxDragOver" PreviewDragOver="bmsSearchRootPathListBoxDragOver" />
          <StackPanel Grid.Column="1" Margin="8,0,0,0"><Button x:Name="addBmsSearchRootButton" MinWidth="88" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Add_BMSDirectory, Mode=OneWay}" AutomationProperties.AutomationId="SettingsAddBmsSearchRoot" Click="buttonAddBmsSearchRootPathsClicked" /><Button x:Name="removeBmsSearchRootButton" MinWidth="88" Margin="0,8,0,0" Style="{StaticResource SettingsQuietButtonStyle}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Remove_BMSDirectory, Mode=OneWay}" AutomationProperties.AutomationId="SettingsRemoveBmsSearchRoot" Command="{Binding RemoveDirCommand}" CommandParameter="{Binding SelectedBmsSearchRootPath}" /></StackPanel>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Foreground="{DynamicResource App.DisabledTextBrush}" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_list_drag_drop_hint, Mode=OneWay}" TextWrapping="Wrap" />
        </Grid>
      </settings:SettingsListEditor>
    <settings:SettingsStatusBanner Margin="0,8,0,8" Icon="!" Status="Warning" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_repair_related_save}" Visibility="{Binding IsBmsSaveIncomplete, Converter={StaticResource BooleanToVisibilityConverter}}" />
    <settings:SettingsField IsEnabled="{Binding IsEditCompletionEnabled}" Visibility="{Binding RequiresReplacementBmsInstallDir, Converter={StaticResource BooleanToVisibilityConverter}}" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_replacement_install}"><ComboBox ItemsSource="{Binding AvailableBMSDirectories}" SelectedItem="{Binding ReplacementBmsInstallDir}" /></settings:SettingsField><settings:SettingsStatusBanner Margin="0,8,0,8" Icon="!" Status="Warning" Style="{StaticResource SettingsMultilineStringStatusBannerStyle}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_processing_retry}" Visibility="{Binding IsBmsProcessingRetryRequired, Converter={StaticResource BooleanToVisibilityConverter}}" />
<StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Tag="confirm:bms" Style="{StaticResource SettingsPrimaryButtonStyle}" IsEnabled="{Binding CanConfirmBmsRoots}" AutomationProperties.AutomationId="SettingsConfirmbms" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_confirm_bms_roots, Mode=OneWay}" /><Button Tag="cancel:bms" Style="{StaticResource SettingsQuietButtonStyle}" AutomationProperties.AutomationId="SettingsCancelbms" Margin="8,0,0,0" IsEnabled="{Binding CanCancelBmsRoots}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_cancel_changes, Mode=OneWay}" /></StackPanel></StackPanel></settings:SettingsSection>



    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_song_db_sync_data_resync, Mode=OneWay}"
                              Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_song_db_sync_data_resync_description, Mode=OneWay}">
      <StackPanel IsEnabled="{Binding CanUseLr2Features}">
        <Button HorizontalAlignment="Left" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_song_db_sync_data_resync, Mode=OneWay}" IsEnabled="{Binding CanRequestLr2SongDbSyncDataResync, Mode=OneWay}" AutomationProperties.AutomationId="SettingsResyncLr2SongDb" Click="resyncLr2SongDbSyncDataButtonClicked" />
      </StackPanel>
    </settings:SettingsSection>

    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_play_history_schema_label, Mode=OneWay}">
      <StackPanel IsEnabled="{Binding CanUseLr2Features}">
        <settings:SettingsStatusBanner Content="{Binding Lr2PlayHistorySchemaStatusText, Mode=OneWay}" ToolTip="{Binding Lr2PlayHistorySchemaDetailText, Mode=OneWay}">
          <settings:SettingsStatusBanner.Style><Style TargetType="{x:Type settings:SettingsStatusBanner}" BasedOn="{StaticResource {x:Type settings:SettingsStatusBanner}}"><Setter Property="Icon" Value="i" /><Setter Property="Status" Value="Information" /><Style.Triggers><DataTrigger Binding="{Binding CanInstallOrRepairLr2PlayHistorySchema, Mode=OneWay}" Value="True"><Setter Property="Icon" Value="!" /><Setter Property="Status" Value="Warning" /><Setter Property="Foreground" Value="{DynamicResource App.WarningTextBrush}" /></DataTrigger></Style.Triggers></Style></settings:SettingsStatusBanner.Style>
        </settings:SettingsStatusBanner>
        <Button HorizontalAlignment="Left" Content="{Binding Lr2PlayHistorySchemaInstallOrRepairButtonText, Mode=OneWay}" IsEnabled="{Binding CanInstallOrRepairLr2PlayHistorySchema, Mode=OneWay}" AutomationProperties.AutomationId="SettingsInstallOrRepairLr2PlayHistorySchema" Click="installOrRepairLr2PlayHistorySchemaButtonClicked" />
      </StackPanel>
    </settings:SettingsSection>


    <settings:SettingsSection Margin="0" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Beatoraja_integration, Mode=OneWay}"><StackPanel>
      <StackPanel IsEnabled="{Binding IsBeatorajaSelectionEnabled}">
        <settings:SettingsPathPicker Label="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.FilePath_beatoraja_root, Mode=OneWay}" Path="{Binding BeatorajaRootPath, Mode=OneWay}" IsPathReadOnly="True" BrowseText="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}" BrowseRequested="browseBeatorajaRootPathButtonClick" />
        <Expander IsExpanded="False" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details, Mode=OneWay}"><StackPanel>
        <settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Beatoraja_player, Mode=OneWay}"><TextBox x:Name="environmentBeatorajaPlayerTextBox" IsReadOnly="True" Text="{Binding EnvironmentBeatorajaPlayerId, Mode=OneWay}" /></settings:SettingsField>
        <settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.FilePath_scoreDB, Mode=OneWay}"><TextBox x:Name="environmentBeatorajaScoreDbTextBox" IsReadOnly="True" Text="{Binding EnvironmentBeatorajaScoreDbPath, Mode=OneWay}" /></settings:SettingsField>
        <settings:SettingsField Margin="0" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.FilePath_beatoraja_table, Mode=OneWay}"><TextBox x:Name="environmentBeatorajaTableTextBox" IsReadOnly="True" Text="{Binding EnvironmentBeatorajaBmtTablePath, Mode=OneWay}" /></settings:SettingsField>
        </StackPanel></Expander>

      </StackPanel>

      <StackPanel>


        <Button HorizontalAlignment="Left" Margin="0,16,0,8" Style="{StaticResource SettingsQuietButtonStyle}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Import_beatoraja_table_urls_button, Mode=OneWay}" AutomationProperties.AutomationId="SettingsImportBeatorajaTableUrls" Click="importBeatorajaTableUrlsButtonClick" />
        <StackPanel IsEnabled="{Binding IsBeatorajaSelectionEnabled}">
        <CheckBox x:Name="useBeatorajaScoreDbCheckBox" Margin="0,8,0,0" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Use_beatoraja_scoreDB, Mode=OneWay}" IsChecked="{Binding UseBeatorajaScoreDb}" />
        <settings:SettingsField Margin="26,8,0,16" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Beatoraja_player, Mode=OneWay}" IsEnabled="{Binding UseBeatorajaScoreDb}"><ComboBox ItemsSource="{Binding AvailableBeatorajaPlayers}" SelectedItem="{Binding BeatorajaPlayerId}" /></settings:SettingsField>
<settings:SettingsStatusBanner Margin="0,8,0,8" Icon="!" Status="Warning" Style="{StaticResource SettingsMultilineStringStatusBannerStyle}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_processing_retry}" Visibility="{Binding IsScoreProcessingRetryRequired, Converter={StaticResource BooleanToVisibilityConverter}}" />
</StackPanel>
<Button AutomationProperties.AutomationId="SettingsRetryScore" Tag="retry:score" Style="{StaticResource SettingsQuietButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0" IsEnabled="{Binding IsEditCompletionEnabled}" Visibility="{Binding CanRetryScoreSettings, Converter={StaticResource BooleanToVisibilityConverter}}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_retry, Mode=OneWay}" />
        <StackPanel IsEnabled="{Binding IsEnvironmentSelectionEnabled}">
        <CheckBox Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Use_beatoraja_bmt_output, Mode=OneWay}" IsChecked="{Binding EnableBeatorajaBmtOutput}" />
        <settings:SettingsField x:Name="beatorajaHashOutputModeField" Margin="26,8,0,16" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Beatoraja_bmt_hash_output_mode, Mode=OneWay}" IsEnabled="{Binding EnableBeatorajaBmtOutput}"><ComboBox x:Name="beatorajaHashOutputModeComboBox" ItemsSource="{Binding BeatorajaBmtHashOutputModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Key" SelectedValue="{Binding BeatorajaBmtHashOutputMode, Mode=TwoWay}" /></settings:SettingsField>
        <CheckBox Margin="26,0,0,0" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Keep_beatoraja_bmt_files_when_output_disabled, Mode=OneWay}" IsChecked="{Binding KeepBeatorajaBmtFilesWhenOutputDisabled}" />
        <CheckBox Margin="26,0,0,0" IsEnabled="{Binding EnableBeatorajaBmtOutput}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Register_beatoraja_bmt_urls, Mode=OneWay}" IsChecked="{Binding RegisterBeatorajaBmtUrls}" />
        </StackPanel>
      </StackPanel>
    <settings:SettingsStatusBanner Margin="0,8,0,8" Icon="!" Status="Warning" Style="{StaticResource SettingsMultilineStringStatusBannerStyle}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_processing_retry}" Visibility="{Binding IsBmtProcessingRetryRequired, Converter={StaticResource BooleanToVisibilityConverter}}" />
<StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Tag="confirm:bmt" Style="{StaticResource SettingsPrimaryButtonStyle}" IsEnabled="{Binding CanConfirmBmtSettings}" AutomationProperties.AutomationId="SettingsConfirmbmt" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_confirm_bmt, Mode=OneWay}" /><Button Tag="cancel:bmt" Style="{StaticResource SettingsQuietButtonStyle}" AutomationProperties.AutomationId="SettingsCancelbmt" Margin="8,0,0,0" IsEnabled="{Binding CanCancelBmtSettings}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_cancel_changes, Mode=OneWay}" /></StackPanel></StackPanel></settings:SettingsSection>

  </StackPanel>
</UserControl>
