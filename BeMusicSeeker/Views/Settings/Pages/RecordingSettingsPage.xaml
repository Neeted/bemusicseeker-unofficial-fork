<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="BeMusicSeeker.Views.Settings.Pages.RecordingSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:BeMusicSeeker.Views" xmlns:settings="clr-namespace:BeMusicSeeker.Views.Settings" xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels"
             HorizontalContentAlignment="Stretch">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../SettingsControls.xaml" /></ResourceDictionary.MergedDictionaries><v:encoderDriverSelectionEnabledConverter x:Key="encoderDriverSelectionEnabledConverter" /></ResourceDictionary></UserControl.Resources>
  <StackPanel>
    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Record_setting, Mode=OneWay}"
                              Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_recording_format_description, Mode=OneWay}">
      <StackPanel>
        <settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Record_setting_filetype, Mode=OneWay}"><ComboBox x:Name="comboBoxEncoder" IsSynchronizedWithCurrentItem="True" IsReadOnly="True" ItemsSource="{Binding EncoderNames}" SelectedIndex="{Binding EncoderIndex, Mode=TwoWay}" SelectionChanged="comboBoxEncoderSelectionChanged" /></settings:SettingsField>
        <settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Record_setting_quality, Mode=OneWay}" IsEnabled="{Binding SelectedIndex, ElementName=comboBoxEncoder, Converter={StaticResource encoderDriverSelectionEnabledConverter}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions><Slider Maximum="1" LargeChange="0.2" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding EncoderQuality, Mode=TwoWay}" /><TextBlock Grid.Column="1" Margin="12,0,0,0" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding EncoderQuality, StringFormat={}{0:N1}}" /></Grid></settings:SettingsField>
        <UniformGrid Columns="2">
          <settings:SettingsField Margin="0,0,6,14" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Record_setting_samplerate, Mode=OneWay}"><ComboBox SelectedValuePath="Key" DisplayMemberPath="Value" IsReadOnly="True" ItemsSource="{Binding PlayerSampleRateNames}" SelectedValue="{Binding EncoderSampleRate, Mode=TwoWay}" /></settings:SettingsField>
          <settings:SettingsField Margin="6,0,0,14" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Record_setting_format, Mode=OneWay}"><ComboBox SelectedValuePath="Key" DisplayMemberPath="Value" IsReadOnly="True" ItemsSource="{Binding PlayerFormatNames}" SelectedValue="{Binding EncoderFormat, Mode=TwoWay}" /></settings:SettingsField>
        </UniformGrid>
        <settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Record_setting_normalize, Mode=OneWay}"><ComboBox SelectedValuePath="Key" DisplayMemberPath="Value" IsReadOnly="True" ItemsSource="{Binding EncoderNormalizationNames}" SelectedValue="{Binding EncoderNormalization, Mode=TwoWay}" /></settings:SettingsField>
        <settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Record_setting_gain, Mode=OneWay}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions><Slider Minimum="0.5" Maximum="1.5" LargeChange="0.2" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding EncoderAmplifier, Mode=TwoWay}" /><TextBlock Grid.Column="1" Margin="12,0,0,0" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding EncoderAmplifier, StringFormat=x{0:N1}}" /></Grid></settings:SettingsField>
      </StackPanel>
    </settings:SettingsSection>

    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Record_setting_filename, Mode=OneWay}">
      <StackPanel>
        <settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Record_setting_filename, Mode=OneWay}"><TextBox Text="{Binding EncodeFileNameFormat}" /></settings:SettingsField>
        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Record_setting_replacepattern, Mode=OneWay}" />
        <WrapPanel>
          <Border Style="{StaticResource SettingsTokenChipStyle}"><TextBlock Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_token_artist, Mode=OneWay}" /></Border>
          <Border Style="{StaticResource SettingsTokenChipStyle}"><TextBlock Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_token_title, Mode=OneWay}" /></Border>
          <Border Style="{StaticResource SettingsTokenChipStyle}"><TextBlock Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_token_genre, Mode=OneWay}" /></Border>
          <Border Style="{StaticResource SettingsTokenChipStyle}"><TextBlock Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_token_number, Mode=OneWay}" /></Border>
          <Border Style="{StaticResource SettingsTokenChipStyle}"><TextBlock Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_token_file, Mode=OneWay}" /></Border>
          <Border Style="{StaticResource SettingsTokenChipStyle}"><TextBlock Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_token_hash, Mode=OneWay}" /></Border>
        </WrapPanel>
      </StackPanel>
    </settings:SettingsSection>

    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Record_setting_encoder, Mode=OneWay}"
                              Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Record_setting_encoder_desc, Mode=OneWay}">
      <settings:SettingsPathPicker Label="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Record_setting_encoder_dir, Mode=OneWay}"
                                   Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Record_setting_encoder_tooltip, Mode=OneWay}"
                                   Path="{Binding EncoderExeDir, Mode=OneWay}" IsPathReadOnly="True" BrowseText="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}" BrowseRequested="browseEncoderExeDirButtonClick" />
    </settings:SettingsSection>
  </StackPanel>
</UserControl>
