<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="BeMusicSeeker.Views.Settings.Pages.AppearanceSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:BeMusicSeeker.Views.Settings"
             xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels"
             x:Name="page" HorizontalContentAlignment="Stretch">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../SettingsControls.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <StackPanel>
    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance_theme, Mode=OneWay}"
                              Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_appearance_theme_description, Mode=OneWay}">
      <UniformGrid Columns="2">
        <settings:SettingsOptionRow Margin="0,0,6,0" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance_theme_light, Mode=OneWay}"
                                    Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_appearance_theme_light_description, Mode=OneWay}">
          <RadioButton x:Name="radioButtonLightTheme" GroupName="AppearanceTheme" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance_theme_light, Mode=OneWay}" IsChecked="{Binding IsLightAppearanceTheme, Mode=TwoWay}" />
        </settings:SettingsOptionRow>
        <settings:SettingsOptionRow Margin="6,0,0,0" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance_theme_dark, Mode=OneWay}"
                                    Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_appearance_theme_dark_description, Mode=OneWay}">
          <RadioButton x:Name="radioButtonDarkTheme" GroupName="AppearanceTheme" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance_theme_dark, Mode=OneWay}" IsChecked="{Binding IsDarkAppearanceTheme, Mode=TwoWay}" />
        </settings:SettingsOptionRow>
      </UniformGrid>
    </settings:SettingsSection>

    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance_table, Mode=OneWay}"
                              Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_appearance_table_description, Mode=OneWay}">
      <StackPanel>
        <settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance_table_font_size, Mode=OneWay}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
            <Slider Minimum="8" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CustomTableFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding CustomTableFontSize, StringFormat={}{0:F0} pt}" />
          </Grid>
        </settings:SettingsField>
        <settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance_table_row_height, Mode=OneWay}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
            <Slider Minimum="16" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CustomTableRowHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding CustomTableRowHeight, StringFormat={}{0:F0} px}" />
          </Grid>
        </settings:SettingsField>
        <settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance_table_header_height, Mode=OneWay}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
            <Slider Minimum="18" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CustomTableHeaderHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding CustomTableHeaderHeight, StringFormat={}{0:F0} px}" />
          </Grid>
        </settings:SettingsField>
        <Button HorizontalAlignment="Right" Style="{StaticResource SettingsQuietButtonStyle}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance_table_reset_defaults, Mode=OneWay}" Click="resetCustomTableAppearanceDefaultsButtonClick" />
      </StackPanel>
    </settings:SettingsSection>

    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Change_stage_file, Mode=OneWay}">
      <StackPanel>
        <CheckBox x:Name="checkBoxUseExternalPanelImage" IsChecked="{Binding UseExternalPanelImage}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Change_stage_file, Mode=OneWay}" />
        <settings:SettingsPathPicker Margin="24,10,0,0" IsEnabled="{Binding IsChecked, ElementName=checkBoxUseExternalPanelImage}"
                                     Label="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.FilePath_StageFile, Mode=OneWay}"
                                     Path="{Binding StagefilePath, Mode=OneWay}" IsPathReadOnly="True"
                                     BrowseText="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Browse, Mode=OneWay}"
                                     BrowseRequested="browseStagefilePathButtonClick" />
      </StackPanel>
    </settings:SettingsSection>
  </StackPanel>
</UserControl>
