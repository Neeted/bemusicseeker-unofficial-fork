<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="BeMusicSeeker.Views.Settings.Pages.AdvancedSettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels" xmlns:settings="clr-namespace:BeMusicSeeker.Views.Settings" HorizontalContentAlignment="Stretch">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../SettingsControls.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <StackPanel>
    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_message_diag, Mode=OneWay}"><StackPanel><CheckBox IsChecked="{Binding ShowScoreViewerRegisterConfirmMsg}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_show_diag_chartview, Mode=OneWay}" /><CheckBox IsChecked="{Binding ShowDuplicateFileCheckConfirmMsg}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_show_diag_duplicate_file_check, Mode=OneWay}" /><CheckBox IsChecked="{Binding ShowRecommUpdatedMsg}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_show_diag_recommend, Mode=OneWay}" /></StackPanel></settings:SettingsSection>
    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_initialization_settings, Mode=OneWay}"><StackPanel><settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Startup_sort_cache_label, Mode=OneWay}" Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Startup_sort_cache_description, Mode=OneWay}"><StackPanel><ComboBox ItemsSource="{Binding StartupSortCachePrewarmOptions}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding StartupSortCachePrewarmPriority, Mode=TwoWay}" IsReadOnly="True" /><settings:SettingsStatusBanner Icon="!" Status="Warning" Style="{StaticResource SettingsMultilineStringStatusBannerStyle}" Content="{Binding StartupSortCachePrewarmWarning, Mode=OneWay}" /></StackPanel></settings:SettingsField><CheckBox IsChecked="{Binding ScanBmsFilesOnStartup}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_scan_bms_files_on_startup, Mode=OneWay}" /><CheckBox IsChecked="{Binding SkipInitPlaylistLoad}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_test_notcheck_playlists, Mode=OneWay}" /><CheckBox IsChecked="{Binding StartupSelectInstallPending}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_test_startup_select_install_pending, Mode=OneWay}" /><CheckBox IsChecked="{Binding EnableReadOptimizedPragmas}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_test_db_read_optimized_pragmas, Mode=OneWay}" /></StackPanel></settings:SettingsSection>
    <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_lr2_integration_settings, Mode=OneWay}"><StackPanel><CheckBox IsChecked="{Binding UpdateLr2IrRankingCacheOnStartup}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_update_lr2ir_ranking_cache_on_startup, Mode=OneWay}" /><CheckBox IsChecked="{Binding EstimateOfflineScoreRanking}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_estimate_offline_score_ranking, Mode=OneWay}" /><CheckBox IsChecked="{Binding EnableDownloadLr2IrScoreAndDetectUnsent}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Details_download_lr2ir_score_and_detect_unsent, Mode=OneWay}" /></StackPanel></settings:SettingsSection>
    <settings:SettingsSection Margin="0" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_danger_zone, Mode=OneWay}" Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_danger_zone_description, Mode=OneWay}">
      <StackPanel><settings:SettingsField Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_play_history_schema_label, Mode=OneWay}" Description="{Binding Lr2PlayHistorySchemaDetailText, Mode=OneWay}"><StackPanel><settings:SettingsStatusBanner Content="{Binding Lr2PlayHistorySchemaStatusText, Mode=OneWay}"><settings:SettingsStatusBanner.Style><Style TargetType="{x:Type settings:SettingsStatusBanner}" BasedOn="{StaticResource {x:Type settings:SettingsStatusBanner}}"><Setter Property="Icon" Value="i" /><Setter Property="Status" Value="Information" /><Style.Triggers><DataTrigger Binding="{Binding CanInstallOrRepairLr2PlayHistorySchema, Mode=OneWay}" Value="True"><Setter Property="Icon" Value="!" /><Setter Property="Status" Value="Warning" /><Setter Property="Foreground" Value="{DynamicResource App.WarningTextBrush}" /></DataTrigger></Style.Triggers></Style></settings:SettingsStatusBanner.Style></settings:SettingsStatusBanner><Button HorizontalAlignment="Left" Style="{StaticResource SettingsDangerButtonStyle}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_play_history_schema_uninstall, Mode=OneWay}" IsEnabled="{Binding CanUninstallLr2PlayHistorySchema, Mode=OneWay}" Click="uninstallLr2PlayHistorySchemaButtonClicked" /></StackPanel></settings:SettingsField><settings:SettingsField Margin="0" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Backup_unistall, Mode=OneWay}" Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Backup_unistall_desc, Mode=OneWay}"><Button HorizontalAlignment="Left" Style="{StaticResource SettingsDangerButtonStyle}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_uninstall_application_data, Mode=OneWay}" IsEnabled="{Binding CanUninstallApplicationData, Mode=OneWay}" Click="applicationDataUninstallButtonClicked" /></settings:SettingsField></StackPanel>
    </settings:SettingsSection>
  </StackPanel>
</UserControl>
