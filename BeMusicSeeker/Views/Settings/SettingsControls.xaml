<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:settings="clr-namespace:BeMusicSeeker.Views.Settings">
  <ControlTemplate x:Key="SettingsButtonTemplate" TargetType="{x:Type Button}">
    <Grid SnapsToDevicePixels="True">
      <Border x:Name="ButtonChrome"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6">
        <ContentPresenter Margin="{TemplateBinding Padding}"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          RecognizesAccessKey="True" />
      </Border>
      <Border x:Name="FocusBorder"
              BorderBrush="{TemplateBinding Tag}"
              BorderThickness="2"
              CornerRadius="6"
              IsHitTestVisible="False"
              Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.55" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="SettingsTrackRepeatButtonTemplate" TargetType="{x:Type RepeatButton}">
    <Border Background="{TemplateBinding Tag}" />
  </ControlTemplate>
  <Style x:Key="SettingsTrackRepeatButtonStyle" TargetType="{x:Type RepeatButton}" BasedOn="{x:Null}">
    <Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" /><Setter Property="Template" Value="{StaticResource SettingsTrackRepeatButtonTemplate}" />
  </Style>

  <Style x:Key="SettingsButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource App.ControlBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="Tag" Value="{DynamicResource App.InputFocusBorderBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource SettingsButtonTemplate}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.ControlHoverBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.ControlPressedBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SettingsButtonStyle}" />

  <Style x:Key="SettingsPrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SettingsButtonStyle}">
    <Setter Property="Background" Value="{DynamicResource App.AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource App.AccentForegroundBrush}" />
    <Setter Property="Tag" Value="{DynamicResource App.AccentFocusRingBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.AccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App.AccentForegroundBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.AccentPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.AccentPressedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App.AccentForegroundBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource App.AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App.AccentForegroundBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SettingsQuietButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SettingsButtonStyle}">
    <Setter Property="Background" Value="{x:Null}" />
  </Style>

  <Style x:Key="SettingsDangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SettingsButtonStyle}">
    <Setter Property="Background" Value="{DynamicResource App.DangerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.DangerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource App.DangerForegroundBrush}" />
    <Setter Property="Tag" Value="{DynamicResource App.DangerForegroundBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.DangerHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.DangerHoverBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.DangerPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.DangerPressedBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SettingsIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SettingsQuietButtonStyle}">
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style x:Key="settingsFooterActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SettingsButtonStyle}">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="settingsPrimaryActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SettingsPrimaryButtonStyle}">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="settingsQuietActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SettingsQuietButtonStyle}">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <ControlTemplate x:Key="SettingsTextBoxTemplate" TargetType="{x:Type TextBox}">
    <Grid>
      <Border x:Name="TextBoxChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Style="{DynamicResource SettingsScrollViewerStyle}" />
      </Border>
      <Border x:Name="FocusBorder" BorderBrush="{DynamicResource App.InputFocusBorderBrush}" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TextBoxChrome" Property="Opacity" Value="0.55" /><Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" /></Trigger>
      <Trigger Property="IsReadOnly" Value="True"><Setter Property="Background" Value="{DynamicResource App.SurfaceBrush}" /></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="{x:Type TextBox}">
    <Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="8,3" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource App.ControlBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Template" Value="{StaticResource SettingsTextBoxTemplate}" />
  </Style>

  <ControlTemplate x:Key="SettingsComboBoxTemplate" TargetType="{x:Type ComboBox}">
    <Grid>
      <Border x:Name="ComboChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
          <ToggleButton x:Name="DropDownToggle" Grid.ColumnSpan="2" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Border Background="Transparent"><ContentPresenter /></Border>
              </ControlTemplate>
            </ToggleButton.Template>
            <Path Width="8" Height="5" HorizontalAlignment="Right" Margin="0,0,11,0" Fill="{DynamicResource App.TextBrush}" Data="M 0 0 L 4 4 L 8 0 Z" />
          </ToggleButton>
          <ContentPresenter x:Name="SelectionContent" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False" />
          <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsReadOnly="{TemplateBinding IsReadOnly}" Visibility="Collapsed" />
        </Grid>
      </Border>
      <Border x:Name="FocusBorder" BorderBrush="{DynamicResource App.InputFocusBorderBrush}" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" Visibility="Collapsed" />
      <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade">
        <Border MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{DynamicResource App.PopupBackgroundBrush}" BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="1" CornerRadius="4">
          <ScrollViewer Style="{DynamicResource SettingsScrollViewerStyle}" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
        </Border>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboChrome" Property="Background" Value="{DynamicResource App.ControlHoverBrush}" /></Trigger>
      <Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" /><Setter TargetName="SelectionContent" Property="Visibility" Value="Collapsed" /></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboChrome" Property="Opacity" Value="0.55" /><Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" /></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="{x:Type ComboBox}">
    <Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="8,3" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource App.ControlBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="ScrollViewer.CanContentScroll" Value="True" /><Setter Property="ItemContainerStyle" Value="{DynamicResource SettingsComboBoxItemStyle}" /><Setter Property="Template" Value="{StaticResource SettingsComboBoxTemplate}" />
  </Style>

  <ControlTemplate x:Key="SettingsCheckBoxTemplate" TargetType="{x:Type CheckBox}">
    <Grid Background="{x:Null}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border x:Name="CheckChrome" Width="18" Height="18" VerticalAlignment="Center" Background="{DynamicResource App.ControlBackgroundBrush}" BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="1" CornerRadius="3">
        <Path x:Name="CheckGlyph" Width="10" Height="8" Data="M 0 4 L 3.5 7.5 L 10 0" Stroke="{DynamicResource App.AccentForegroundBrush}" StrokeThickness="2" Visibility="Collapsed" />
      </Border>
      <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
      <Border x:Name="FocusBorder" Grid.ColumnSpan="2" BorderBrush="{DynamicResource App.InputFocusBorderBrush}" BorderThickness="1" CornerRadius="3" IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource App.AccentBrush}" /><Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" /><Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" /></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource App.InputFocusBorderBrush}" /></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /><Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" /></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="{x:Type CheckBox}">
    <Setter Property="MinHeight" Value="24" /><Setter Property="Padding" Value="8,2,0,2" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Template" Value="{StaticResource SettingsCheckBoxTemplate}" />
    <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="styleWrappingSettingCheckBox" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}" />

  <ControlTemplate x:Key="SettingsRadioButtonTemplate" TargetType="{x:Type RadioButton}">
    <Grid Background="{x:Null}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border x:Name="RadioChrome" Width="18" Height="18" VerticalAlignment="Center" Background="{DynamicResource App.ControlBackgroundBrush}" BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="1" CornerRadius="9">
        <Ellipse x:Name="RadioGlyph" Width="8" Height="8" Fill="{DynamicResource App.AccentBrush}" Visibility="Collapsed" />
      </Border>
      <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
      <Border x:Name="FocusBorder" Grid.ColumnSpan="2" BorderBrush="{DynamicResource App.InputFocusBorderBrush}" BorderThickness="1" CornerRadius="3" IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="RadioChrome" Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" /><Setter TargetName="RadioGlyph" Property="Visibility" Value="Visible" /></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RadioChrome" Property="BorderBrush" Value="{DynamicResource App.InputFocusBorderBrush}" /></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /><Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" /></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="{x:Type RadioButton}">
    <Setter Property="MinHeight" Value="24" /><Setter Property="Padding" Value="8,2,0,2" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Template" Value="{StaticResource SettingsRadioButtonTemplate}" />
    <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></Setter.Value></Setter>
  </Style>

  <ControlTemplate x:Key="SettingsHorizontalSliderTemplate" TargetType="{x:Type Slider}">
    <Grid MinHeight="24">
      <Grid.RowDefinitions><RowDefinition Height="4" /><RowDefinition Height="*" /><RowDefinition Height="4" /></Grid.RowDefinitions>
      <TickBar x:Name="TopTickBar" Grid.Row="0" Placement="Top" Fill="{DynamicResource App.SliderTickBrush}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" TickFrequency="{TemplateBinding TickFrequency}" Ticks="{TemplateBinding Ticks}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" Visibility="Collapsed" />
      <Track x:Name="PART_Track" Grid.Row="1" VerticalAlignment="Center">
        <Track.DecreaseRepeatButton><RepeatButton Height="4" Tag="{DynamicResource App.AccentBrush}" Style="{StaticResource SettingsTrackRepeatButtonStyle}" Command="{x:Static Slider.DecreaseLarge}" /></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb Width="16" Height="16" Tag="{DynamicResource App.AccentBrush}"><Thumb.Template><ControlTemplate TargetType="{x:Type Thumb}"><Ellipse Fill="{TemplateBinding Tag}" Stroke="{DynamicResource App.AccentForegroundBrush}" StrokeThickness="1" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Height="4" Tag="{DynamicResource App.BorderBrush}" Style="{StaticResource SettingsTrackRepeatButtonStyle}" Command="{x:Static Slider.IncreaseLarge}" /></Track.IncreaseRepeatButton>
      </Track>
      <TickBar x:Name="BottomTickBar" Grid.Row="2" Placement="Bottom" Fill="{DynamicResource App.SliderTickBrush}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" TickFrequency="{TemplateBinding TickFrequency}" Ticks="{TemplateBinding Ticks}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" Visibility="Collapsed" />
      <Border x:Name="FocusBorder" Grid.RowSpan="3" BorderBrush="{DynamicResource App.InputFocusBorderBrush}" BorderThickness="1" CornerRadius="3" IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="TickPlacement" Value="TopLeft"><Setter TargetName="TopTickBar" Property="Visibility" Value="Visible" /></Trigger>
      <Trigger Property="TickPlacement" Value="BottomRight"><Setter TargetName="BottomTickBar" Property="Visibility" Value="Visible" /></Trigger>
      <Trigger Property="TickPlacement" Value="Both"><Setter TargetName="TopTickBar" Property="Visibility" Value="Visible" /><Setter TargetName="BottomTickBar" Property="Visibility" Value="Visible" /></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="SettingsVerticalSliderTemplate" TargetType="{x:Type Slider}">
    <Grid MinWidth="24">
      <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /></Grid.ColumnDefinitions>
      <TickBar x:Name="LeftTickBar" Grid.Column="0" Placement="Left" Fill="{DynamicResource App.SliderTickBrush}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" TickFrequency="{TemplateBinding TickFrequency}" Ticks="{TemplateBinding Ticks}" IsDirectionReversed="True" Visibility="Collapsed" />
      <Track x:Name="PART_Track" Grid.Column="1" HorizontalAlignment="Center" Orientation="Vertical" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton><RepeatButton Width="4" Tag="{DynamicResource App.AccentBrush}" Style="{StaticResource SettingsTrackRepeatButtonStyle}" Command="{x:Static Slider.DecreaseLarge}" /></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb Width="16" Height="16" Tag="{DynamicResource App.AccentBrush}"><Thumb.Template><ControlTemplate TargetType="{x:Type Thumb}"><Ellipse Fill="{TemplateBinding Tag}" Stroke="{DynamicResource App.AccentForegroundBrush}" StrokeThickness="1" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Width="4" Tag="{DynamicResource App.BorderBrush}" Style="{StaticResource SettingsTrackRepeatButtonStyle}" Command="{x:Static Slider.IncreaseLarge}" /></Track.IncreaseRepeatButton>
      </Track>
      <TickBar x:Name="RightTickBar" Grid.Column="2" Placement="Right" Fill="{DynamicResource App.SliderTickBrush}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" TickFrequency="{TemplateBinding TickFrequency}" Ticks="{TemplateBinding Ticks}" IsDirectionReversed="True" Visibility="Collapsed" />
      <Border x:Name="FocusBorder" Grid.ColumnSpan="3" BorderBrush="{DynamicResource App.InputFocusBorderBrush}" BorderThickness="1" CornerRadius="3" IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="TickPlacement" Value="TopLeft"><Setter TargetName="LeftTickBar" Property="Visibility" Value="Visible" /></Trigger>
      <Trigger Property="TickPlacement" Value="BottomRight"><Setter TargetName="RightTickBar" Property="Visibility" Value="Visible" /></Trigger>
      <Trigger Property="TickPlacement" Value="Both"><Setter TargetName="LeftTickBar" Property="Visibility" Value="Visible" /><Setter TargetName="RightTickBar" Property="Visibility" Value="Visible" /></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="SettingsSliderStyle" TargetType="{x:Type Slider}"><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Template" Value="{StaticResource SettingsHorizontalSliderTemplate}" /><Style.Triggers><Trigger Property="Orientation" Value="Vertical"><Setter Property="Template" Value="{StaticResource SettingsVerticalSliderTemplate}" /></Trigger></Style.Triggers></Style>
  <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource SettingsSliderStyle}" />

  <ControlTemplate x:Key="SettingsVerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
    <Grid Background="{DynamicResource ScrollBar.TrackBackgroundBrush}"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource SettingsTrackRepeatButtonStyle}" /></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="24" Margin="2"><Thumb.Template><ControlTemplate TargetType="{x:Type Thumb}"><Border x:Name="ThumbChrome" Background="{DynamicResource ScrollBar.ThumbBackgroundBrush}" CornerRadius="4" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ScrollBar.ThumbHoverBackgroundBrush}" /></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ScrollBar.ThumbDraggingBackgroundBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource SettingsTrackRepeatButtonStyle}" /></Track.IncreaseRepeatButton></Track></Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="SettingsHorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
    <Grid Background="{DynamicResource ScrollBar.TrackBackgroundBrush}"><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource SettingsTrackRepeatButtonStyle}" /></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinWidth="24" Margin="2"><Thumb.Template><ControlTemplate TargetType="{x:Type Thumb}"><Border x:Name="ThumbChrome" Background="{DynamicResource ScrollBar.ThumbBackgroundBrush}" CornerRadius="4" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ScrollBar.ThumbHoverBackgroundBrush}" /></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ScrollBar.ThumbDraggingBackgroundBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource SettingsTrackRepeatButtonStyle}" /></Track.IncreaseRepeatButton></Track></Grid>
  </ControlTemplate>
  <Style x:Key="SettingsScrollBarStyle" TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="12" /><Setter Property="Template" Value="{StaticResource SettingsVerticalScrollBarTemplate}" />
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="12" /><Setter Property="Template" Value="{StaticResource SettingsHorizontalScrollBarTemplate}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SettingsScrollBarStyle}" />

  <ControlTemplate x:Key="SettingsScrollViewerTemplate" TargetType="{x:Type ScrollViewer}">
    <Grid Background="{TemplateBinding Background}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="0" Grid.Column="0" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" />
      <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="1" Orientation="Vertical" Style="{StaticResource SettingsScrollBarStyle}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" ViewportSize="{TemplateBinding ViewportHeight}" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
      <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Style="{StaticResource SettingsScrollBarStyle}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" ViewportSize="{TemplateBinding ViewportWidth}" Minimum="0" Maximum="{TemplateBinding ScrollableWidth}" Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
      <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource ScrollBar.TrackBackgroundBrush}" />
    </Grid>
  </ControlTemplate>
  <Style x:Key="SettingsScrollViewerStyle" TargetType="{x:Type ScrollViewer}" BasedOn="{x:Null}">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource SettingsScrollViewerTemplate}" />
  </Style>
  <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource SettingsScrollViewerStyle}" />

  <Style x:Key="SettingsComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}" BasedOn="{x:Null}">
    <Setter Property="Padding" Value="8,6" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
