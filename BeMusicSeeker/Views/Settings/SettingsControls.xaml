<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:settings="clr-namespace:BeMusicSeeker.Views.Settings">
  <!--
    The generic control system is owned by the application canonical
    dictionaries.  These aliases keep Settings' existing resource names and
    its local implicit adoption without leaking a type-key style to MainWindow.
  -->
  <Style x:Key="SettingsTrackRepeatButtonStyle"
         TargetType="{x:Type RepeatButton}"
         BasedOn="{StaticResource App.Canonical.TrackRepeatButtonStyle}" />

  <Style x:Key="SettingsButtonStyle"
         TargetType="{x:Type Button}"
         BasedOn="{StaticResource App.Canonical.ButtonStyle}" />
  <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SettingsButtonStyle}" />

  <Style x:Key="SettingsPrimaryButtonStyle"
         TargetType="{x:Type Button}"
         BasedOn="{StaticResource App.Canonical.PrimaryButtonStyle}" />
  <Style x:Key="SettingsQuietButtonStyle"
         TargetType="{x:Type Button}"
         BasedOn="{StaticResource App.Canonical.QuietButtonStyle}" />
  <Style x:Key="SettingsDangerButtonStyle"
         TargetType="{x:Type Button}"
         BasedOn="{StaticResource App.Canonical.DangerButtonStyle}" />
  <Style x:Key="SettingsIconButtonStyle"
         TargetType="{x:Type Button}"
         BasedOn="{StaticResource App.Canonical.IconButtonStyle}" />

  <Style x:Key="settingsFooterActionButtonStyle"
         TargetType="{x:Type Button}"
         BasedOn="{StaticResource SettingsButtonStyle}">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="settingsPrimaryActionButtonStyle"
         TargetType="{x:Type Button}"
         BasedOn="{StaticResource SettingsPrimaryButtonStyle}">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="settingsQuietActionButtonStyle"
         TargetType="{x:Type Button}"
         BasedOn="{StaticResource SettingsQuietButtonStyle}">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="SettingsTextBoxStyle"
         TargetType="{x:Type TextBox}"
         BasedOn="{StaticResource App.Canonical.TextBoxStyle}" />
  <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource SettingsTextBoxStyle}" />

  <Style x:Key="SettingsComboBoxStyle"
         TargetType="{x:Type ComboBox}"
         BasedOn="{StaticResource App.Canonical.ComboBoxStyle}" />
  <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource SettingsComboBoxStyle}" />

  <Style x:Key="SettingsCheckBoxStyle"
         TargetType="{x:Type CheckBox}"
         BasedOn="{StaticResource App.Canonical.CheckBoxStyle}" />
  <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource SettingsCheckBoxStyle}" />
  <Style x:Key="styleWrappingSettingCheckBox"
         TargetType="{x:Type CheckBox}"
         BasedOn="{StaticResource {x:Type CheckBox}}" />

  <Style x:Key="SettingsRadioButtonStyle"
         TargetType="{x:Type RadioButton}"
         BasedOn="{StaticResource App.Canonical.RadioButtonStyle}" />
  <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource SettingsRadioButtonStyle}" />

  <Style x:Key="SettingsSliderStyle"
         TargetType="{x:Type Slider}"
         BasedOn="{StaticResource App.Canonical.SliderStyle}" />
  <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource SettingsSliderStyle}" />

  <Style x:Key="SettingsScrollBarStyle"
         TargetType="{x:Type ScrollBar}"
         BasedOn="{StaticResource App.Canonical.ScrollBarStyle}" />
  <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SettingsScrollBarStyle}" />

  <Style x:Key="SettingsScrollViewerStyle"
         TargetType="{x:Type ScrollViewer}"
         BasedOn="{StaticResource App.Canonical.ScrollViewerStyle}" />
  <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource SettingsScrollViewerStyle}" />

  <Style x:Key="SettingsComboBoxItemStyle"
         TargetType="{x:Type ComboBoxItem}"
         BasedOn="{StaticResource App.Canonical.ComboBoxItemStyle}" />
  <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource SettingsComboBoxItemStyle}" />

  <Style x:Key="SettingsListBoxItemStyle"
         TargetType="{x:Type ListBoxItem}"
         BasedOn="{StaticResource App.Canonical.ListBoxItemStyle}" />
  <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource SettingsListBoxItemStyle}" />

  <Style x:Key="SettingsListBoxStyle"
         TargetType="{x:Type ListBox}"
         BasedOn="{StaticResource App.Canonical.ListBoxStyle}" />
  <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource SettingsListBoxStyle}" />

  <Style x:Key="SettingsExpanderHeaderToggleStyle"
         TargetType="{x:Type ToggleButton}"
         BasedOn="{StaticResource App.Canonical.ExpanderHeaderToggleStyle}" />
  <Style x:Key="SettingsExpanderStyle"
         TargetType="{x:Type Expander}"
         BasedOn="{StaticResource App.Canonical.ExpanderStyle}" />
  <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource SettingsExpanderStyle}" />

  <Style x:Key="settingsNavigationItemStyle"
         TargetType="{x:Type ListBoxItem}"
         BasedOn="{StaticResource App.Canonical.ListBoxItemStyle}">
    <Setter Property="Margin" Value="12,2" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Border x:Name="NavigationPill"
                  Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8"
                  SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="SelectionIndicator" Width="3" CornerRadius="2" />
              <ContentPresenter Grid.Column="2"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="NavigationPill" Property="Background" Value="{DynamicResource App.ControlHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="NavigationPill" Property="Background" Value="{DynamicResource App.ControlSelectedBrush}" />
              <Setter TargetName="SelectionIndicator" Property="Background" Value="{DynamicResource App.AccentBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="NavigationPill" Property="BorderBrush" Value="{DynamicResource App.InputFocusBorderBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
              <Setter TargetName="NavigationPill" Property="Opacity" Value="0.6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsGroupBoxStyle"
         TargetType="{x:Type GroupBox}"
         BasedOn="{StaticResource App.Canonical.GroupBoxStyle}" />
  <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource SettingsGroupBoxStyle}" />
  <Style x:Key="SettingsLabelStyle"
         TargetType="{x:Type Label}"
         BasedOn="{StaticResource App.Canonical.LabelStyle}" />
  <Style TargetType="{x:Type Label}" BasedOn="{StaticResource SettingsLabelStyle}" />

  <Style x:Key="settingsFieldGridStyle" TargetType="{x:Type Grid}">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="styleTextBlockActiveForeground" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type settings:SettingsSection}">
    <Setter Property="Margin" Value="0,0,0,28" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type settings:SettingsSection}">
          <StackPanel>
            <TextBlock FontSize="17"
                       FontWeight="SemiBold"
                       Text="{TemplateBinding Header}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{DynamicResource App.DisabledTextBrush}"
                       Text="{TemplateBinding Description}"
                       TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <Trigger Property="Text" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ContentPresenter Margin="0,14,0,0" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type settings:SettingsField}">
    <Setter Property="Margin" Value="0,0,0,14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type settings:SettingsField}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="{TemplateBinding Header}" TextWrapping="Wrap" />
            <TextBlock Margin="0,2,0,0"
                       Foreground="{DynamicResource App.DisabledTextBrush}"
                       Text="{TemplateBinding Description}"
                       TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <Trigger Property="Text" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ContentPresenter Margin="0,6,0,0" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{DynamicResource App.WarningTextBrush}"
                       Text="{TemplateBinding ValidationMessage}"
                       TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <Trigger Property="Text" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type settings:SettingsOptionRow}">
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type settings:SettingsOptionRow}">
          <Border Padding="{TemplateBinding Padding}"
                  Background="{DynamicResource App.SurfaceBrush}"
                  BorderBrush="{DynamicResource App.BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="{TemplateBinding Header}" TextWrapping="Wrap" />
              <TextBlock Margin="0,3,0,0"
                         Foreground="{DynamicResource App.DisabledTextBrush}"
                         Text="{TemplateBinding Description}"
                         TextWrapping="Wrap" />
              <ContentPresenter Margin="0,8,0,0" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type settings:SettingsPathPicker}">
    <Setter Property="Margin" Value="0,0,0,14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type settings:SettingsPathPicker}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="{TemplateBinding Label}" TextWrapping="Wrap" />
            <TextBlock Margin="0,2,0,0"
                       Foreground="{DynamicResource App.DisabledTextBrush}"
                       Text="{TemplateBinding Description}"
                       TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <Trigger Property="Text" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox MinWidth="180"
                       Text="{Binding Path, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                       IsReadOnly="{TemplateBinding IsPathReadOnly}"
                       AutomationProperties.Name="{TemplateBinding Label}" />
              <Button x:Name="PART_BrowseButton"
                      Grid.Column="1"
                      MinWidth="88"
                      Margin="8,0,0,0"
                      Content="{TemplateBinding BrowseText}"
                      AutomationProperties.Name="{TemplateBinding BrowseText}" />
            </Grid>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type settings:SettingsListEditor}"
         BasedOn="{StaticResource {x:Type settings:SettingsField}}" />
  <Style TargetType="{x:Type settings:SettingsStatusBanner}">
    <Setter Property="Margin" Value="0,4,0,10" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type settings:SettingsStatusBanner}">
          <Border Padding="{TemplateBinding Padding}"
                  Background="{DynamicResource App.SurfaceBrush}"
                  BorderBrush="{DynamicResource App.BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <settings:SettingsStatusIcon FontWeight="Bold"
                                            Text="{TemplateBinding Icon}"
                                            VerticalAlignment="Top" />
              <ContentPresenter Grid.Column="1"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SettingsMultilineStringStatusBannerStyle"
         TargetType="{x:Type settings:SettingsStatusBanner}"
         BasedOn="{StaticResource {x:Type settings:SettingsStatusBanner}}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SettingsTokenChipStyle" TargetType="{x:Type Border}">
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Background" Value="{DynamicResource App.SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
</ResourceDictionary>
