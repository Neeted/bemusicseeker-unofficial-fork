<?xml version="1.0" encoding="utf-8"?>
<views:ThemedWindow x:Class="BeMusicSeeker.Views.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels"
 xmlns:views="clr-namespace:BeMusicSeeker.Views"
 xmlns:settings="clr-namespace:BeMusicSeeker.Views.Settings"
 x:Name="settingsWindow"
 Width="820"
 Height="760"
 MinWidth="820"
 MinHeight="600"
 ResizeMode="CanResize"
 ShowInTaskbar="False"
 WindowStartupLocation="CenterOwner"
 Title="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_window_title, Mode=OneWay}"
 KeyDown="SettingsWindowKeyDown">
  <views:ThemedWindow.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SettingsControls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </views:ThemedWindow.Resources>
  <Grid x:Name="settingDialogRootGrid" Button.Click="settingsSectionButtonClick" LostFocus="settingsInputLostFocus" PreviewKeyDown="settingsInputPreviewKeyDown" PreviewKeyUp="settingsInputPreviewKeyUp" PreviewMouseUp="settingsInputMouseLeftButtonUp">
    <Grid x:Name="settingDialogOperationGrid" TextElement.Foreground="{DynamicResource App.TextBrush}">
      <settings:SettingsTabControl x:Name="settingsNavigation"
                                   Style="{StaticResource SettingsTabControlStyle}"
                                   SelectedIndex="0"
                                   AutomationProperties.AutomationId="SettingsCategoryNavigation"
                                   SelectionChanged="settingsNavigationSelectionChanged">
        <TabItem x:Name="navigationGeneral" settings:SettingsNavigationMark.Status="{Binding DeficiencyCategoryMarks[General], Mode=OneWay}" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.General, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.General, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryGeneral" />
        <TabItem x:Name="navigationAppearance" settings:SettingsNavigationMark.Status="{Binding DeficiencyCategoryMarks[Appearance], Mode=OneWay}" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Appearance, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryAppearance" />
        <TabItem x:Name="navigationPlayback" settings:SettingsNavigationMark.Status="{Binding DeficiencyCategoryMarks[Playback], Mode=OneWay}" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playback, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playback, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryPlayback" />
        <TabItem x:Name="navigationAudio" settings:SettingsNavigationMark.Status="{Binding DeficiencyCategoryMarks[Audio], Mode=OneWay}" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Audio, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Audio, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryAudio" />
        <TabItem x:Name="navigationRecording" settings:SettingsNavigationMark.Status="{Binding DeficiencyCategoryMarks[Recording], Mode=OneWay}" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Recording, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Recording, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryRecording" />
        <TabItem x:Name="navigationPlaylist" settings:SettingsNavigationMark.Status="{Binding DeficiencyCategoryMarks[Playlist], Mode=OneWay}" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryPlaylist" />
        <TabItem x:Name="navigationInstall" settings:SettingsNavigationMark.Status="{Binding DeficiencyCategoryMarks[Install], Mode=OneWay}" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Install, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Install, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryInstall" />
        <TabItem x:Name="navigationBackup" settings:SettingsNavigationMark.Status="{Binding DeficiencyCategoryMarks[Backup], Mode=OneWay}" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Backup, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Backup, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryBackup" />
        <TabItem x:Name="navigationAdvanced" settings:SettingsNavigationMark.Status="{Binding DeficiencyCategoryMarks[Advanced], Mode=OneWay}" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Advanced_settings, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Advanced_settings, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryAdvanced" />
        <TabItem x:Name="navigationRightClick" settings:SettingsNavigationMark.Status="{Binding DeficiencyCategoryMarks[RightClick], Mode=OneWay}" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.RightClick_actions, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.RightClick_actions, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryRightClick" />
        <TabItem x:Name="navigationAbout" settings:SettingsNavigationMark.Status="{Binding DeficiencyCategoryMarks[About], Mode=OneWay}" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.About_this_app, Mode=OneWay}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.About_this_app, Mode=OneWay}" AutomationProperties.AutomationId="SettingsCategoryAbout" />
        <settings:SettingsTabControl.Footer>
          <StackPanel>
            <!-- 不備の一覧が空でない間だけ、本文と下部操作の間に案内を出す。行が多い場合は案内の内側で縦スクロールし、本文と下部操作を押し出さない。 -->
            <settings:SettingsStatusBanner x:Name="settingsDeficiencyGuidance"
                                           Margin="16,16,16,0"
                                           Icon="!"
                                           Status="Error"
                                           HorizontalContentAlignment="Stretch"
                                           AutomationProperties.AutomationId="SettingsDeficiencyGuidance"
                                           AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_deficiency_guidance_title, Mode=OneWay}"
                                           Visibility="{Binding HasDeficiencies, Converter={StaticResource BooleanToVisibilityConverter}}">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_deficiency_guidance_title, Mode=OneWay}" />
                <ScrollViewer x:Name="settingsDeficiencyGuidanceScrollViewer" Margin="0,4,0,0" MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                  <ItemsControl x:Name="settingsDeficiencyGuidanceItems" ItemsSource="{Binding Deficiencies, Mode=OneWay}" AutomationProperties.AutomationId="SettingsDeficiencyGuidanceItems" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource SettingsQuietButtonStyle}" Margin="0,4,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                AutomationProperties.AutomationId="SettingsDeficiencyGuidanceItem" AutomationProperties.Name="{Binding DisplayText, Mode=OneWay}"
                                Click="deficiencyGuidanceItemClick">
                          <TextBlock TextWrapping="Wrap" Text="{Binding DisplayText, Mode=OneWay}" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </settings:SettingsStatusBanner>
            <Grid Margin="{StaticResource App.Layout.BodyPadding}">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel Margin="0,0,0,8" Visibility="{Binding IsStartGuidanceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock x:Name="settingsStartGuidanceText" TextWrapping="Wrap" AutomationProperties.AutomationId="SettingsStartGuidance">
                  <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                      <Setter Property="Text" Value="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_start_ready, Mode=OneWay}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDeficiencies}" Value="True">
                          <Setter Property="Text" Value="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_start_requires_settings, Mode=OneWay}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            <StackPanel x:Name="settingsFooter" Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
              <Button x:Name="buttonOK" Style="{StaticResource SettingsPrimaryButtonStyle}" MinWidth="112" Margin="0,0,8,0" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Settings_start_environment, Mode=OneWay}" IsEnabled="{Binding CanStartEnvironment}" AutomationProperties.AutomationId="SettingsStartEnvironment" Visibility="{Binding IsStartGuidanceVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Click="buttonOKClick" />
              <Button x:Name="buttonCancel" Style="{StaticResource SettingsQuietButtonStyle}" MinWidth="88" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Close, Mode=OneWay}" AutomationProperties.AutomationId="SettingsClose" IsEnabled="{Binding IsEditCancellationEnabled}" Click="buttonCancelClick" />
            </StackPanel>
            </Grid>
          </StackPanel>
        </settings:SettingsTabControl.Footer>
      </settings:SettingsTabControl>
    </Grid>

  </Grid>
</views:ThemedWindow>
