<?xml version="1.0" encoding="utf-8"?>
<v:ThemedWindow x:Class="BeMusicSeeker.Views.PlaylistImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="clr-namespace:BeMusicSeeker.Views" xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels" xmlns:settings="clr-namespace:BeMusicSeeker.Views.Settings"
    Width="920" Height="680" MinWidth="760" MinHeight="500" ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
    Title="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_import_title}" KeyDown="DialogKeyDown">
  <v:ThemedWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/BeMusicSeeker;component/Themes/CanonicalDialogStyles.xaml" />
        <ResourceDictionary Source="/BeMusicSeeker;component/Views/Settings/SettingsControls.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
      <Style x:Key="StatusLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Foreground" Value="{DynamicResource App.SubtleTextBrush}" />
        <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
      </Style>
      <Style x:Key="CandidateNameStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
        <Setter Property="ToolTip" Value="{Binding DisplayName}" />
      </Style>
      <HierarchicalDataTemplate x:Key="CandidateTemplate" ItemsSource="{Binding Children}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <v:PlaylistImportSelectionCheckBox x:Name="candidateCheck" Style="{StaticResource App.Canonical.CheckBoxStyle}"
              Padding="0" Margin="0,0,6,0" IsChecked="{Binding SelectionState, Mode=OneWay}" IsEnabled="{Binding CanToggleSelection}"
              AutomationProperties.Name="{Binding DisplayName}" />
          <TextBlock x:Name="candidateName" Grid.Column="1" Text="{Binding DisplayName}" Style="{StaticResource CandidateNameStyle}" />
          <TextBlock x:Name="candidateStatus" Grid.Column="2" Text="{Binding Status}" Style="{StaticResource StatusLabelStyle}" />
        </Grid>
      </HierarchicalDataTemplate>
      <Style x:Key="ImportTreeItemStyle" TargetType="{x:Type TreeViewItem}">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource VisibleWhenTrue}}" />
        <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter.Value></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TreeViewItem}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border x:Name="CandidateRowChrome" BorderThickness="1" BorderBrush="Transparent" Background="Transparent"
                    Padding="4,2" PreviewMouseLeftButtonDown="CandidateRowMouseDown">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ToggleButton x:Name="ExpansionToggle" Focusable="False" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        Foreground="{DynamicResource App.TextBrush}" Visibility="{Binding IsGroup, Converter={StaticResource VisibleWhenTrue}}">
                      <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                          <Grid Background="Transparent">
                            <Path x:Name="CollapsedGlyph" Width="6" Height="10" Data="M 0 0 L 6 5 L 0 10 Z" Fill="{TemplateBinding Foreground}" />
                            <Path x:Name="ExpandedGlyph" Width="10" Height="6" Data="M 0 0 L 5 6 L 10 0 Z" Fill="{TemplateBinding Foreground}" Visibility="Collapsed" />
                          </Grid>
                          <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="CollapsedGlyph" Property="Visibility" Value="Collapsed" /><Setter TargetName="ExpandedGlyph" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate>
                      </ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="20,0,0,0" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" /></Trigger>
                <Trigger SourceName="CandidateRowChrome" Property="IsMouseOver" Value="True"><Setter TargetName="CandidateRowChrome" Property="Background" Value="{DynamicResource App.ControlHoverBrush}" /></Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="CandidateRowChrome" Property="Background" Value="{DynamicResource App.ControlSelectedBrush}" /></DataTrigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CandidateRowChrome" Property="BorderBrush" Value="{DynamicResource App.InputFocusBorderBrush}" /></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource ImportTreeItemStyle}" />
      <Style x:Key="ImportTreeStyle" TargetType="TreeView">
        <Setter Property="Background" Value="{DynamicResource App.ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ImportTreeItemStyle}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="False" />
        <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter.Value></Setter>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeView">
          <Border x:Name="TreeChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
            <ScrollViewer Style="{StaticResource App.Canonical.ScrollViewerStyle}" CanContentScroll="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
              <ItemsPresenter />
            </ScrollViewer>
          </Border>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style x:Key="CompactRemoveStyle" TargetType="Button" BasedOn="{StaticResource App.Canonical.DialogQuietActionStyle}">
        <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="4,2" />
      </Style>
    </ResourceDictionary>
  </v:ThemedWindow.Resources>
  <Border Style="{StaticResource App.Canonical.NativeWindowContentStyle}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
      <ListBox x:Name="importNavigation" Grid.ColumnSpan="3" SelectedIndex="0" Style="{StaticResource App.Canonical.TopNavigationStyle}" Margin="0,0,0,12">
        <ListBoxItem Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_import_external}" />
        <ListBoxItem Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_import_builtin}" />
        <ListBoxItem Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_import_url_file}" />
      </ListBox>
      <ContentControl Grid.Row="1" Padding="0" Style="{StaticResource App.Canonical.TopNavigationContentStyle}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid x:Name="externalSearch" Margin="0,0,0,8">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=importNavigation}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="searchLabel" Grid.ColumnSpan="2" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_import_search}" Margin="0,0,0,4" />
              <TextBox x:Name="searchInput" Grid.Row="1" Style="{StaticResource App.Canonical.TextBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                  AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_import_search}" />
              <v:PlaylistImportSelectionCheckBox x:Name="selectAllMatchingCheck" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource App.Canonical.CheckBoxStyle}"
                  IsChecked="{Binding ExternalSelectionState, Mode=OneWay}" IsEnabled="{Binding CanToggleExternalSelection}"
                  Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_import_select_matching}" />
            </Grid>
          <StackPanel x:Name="candidateFilters" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=importNavigation}" Value="2"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <CheckBox x:Name="hideUrlsCheck" Style="{StaticResource App.Canonical.CheckBoxStyle}" IsChecked="{Binding HideRegisteredUrls}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_import_hide_urls}" Margin="0,0,12,0" />
            <CheckBox x:Name="hideNamesCheck" Style="{StaticResource App.Canonical.CheckBoxStyle}" IsChecked="{Binding HideSameNames}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_import_hide_names}" />
          </StackPanel>
          <Grid x:Name="externalPage" Grid.Row="2">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=importNavigation}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock x:Name="catalogStatus" Text="{Binding CatalogStatus}" TextWrapping="Wrap">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,8" /><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <TreeView x:Name="externalCandidates" Grid.Row="1" Style="{StaticResource ImportTreeStyle}" ItemsSource="{Binding ExternalGroups}" ItemTemplate="{StaticResource CandidateTemplate}" />
          </Grid>
          <Grid x:Name="builtInPage" Grid.Row="2">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=importNavigation}" Value="1"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
            <TreeView x:Name="builtInCandidates" Style="{StaticResource ImportTreeStyle}" ItemsSource="{Binding BuiltInGroups}" ItemTemplate="{StaticResource CandidateTemplate}" />
          </Grid>
          <Grid x:Name="uriPage" Grid.Row="2">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=importNavigation}" Value="2"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <settings:SettingsSection Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_import_url_file}" Description="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_import_input_description}" />
            <TextBox x:Name="textBoxURIInput" Grid.Row="1" Style="{StaticResource App.Canonical.TextBoxStyle}" Text="{Binding UriInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            <WrapPanel Grid.Row="2" Margin="0,10,0,0">
              <Button x:Name="openLocalFileButton" AutomationProperties.AutomationId="PlaylistImportOpenFile" Style="{StaticResource App.Canonical.DialogQuietActionStyle}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Open_PlaylistHeader}" Click="OpenLocalFile" Margin="0,0,8,0" />
              <Button x:Name="addUriButton" AutomationProperties.AutomationId="PlaylistImportAddUri" Style="{StaticResource App.Canonical.DialogActionStyle}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_import_add}" Click="AddUri" />
            </WrapPanel>
          </Grid>
        </Grid>
      </ContentControl>
      <Grid Grid.Row="1" Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_import_selected}" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ListBox x:Name="selectedCandidates" Grid.Row="1" Style="{StaticResource App.Canonical.ListBoxStyle}" ItemsSource="{Binding SelectedItems}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate><DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock x:Name="selectedName" Text="{Binding DisplayName}" Style="{StaticResource CandidateNameStyle}" />
              <TextBlock x:Name="selectedStatus" Grid.Column="1" Text="{Binding Status}" Style="{StaticResource StatusLabelStyle}" />
              <Button x:Name="removeCandidate" Grid.Column="2" Style="{StaticResource CompactRemoveStyle}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_import_remove}" Click="RemoveSelected" Margin="6,0,0,0" />
            </Grid>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="selectionCounts" Text="{Binding CountsText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button x:Name="clearSelectedButton" AutomationProperties.AutomationId="PlaylistImportClear" Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Right" Style="{StaticResource App.Canonical.DialogQuietActionStyle}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_import_clear}" Click="ClearSelected" />
        </Grid>
      </Grid>
      <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
        <ScrollViewer x:Name="operationMessageHost" MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Margin" Value="0,0,0,8" /><Style.Triggers><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
          <TextBlock x:Name="operationMessage" Text="{Binding Message}" TextWrapping="Wrap" />
        </ScrollViewer>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button x:Name="startImportButton" AutomationProperties.AutomationId="PlaylistImportStart" Style="{StaticResource App.Canonical.DialogPrimaryActionStyle}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Playlist_import_start}" Click="StartImport" Margin="0,0,8,0" />
          <Button x:Name="cancelImportButton" AutomationProperties.AutomationId="PlaylistImportCancel" Style="{StaticResource App.Canonical.DialogQuietActionStyle}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Cancel}" Click="CancelImport" IsCancel="True" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</v:ThemedWindow>
