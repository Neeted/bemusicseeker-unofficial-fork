<?xml version="1.0" encoding="utf-8"?>
<views:ThemedWindow x:Class="BeMusicSeeker.Views.PlaylistLampViewerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels"
 xmlns:views="clr-namespace:BeMusicSeeker.Views"
 x:Name="lampViewerWindow"
 Width="1290"
 Height="820"
 MinWidth="820"
 MinHeight="560"
 ResizeMode="CanResize"
 ShowInTaskbar="False"
 WindowStartupLocation="CenterOwner"
 Title="{Binding WindowTitle, Mode=OneWay}">
  <views:ThemedWindow.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="lampBoolVisibility" />
      <views:PlaylistLampSegmentPercentageLabelConverter x:Key="lampSegmentPercentageLabelConverter" />
      <views:PlaylistLampContrastForegroundConverter x:Key="lampContrastForegroundConverter" />

      <!-- The palette is intentionally local to the viewer. DynamicResource lookups let the
           surrounding theme replace these brushes without rebuilding the projection. -->
      <SolidColorBrush x:Key="PlaylistLamp.Clear.MAX" Color="#f3e8ff" />
      <SolidColorBrush x:Key="PlaylistLamp.Clear.PERFECT" Color="#d0fae5" />
      <SolidColorBrush x:Key="PlaylistLamp.Clear.FC" Color="#53eafd" />
      <SolidColorBrush x:Key="PlaylistLamp.Clear.EXHARD" Color="#ffd230" />
      <SolidColorBrush x:Key="PlaylistLamp.Clear.HARD" Color="#ffa2a2" />
      <SolidColorBrush x:Key="PlaylistLamp.Clear.NORMAL" Color="#51a2ff" />
      <SolidColorBrush x:Key="PlaylistLamp.Clear.EASY" Color="#7bf1a8" />
      <SolidColorBrush x:Key="PlaylistLamp.Clear.ASSIST" Color="#ad46ff" />
      <SolidColorBrush x:Key="PlaylistLamp.Clear.FAILED" Color="#99a1af" />
      <SolidColorBrush x:Key="PlaylistLamp.Clear.NP" Color="#f3f4f6" />
      <SolidColorBrush x:Key="PlaylistLamp.Rank.AAA" Color="#F4D35E" />
      <SolidColorBrush x:Key="PlaylistLamp.Rank.AA" Color="#C9D2DF" />
      <SolidColorBrush x:Key="PlaylistLamp.Rank.A" Color="#CF8D52" />
      <SolidColorBrush x:Key="PlaylistLamp.Rank.B" Color="#7FDFFF" />
      <SolidColorBrush x:Key="PlaylistLamp.Rank.C" Color="#5FC4FF" />
      <SolidColorBrush x:Key="PlaylistLamp.Rank.D" Color="#3FA9FF" />
      <SolidColorBrush x:Key="PlaylistLamp.Rank.E" Color="#2388F2" />
      <SolidColorBrush x:Key="PlaylistLamp.Rank.F" Color="#005CFF" />
      <SolidColorBrush x:Key="PlaylistLamp.Rank.NP" Color="#f3f4f6" />

      <Style x:Key="lampCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,6,8" />
      </Style>
      <Style x:Key="lampBarButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="{DynamicResource App.SurfaceBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Clear.MAX"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Clear.MAX}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Clear.PERFECT"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Clear.PERFECT}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Clear.FC"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Clear.FC}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Clear.EXHARD"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Clear.EXHARD}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Clear.HARD"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Clear.HARD}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Clear.NORMAL"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Clear.NORMAL}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Clear.EASY"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Clear.EASY}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Clear.ASSIST"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Clear.ASSIST}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Clear.FAILED"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Clear.FAILED}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Clear.NP"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Clear.NP}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Rank.AAA"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Rank.AAA}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Rank.AA"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Rank.AA}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Rank.A"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Rank.A}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Rank.B"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Rank.B}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Rank.C"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Rank.C}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Rank.D"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Rank.D}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Rank.E"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Rank.E}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Rank.F"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Rank.F}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Rank.NP"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Rank.NP}" /></DataTrigger>
          <DataTrigger Binding="{Binding IsSelected}" Value="True">
            <Setter Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontWeight" Value="Bold" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="lampWeightedSegmentContainerStyle" TargetType="{x:Type ContentPresenter}">
        <Setter Property="views:PlaylistLampWeightedStackPanel.Weight" Value="{Binding Count}" />
      </Style>
      <Style x:Key="lampLegendStyle" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Margin" Value="0,0,3,3" />
        <Setter Property="Background" Value="{DynamicResource App.SurfaceBrush}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Clear.MAX"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Clear.MAX}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Clear.PERFECT"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Clear.PERFECT}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Clear.FC"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Clear.FC}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Clear.EXHARD"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Clear.EXHARD}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Clear.HARD"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Clear.HARD}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Clear.NORMAL"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Clear.NORMAL}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Clear.EASY"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Clear.EASY}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Clear.ASSIST"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Clear.ASSIST}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Clear.FAILED"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Clear.FAILED}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Clear.NP"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Clear.NP}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Rank.AAA"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Rank.AAA}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Rank.AA"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Rank.AA}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Rank.A"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Rank.A}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Rank.B"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Rank.B}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Rank.C"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Rank.C}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Rank.D"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Rank.D}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Rank.E"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Rank.E}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Rank.F"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Rank.F}" /></DataTrigger>
          <DataTrigger Binding="{Binding PaletteKey}" Value="Rank.NP"><Setter Property="Background" Value="{DynamicResource PlaylistLamp.Rank.NP}" /></DataTrigger>
        </Style.Triggers>
      </Style>
      <DataTemplate x:Key="lampStatCardTemplate">
        <Border Style="{StaticResource lampCardStyle}"
                Width="{Binding CardWidth}"
                AutomationProperties.AutomationId="PlaylistLampViewerStatCard">
          <StackPanel>
            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource App.SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Value}" Foreground="{DynamicResource App.TextBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="lampLegendTemplate">
        <Border Style="{StaticResource lampLegendStyle}"
                AutomationProperties.Name="{Binding DetailText}"
                AutomationProperties.AutomationId="PlaylistLampViewerLegend">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Label}"
                       Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=Background, Converter={StaticResource lampContrastForegroundConverter}}"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding Count}"
                       Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=Background, Converter={StaticResource lampContrastForegroundConverter}}"
                       Margin="7,0,0,0" />
          </StackPanel>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="lampBarTemplate">
        <Button Style="{StaticResource lampBarButtonStyle}"
                Foreground="{Binding RelativeSource={RelativeSource Self}, Path=Background, Converter={StaticResource lampContrastForegroundConverter}}"
                Visibility="{Binding BarVisibility}"
                IsEnabled="{Binding IsInvokable}"
                ToolTip="{Binding DetailText}"
                AutomationProperties.Name="{Binding AutomationName}"
                AutomationProperties.ItemStatus="{Binding SelectionStatus}"
                AutomationProperties.AutomationId="PlaylistLampViewerSegment"
                Click="SegmentClick">
          <Button.Content>
            <MultiBinding Converter="{StaticResource lampSegmentPercentageLabelConverter}">
              <Binding />
              <Binding RelativeSource="{RelativeSource Self}" Path="ActualWidth" />
              <Binding RelativeSource="{RelativeSource Self}" />
            </MultiBinding>
          </Button.Content>
        </Button>
      </DataTemplate>
      <DataTemplate x:Key="lampFolderTemplate">
        <Border BorderThickness="0"
                Padding="0,3"
                AutomationProperties.AutomationId="PlaylistLampViewerFolderRow">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,8,0" AutomationProperties.AutomationId="PlaylistLampViewerClearFolderHalf">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ElementName=lampViewerWindow, Path=FolderLabelColumnWidth}" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="{Binding ElementName=lampViewerWindow, Path=FolderCountColumnWidth}" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding FolderName}" Foreground="{DynamicResource App.TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderName}" VerticalAlignment="Center" AutomationProperties.AutomationId="PlaylistLampViewerFolderLabel" />
              <Border Grid.Column="2" Height="22" BorderThickness="0" Background="{DynamicResource App.SurfaceBrush}" AutomationProperties.AutomationId="PlaylistLampViewerClearFolderBarHost">
                <ItemsControl ItemsSource="{Binding PositiveClearSegments}" ItemTemplate="{StaticResource lampBarTemplate}" ItemContainerStyle="{StaticResource lampWeightedSegmentContainerStyle}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><views:PlaylistLampWeightedStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
              </Border>
              <TextBlock Grid.Column="4" Width="{Binding ElementName=lampViewerWindow, Path=FolderCountColumnWidth}" Text="{Binding CountText}" Foreground="{DynamicResource App.SubtleTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" AutomationProperties.AutomationId="PlaylistLampViewerFolderCount" />
            </Grid>
            <Grid Grid.Column="1" Margin="8,0,0,0" AutomationProperties.AutomationId="PlaylistLampViewerRankFolderHalf">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ElementName=lampViewerWindow, Path=FolderLabelColumnWidth}" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="{Binding ElementName=lampViewerWindow, Path=FolderCountColumnWidth}" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding FolderName}" Foreground="{DynamicResource App.TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderName}" VerticalAlignment="Center" AutomationProperties.AutomationId="PlaylistLampViewerFolderLabel" />
              <Border Grid.Column="2" Height="22" BorderThickness="0" Background="{DynamicResource App.SurfaceBrush}" AutomationProperties.AutomationId="PlaylistLampViewerRankFolderBarHost">
                <ItemsControl ItemsSource="{Binding PositiveRankSegments}" ItemTemplate="{StaticResource lampBarTemplate}" ItemContainerStyle="{StaticResource lampWeightedSegmentContainerStyle}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><views:PlaylistLampWeightedStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
              </Border>
              <TextBlock Grid.Column="4" Width="{Binding ElementName=lampViewerWindow, Path=FolderCountColumnWidth}" Text="{Binding CountText}" Foreground="{DynamicResource App.SubtleTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" AutomationProperties.AutomationId="PlaylistLampViewerFolderCount" />
            </Grid>
          </Grid>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </views:ThemedWindow.Resources>
  <Border Style="{StaticResource App.Canonical.NativeWindowContentStyle}" Padding="0">
    <Grid TextElement.Foreground="{DynamicResource App.TextBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="{Binding PlaylistName}" FontSize="18" FontWeight="SemiBold" Margin="18,15,18,8" Foreground="{DynamicResource App.TextBrush}" />
      <ItemsControl Grid.Row="1" Margin="18,0,10,0" ItemsSource="{Binding StatisticsCards}" ItemTemplate="{StaticResource lampStatCardTemplate}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
      <Grid Grid.Row="2" Margin="18,4,18,15" Visibility="{Binding IsGraphVisible, Converter={StaticResource lampBoolVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0" AutomationProperties.AutomationId="PlaylistLampViewerClearHost">
            <TextBlock Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistLampViewer_clear_lamp, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding ClearSegments}" ItemTemplate="{StaticResource lampLegendTemplate}" Margin="0,4,0,0">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0" AutomationProperties.AutomationId="PlaylistLampViewerRankHost">
            <TextBlock Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.PlaylistLampViewer_rank_lamp, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding RankSegments}" ItemTemplate="{StaticResource lampLegendTemplate}" Margin="0,4,0,0">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,4,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Height="24" Margin="0,0,8,0" BorderThickness="0" Background="{DynamicResource App.SurfaceBrush}" AutomationProperties.AutomationId="PlaylistLampViewerClearGraphHost">
            <ItemsControl ItemsSource="{Binding PositiveClearSegments}" ItemTemplate="{StaticResource lampBarTemplate}" ItemContainerStyle="{StaticResource lampWeightedSegmentContainerStyle}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><views:PlaylistLampWeightedStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </Border>
          <Border Grid.Column="1" Height="24" Margin="8,0,0,0" BorderThickness="0" Background="{DynamicResource App.SurfaceBrush}" AutomationProperties.AutomationId="PlaylistLampViewerRankGraphHost">
            <ItemsControl ItemsSource="{Binding PositiveRankSegments}" ItemTemplate="{StaticResource lampBarTemplate}" ItemContainerStyle="{StaticResource lampWeightedSegmentContainerStyle}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><views:PlaylistLampWeightedStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </Border>
        </Grid>
        <Border Grid.Row="2" BorderThickness="0" Margin="0" />
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" AutomationProperties.AutomationId="PlaylistLampViewerFolderScrollViewer">
          <ItemsControl ItemsSource="{Binding FolderRows}" ItemTemplate="{StaticResource lampFolderTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel IsItemsHost="True" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Template>
              <ControlTemplate TargetType="{x:Type ItemsControl}">
                <ItemsPresenter />
              </ControlTemplate>
            </ItemsControl.Template>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</views:ThemedWindow>
