<?xml version="1.0" encoding="utf-8"?>
<views:ThemedWindow x:Class="BeMusicSeeker.Views.Lr2PlayHistorySchemaUninstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BeMusicSeeker.Views"
        xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels"
        Title="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_play_history_schema_uninstall_title, Mode=OneWay}"
        Width="560"
        Height="320"
        MinWidth="500"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource App.DialogBackgroundBrush}"
        Foreground="{DynamicResource App.TextBrush}">
  <Border Style="{StaticResource App.Canonical.DialogContentStyle}">
    <DockPanel Margin="12" LastChildFill="True">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button MinWidth="72" Height="24" Margin="0,0,8,0" Style="{StaticResource App.Canonical.DialogDangerActionStyle}" Content="OK" IsDefault="True" Click="SaveAndClose" />
      <Button MinWidth="72" Height="24" Style="{StaticResource App.Canonical.DialogQuietActionStyle}" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Cancel, Mode=OneWay}" IsCancel="True" />
    </StackPanel>
    <StackPanel>
      <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_play_history_schema_uninstall_desc, Mode=OneWay}" />
      <GroupBox Style="{StaticResource App.Canonical.GroupBoxStyle}" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_play_history_schema_uninstall_score_db, Mode=OneWay}" Margin="0,0,0,10">
        <TextBox Style="{StaticResource App.Canonical.TextBoxStyle}" Margin="8" Text="{Binding ScoreDbPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
      </GroupBox>
      <GroupBox Style="{StaticResource App.Canonical.GroupBoxStyle}" Header="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_play_history_schema_uninstall_mode, Mode=OneWay}">
        <StackPanel Margin="8">
          <RadioButton Style="{StaticResource App.Canonical.RadioButtonStyle}" x:Name="radioButtonTriggersOnly" Margin="0,0,0,6" IsChecked="True" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_play_history_schema_uninstall_triggers_only, Mode=OneWay}" />
          <RadioButton Style="{StaticResource App.Canonical.RadioButtonStyle}" x:Name="radioButtonTablesAndTriggers" Margin="0,0,0,8" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_play_history_schema_uninstall_tables_and_triggers, Mode=OneWay}" />
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource App.WarningTextBrush}" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.Lr2_play_history_schema_uninstall_warning, Mode=OneWay}" />
        </StackPanel>
      </GroupBox>
    </StackPanel>
    </DockPanel>
  </Border>
</views:ThemedWindow>
