<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/BeMusicSeeker;component/Themes/CanonicalControls.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <!-- Dialog roles are explicit so each native window or overlay can opt in without
       changing the visual system of an unadopted MainWindow control. -->
  <Style x:Key="App.Canonical.DialogOverlayStyle" TargetType="{x:Type Rectangle}" BasedOn="{x:Null}">
    <Setter Property="Fill" Value="{DynamicResource App.DialogOverlayBrush}" />
    <Setter Property="Opacity" Value="0.5" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>

  <Style x:Key="App.Canonical.DialogSurfaceStyle" TargetType="{x:Type Border}" BasedOn="{x:Null}">
    <Setter Property="Background" Value="{DynamicResource App.DialogBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.DialogBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style x:Key="App.Canonical.DialogContentStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource App.Canonical.DialogSurfaceStyle}">
    <Setter Property="Padding" Value="14" />
  </Style>

  <!-- Native windows receive their outer client surface from ThemedWindow. This role only
       preserves content spacing and deliberately has no fill, border, or corner radius so
       a native window cannot grow a second rounded dialog surface inside its client area. -->
  <Style x:Key="App.Canonical.NativeWindowContentStyle" TargetType="{x:Type Border}" BasedOn="{x:Null}">
    <Setter Property="Padding" Value="14" />
    <Setter Property="BorderBrush" Value="{x:Null}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style x:Key="App.Canonical.DialogActionStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource App.Canonical.ButtonStyle}" />
  <Style x:Key="App.Canonical.DialogPrimaryActionStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource App.Canonical.PrimaryButtonStyle}" />
  <Style x:Key="App.Canonical.DialogQuietActionStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource App.Canonical.QuietButtonStyle}" />
  <Style x:Key="App.Canonical.DialogDangerActionStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource App.Canonical.DangerButtonStyle}" />
</ResourceDictionary>
