<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib"
                    xmlns:v="clr-namespace:BeMusicSeeker.Views"
                    xmlns:vm="clr-namespace:BeMusicSeeker.ViewModels">
  <!--
    操作部品は明示キーで採用します。ToolTipだけは生成元を問わずテーマへ追随するため、
    アプリ全体に型スタイルを適用します。
  -->
  <Style TargetType="{x:Type ToolTip}">
    <Setter Property="Background" Value="{DynamicResource App.PopupBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
  </Style>

  <FontFamily x:Key="App.IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <s:String x:Key="App.IconGlyph.Filter">&#xE71C;</s:String>
  <s:String x:Key="App.IconGlyph.Search">&#xE721;</s:String>
  <s:String x:Key="App.IconGlyph.Error">&#xE783;</s:String>
  <s:String x:Key="App.IconGlyph.Package">&#xE7B8;</s:String>
  <s:String x:Key="App.IconGlyph.Warning">&#xE7BA;</s:String>
  <s:String x:Key="App.IconGlyph.Clear">&#xE894;</s:String>
  <s:String x:Key="App.IconGlyph.Sync">&#xE895;</s:String>
  <s:String x:Key="App.IconGlyph.Download">&#xE896;</s:String>
  <s:String x:Key="App.IconGlyph.Help">&#xE897;</s:String>
  <s:String x:Key="App.IconGlyph.Folder">&#xE8B7;</s:String>
  <s:String x:Key="App.IconGlyph.SearchResult">&#xE8BC;</s:String>
  <s:String x:Key="App.IconGlyph.UnsyncFolder">&#xE8F6;</s:String>
  <s:String x:Key="App.IconGlyph.List">&#xE8FD;</s:String>
  <s:String x:Key="App.IconGlyph.Scan">&#xE8FE;</s:String>
  <s:String x:Key="App.IconGlyph.Info">&#xEA1F;</s:String>

  <Style x:Key="App.Canonical.FontIconStyle" TargetType="{x:Type v:AppFontIcon}" BasedOn="{x:Null}">
    <Setter Property="FontFamily" Value="{StaticResource App.IconFontFamily}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="AutomationProperties.Name" Value="" />
  </Style>

  <ControlTemplate x:Key="App.Canonical.ButtonTemplate" TargetType="{x:Type Button}">
    <Grid SnapsToDevicePixels="True">
      <Border x:Name="ButtonChrome"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}">
        <ContentPresenter Margin="{TemplateBinding Padding}"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          RecognizesAccessKey="True" />
      </Border>
      <Border x:Name="FocusBorder"
              BorderBrush="{TemplateBinding Tag}"
              BorderThickness="2"
              IsHitTestVisible="False"
              Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.55" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Thickness x:Key="App.Layout.BodyPadding">16</Thickness>
  <Thickness x:Key="App.Layout.SectionMargin">0,0,0,24</Thickness>
  <Thickness x:Key="App.Layout.FieldMargin">0,0,0,16</Thickness>

  <ControlTemplate x:Key="App.Canonical.TextBoxTemplate" TargetType="{x:Type TextBox}">
    <Grid>
      <Border x:Name="TextBoxChrome"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}">
        <ScrollViewer x:Name="PART_ContentHost"
                      Style="{DynamicResource App.Canonical.ScrollViewerStyle}" />
      </Border>
      <Border x:Name="FocusBorder"
              BorderBrush="{DynamicResource App.InputFocusBorderBrush}"
              BorderThickness="2"
              IsHitTestVisible="False"
              Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="TextBoxChrome" Property="Opacity" Value="0.55" />
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
      </Trigger>
      <Trigger Property="IsReadOnly" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.ComboBoxItemTemplate" TargetType="{x:Type ComboBoxItem}">
    <Border x:Name="ItemChrome"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="Center" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource App.ControlHoverBrush}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource App.ControlSelectedBrush}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource App.InputFocusBorderBrush}" />
        <Setter TargetName="ItemChrome" Property="BorderThickness" Value="1" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
        <Setter Property="Opacity" Value="0.55" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.ComboBoxTemplate" TargetType="{x:Type ComboBox}">
    <Grid>
      <Border x:Name="ComboChrome"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="30" />
          </Grid.ColumnDefinitions>
          <ToggleButton x:Name="DropDownToggle"
                        Grid.ColumnSpan="2"
                        Focusable="False"
                        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Border Background="Transparent">
                  <ContentPresenter />
                </Border>
              </ControlTemplate>
            </ToggleButton.Template>
            <Path Width="8"
                  Height="5"
                  HorizontalAlignment="Right"
                  Margin="0,0,11,0"
                  Fill="{DynamicResource App.TextBrush}"
                  Data="M 0 0 L 4 4 L 8 0 Z" />
          </ToggleButton>
          <ContentPresenter x:Name="SelectionContent"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                            IsHitTestVisible="False" />
          <TextBox x:Name="PART_EditableTextBox"
                   Grid.Column="0"
                   Margin="{TemplateBinding Padding}"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                   IsReadOnly="{TemplateBinding IsReadOnly}"
                   Visibility="Collapsed" />
        </Grid>
      </Border>
      <Border x:Name="FocusBorder"
              BorderBrush="{DynamicResource App.InputFocusBorderBrush}"
              BorderThickness="2"
              IsHitTestVisible="False"
              Visibility="Collapsed" />
      <Popup x:Name="PART_Popup"
             AllowsTransparency="True"
             Focusable="False"
             IsOpen="{TemplateBinding IsDropDownOpen}"
             Placement="Bottom"
             PopupAnimation="Fade"
             Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
        <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                Background="{DynamicResource App.PopupBackgroundBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="1">
          <ScrollViewer Style="{DynamicResource App.Canonical.ScrollViewerStyle}"
                        CanContentScroll="True">
            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
          </ScrollViewer>
        </Border>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ComboChrome" Property="Background" Value="{DynamicResource App.ControlHoverBrush}" />
      </Trigger>
      <Trigger Property="IsEditable" Value="True">
        <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
        <Setter TargetName="SelectionContent" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ComboChrome" Property="Opacity" Value="0.55" />
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.CheckBoxTemplate" TargetType="{x:Type CheckBox}">
    <Grid Background="{x:Null}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="CheckChrome"
              Width="18"
              Height="18"
              VerticalAlignment="Center"
              Background="{DynamicResource App.ControlBackgroundBrush}"
              BorderBrush="{DynamicResource App.BorderBrush}"
              BorderThickness="1">
        <Grid>
          <Path x:Name="CheckGlyph"
                Width="10" Height="8" Data="M 0 4 L 3.5 7.5 L 10 0"
                Stroke="{DynamicResource App.AccentForegroundBrush}" StrokeThickness="2" Visibility="Collapsed" />
          <Path x:Name="IndeterminateGlyph"
                Width="10" Height="2" Data="M 0 1 L 10 1"
                Stroke="{DynamicResource App.AccentForegroundBrush}" StrokeThickness="2" Visibility="Collapsed" />
        </Grid>
      </Border>
      <ContentPresenter Grid.Column="1"
                        Margin="{TemplateBinding Padding}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        RecognizesAccessKey="True" />
      <Border x:Name="FocusBorder"
              Grid.ColumnSpan="2"
              BorderBrush="{DynamicResource App.InputFocusBorderBrush}"
              BorderThickness="1"
              IsHitTestVisible="False"
              Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource App.AccentBrush}" />
        <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" />
        <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsChecked" Value="{x:Null}">
        <Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource App.AccentBrush}" />
        <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" />
        <Setter TargetName="IndeterminateGlyph" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource App.InputFocusBorderBrush}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.RadioButtonTemplate" TargetType="{x:Type RadioButton}">
    <Grid Background="{x:Null}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="RadioChrome"
              Width="18"
              Height="18"
              VerticalAlignment="Center"
              Background="{DynamicResource App.ControlBackgroundBrush}"
              BorderBrush="{DynamicResource App.BorderBrush}"
              BorderThickness="1"
              CornerRadius="9">
        <Ellipse x:Name="RadioGlyph"
                 Width="8"
                 Height="8"
                 Fill="{DynamicResource App.AccentBrush}"
                 Visibility="Collapsed" />
      </Border>
      <ContentPresenter Grid.Column="1"
                        Margin="{TemplateBinding Padding}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        RecognizesAccessKey="True" />
      <Border x:Name="FocusBorder"
              Grid.ColumnSpan="2"
              BorderBrush="{DynamicResource App.InputFocusBorderBrush}"
              BorderThickness="1"
              IsHitTestVisible="False"
              Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="RadioChrome" Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" />
        <Setter TargetName="RadioGlyph" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="RadioChrome" Property="BorderBrush" Value="{DynamicResource App.InputFocusBorderBrush}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- 寸法だけを上書きし、通常版と省スペース版の描画・入力経路を共有する。 -->
  <s:Double x:Key="App.Canonical.SliderThumbSize">16</s:Double>
  <s:Double x:Key="App.Canonical.SliderRailThickness">4</s:Double>
  <DataTemplate x:Key="App.Canonical.SliderThumbOverlay"><Grid /></DataTemplate>
  <ControlTemplate x:Key="App.Canonical.SliderThumbTemplate" TargetType="{x:Type Thumb}">
    <Grid Background="Transparent">
      <Ellipse x:Name="ThumbChrome" Fill="{TemplateBinding Foreground}" />
      <!-- シークの時刻等、用途固有の表示だけを差し込む。Trackは共通のまま保つ。 -->
      <ContentPresenter Content="{Binding RelativeSource={RelativeSource AncestorType={x:Type Slider}}}"
                        ContentTemplate="{DynamicResource App.Canonical.SliderThumbOverlay}"
                        IsHitTestVisible="False" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ThumbChrome" Property="Fill" Value="{DynamicResource App.AccentHoverBrush}" />
      </Trigger>
      <Trigger Property="IsDragging" Value="True">
        <Setter TargetName="ThumbChrome" Property="Fill" Value="{DynamicResource App.AccentPressedBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ThumbChrome" Property="Fill" Value="{DynamicResource App.DisabledTextBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.HorizontalSliderTemplate" TargetType="{x:Type Slider}">
    <Grid MinHeight="{DynamicResource App.Canonical.SliderThumbSize}" Background="Transparent">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TickBar x:Name="TopTickBar" Height="4"
               Grid.Row="0"
               Placement="Top"
               Fill="{DynamicResource App.SliderTickBrush}"
               Minimum="{TemplateBinding Minimum}"
               Maximum="{TemplateBinding Maximum}"
               TickFrequency="{TemplateBinding TickFrequency}"
               Ticks="{TemplateBinding Ticks}"
               IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
               Visibility="Collapsed" />
      <Track x:Name="PART_Track" Grid.Row="1" VerticalAlignment="Center">
        <Track.DecreaseRepeatButton>
          <RepeatButton Height="{DynamicResource App.Canonical.SliderThumbSize}"
                        Style="{DynamicResource App.Canonical.ProgressRepeatButtonStyle}"
                        Command="{x:Static Slider.DecreaseLarge}" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Width="{DynamicResource App.Canonical.SliderThumbSize}"
                 Height="{DynamicResource App.Canonical.SliderThumbSize}"
                 Focusable="False"
                 Foreground="{DynamicResource App.AccentBrush}"
                 Template="{StaticResource App.Canonical.SliderThumbTemplate}" />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Height="{DynamicResource App.Canonical.SliderThumbSize}"
                        Tag="{DynamicResource App.BorderBrush}"
                        Style="{DynamicResource App.Canonical.SliderRailButtonStyle}"
                        Command="{x:Static Slider.IncreaseLarge}" />
        </Track.IncreaseRepeatButton>
      </Track>
      <TickBar x:Name="BottomTickBar" Height="4"
               Grid.Row="2"
               Placement="Bottom"
               Fill="{DynamicResource App.SliderTickBrush}"
               Minimum="{TemplateBinding Minimum}"
               Maximum="{TemplateBinding Maximum}"
               TickFrequency="{TemplateBinding TickFrequency}"
               Ticks="{TemplateBinding Ticks}"
               IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
               Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="TickPlacement" Value="TopLeft">
        <Setter TargetName="TopTickBar" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="TickPlacement" Value="BottomRight">
        <Setter TargetName="BottomTickBar" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="TickPlacement" Value="Both">
        <Setter TargetName="TopTickBar" Property="Visibility" Value="Visible" />
        <Setter TargetName="BottomTickBar" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.55" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.VerticalSliderTemplate" TargetType="{x:Type Slider}">
    <Grid MinWidth="{DynamicResource App.Canonical.SliderThumbSize}" Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TickBar x:Name="LeftTickBar" Width="4"
               Grid.Column="0"
               Placement="Left"
               Fill="{DynamicResource App.SliderTickBrush}"
               Minimum="{TemplateBinding Minimum}"
               Maximum="{TemplateBinding Maximum}"
               TickFrequency="{TemplateBinding TickFrequency}"
               Ticks="{TemplateBinding Ticks}"
               IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
               Visibility="Collapsed" />
      <Track x:Name="PART_Track"
             Grid.Column="1"
             HorizontalAlignment="Center"
             Orientation="Vertical"
             IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
        <Track.DecreaseRepeatButton>
          <RepeatButton Width="{DynamicResource App.Canonical.SliderThumbSize}"
                        Style="{DynamicResource App.Canonical.ProgressRepeatButtonStyle}"
                        Command="{x:Static Slider.DecreaseLarge}" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Width="{DynamicResource App.Canonical.SliderThumbSize}"
                 Height="{DynamicResource App.Canonical.SliderThumbSize}"
                 Focusable="False"
                 Foreground="{DynamicResource App.AccentBrush}"
                 Template="{StaticResource App.Canonical.SliderThumbTemplate}" />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Width="{DynamicResource App.Canonical.SliderThumbSize}"
                        Tag="{DynamicResource App.BorderBrush}"
                        Style="{DynamicResource App.Canonical.SliderRailButtonStyle}"
                        Command="{x:Static Slider.IncreaseLarge}" />
        </Track.IncreaseRepeatButton>
      </Track>
      <TickBar x:Name="RightTickBar" Width="4"
               Grid.Column="2"
               Placement="Right"
               Fill="{DynamicResource App.SliderTickBrush}"
               Minimum="{TemplateBinding Minimum}"
               Maximum="{TemplateBinding Maximum}"
               TickFrequency="{TemplateBinding TickFrequency}"
               Ticks="{TemplateBinding Ticks}"
               IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
               Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="TickPlacement" Value="TopLeft">
        <Setter TargetName="LeftTickBar" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="TickPlacement" Value="BottomRight">
        <Setter TargetName="RightTickBar" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="TickPlacement" Value="Both">
        <Setter TargetName="LeftTickBar" Property="Visibility" Value="Visible" />
        <Setter TargetName="RightTickBar" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.55" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- 透明な16 DIPの入力領域は固定し、hover/dragでは内部の描画だけを広げる。 -->
  <ControlTemplate x:Key="App.Canonical.VerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
    <Grid x:Name="ScrollBarRoot" Background="Transparent" SnapsToDevicePixels="True" ClipToBounds="True">
      <Border x:Name="TrackChrome" Background="{DynamicResource ScrollBar.TrackBackgroundBrush}" Opacity="0" IsHitTestVisible="False" />
      <!-- 最短28 DIPのTrackを極小時だけ縮め、WPF標準Trackの最小サム計算とドラッグを保つ。 -->
      <Viewbox Stretch="Fill" StretchDirection="DownOnly">
        <Track x:Name="PART_Track" Width="16" MinHeight="28"
               Height="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}" Orientation="Vertical" IsDirectionReversed="True" ClipToBounds="True">
          <Track.Resources>
            <s:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">56</s:Double>
          </Track.Resources>
          <Track.DecreaseRepeatButton>
            <RepeatButton x:Name="PageUpButton" Tag="{x:Static Brushes.Transparent}"
                          Command="{x:Static ScrollBar.PageUpCommand}"
                          Style="{DynamicResource App.Canonical.TrackRepeatButtonStyle}" />
          </Track.DecreaseRepeatButton>
          <Track.Thumb>
            <Thumb>
              <Thumb.Template>
                <ControlTemplate TargetType="{x:Type Thumb}">
                  <Grid Background="Transparent" ClipToBounds="True">
                    <Border x:Name="ThumbChrome" Width="3" HorizontalAlignment="Right"
                            Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}"
                            Background="{DynamicResource ScrollBar.ThumbBackgroundBrush}" />
                  </Grid>
                  <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}" Value="True">
                      <Setter TargetName="ThumbChrome" Property="Width" Value="8" />
                      <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ScrollBar.ThumbHoverBackgroundBrush}" />
                    </DataTrigger>
                    <Trigger Property="IsDragging" Value="True">
                      <Setter TargetName="ThumbChrome" Property="Width" Value="8" />
                      <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ScrollBar.ThumbDraggingBackgroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ScrollBar.TrackBackgroundBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Track.Thumb>
          <Track.IncreaseRepeatButton>
            <RepeatButton x:Name="PageDownButton" Tag="{x:Static Brushes.Transparent}"
                          Command="{x:Static ScrollBar.PageDownCommand}"
                          Style="{DynamicResource App.Canonical.TrackRepeatButtonStyle}" />
          </Track.IncreaseRepeatButton>
        </Track>
      </Viewbox>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="TrackChrome" Property="Opacity" Value="0.35" />
      </Trigger>
      <Trigger SourceName="PART_Track" Property="IsMouseCaptureWithin" Value="True">
        <Setter TargetName="TrackChrome" Property="Opacity" Value="0.35" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.HorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
    <Grid x:Name="ScrollBarRoot" Background="Transparent" SnapsToDevicePixels="True" ClipToBounds="True">
      <Border x:Name="TrackChrome" Background="{DynamicResource ScrollBar.TrackBackgroundBrush}" Opacity="0" IsHitTestVisible="False" />
      <!-- 最短28 DIPのTrackを極小時だけ縮め、WPF標準Trackの最小サム計算とドラッグを保つ。 -->
      <Viewbox Stretch="Fill" StretchDirection="DownOnly">
        <Track x:Name="PART_Track" Height="16" MinWidth="28"
               Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Orientation="Horizontal" ClipToBounds="True">
          <Track.Resources>
            <s:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">56</s:Double>
          </Track.Resources>
          <Track.DecreaseRepeatButton>
            <RepeatButton x:Name="PageLeftButton" Tag="{x:Static Brushes.Transparent}"
                          Command="{x:Static ScrollBar.PageLeftCommand}"
                          Style="{DynamicResource App.Canonical.TrackRepeatButtonStyle}" />
          </Track.DecreaseRepeatButton>
          <Track.Thumb>
            <Thumb>
              <Thumb.Template>
                <ControlTemplate TargetType="{x:Type Thumb}">
                  <Grid Background="Transparent" ClipToBounds="True">
                    <Border x:Name="ThumbChrome" Height="3" VerticalAlignment="Bottom"
                            Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}"
                            Background="{DynamicResource ScrollBar.ThumbBackgroundBrush}" />
                  </Grid>
                  <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}" Value="True">
                      <Setter TargetName="ThumbChrome" Property="Height" Value="8" />
                      <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ScrollBar.ThumbHoverBackgroundBrush}" />
                    </DataTrigger>
                    <Trigger Property="IsDragging" Value="True">
                      <Setter TargetName="ThumbChrome" Property="Height" Value="8" />
                      <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ScrollBar.ThumbDraggingBackgroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ScrollBar.TrackBackgroundBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Track.Thumb>
          <Track.IncreaseRepeatButton>
            <RepeatButton x:Name="PageRightButton" Tag="{x:Static Brushes.Transparent}"
                          Command="{x:Static ScrollBar.PageRightCommand}"
                          Style="{DynamicResource App.Canonical.TrackRepeatButtonStyle}" />
          </Track.IncreaseRepeatButton>
        </Track>
      </Viewbox>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="TrackChrome" Property="Opacity" Value="0.35" />
      </Trigger>
      <Trigger SourceName="PART_Track" Property="IsMouseCaptureWithin" Value="True">
        <Setter TargetName="TrackChrome" Property="Opacity" Value="0.35" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.ScrollViewerTemplate" TargetType="{x:Type ScrollViewer}">
    <Grid Background="{TemplateBinding Background}" ClipToBounds="True">
      <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                              Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              CanContentScroll="{TemplateBinding CanContentScroll}" />
      <v:OverlayScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right"
                 Orientation="Vertical" Panel.ZIndex="1"
                 Style="{DynamicResource App.Canonical.ScrollBarStyle}"
                 Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                 ViewportSize="{TemplateBinding ViewportHeight}" Minimum="0"
                 Maximum="{TemplateBinding ScrollableHeight}"
                 Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
      <v:OverlayScrollBar x:Name="PART_HorizontalScrollBar" VerticalAlignment="Bottom"
                 Orientation="Horizontal" Panel.ZIndex="1"
                 Style="{DynamicResource App.Canonical.ScrollBarStyle}"
                 Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                 ViewportSize="{TemplateBinding ViewportWidth}" Minimum="0"
                 Maximum="{TemplateBinding ScrollableWidth}"
                 Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
    </Grid>
    <ControlTemplate.Triggers>
      <!-- 交点は縦バーへ割り当て、透明部分でも入力領域が重ならないようにする。 -->
      <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Visible">
        <Setter TargetName="PART_HorizontalScrollBar" Property="Margin" Value="0,0,16,0" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.ListBoxItemTemplate" TargetType="{x:Type ListBoxItem}">
    <Border x:Name="ItemChrome"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="Center" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource App.ControlHoverBrush}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource App.ControlSelectedBrush}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource App.InputFocusBorderBrush}" />
        <Setter TargetName="ItemChrome" Property="BorderThickness" Value="1" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
        <Setter Property="Opacity" Value="0.55" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.ListBoxTemplate" TargetType="{x:Type ListBox}">
    <Border x:Name="ListChrome"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}">
      <ScrollViewer Style="{DynamicResource App.Canonical.ScrollViewerStyle}"
                    Padding="{TemplateBinding Padding}"
                    Focusable="False">
        <ItemsPresenter />
      </ScrollViewer>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="ListChrome" Property="BorderBrush" Value="{DynamicResource App.InputFocusBorderBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
        <Setter TargetName="ListChrome" Property="Opacity" Value="0.55" />
      </Trigger>
      <Trigger Property="IsGrouping" Value="True">
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!--
    The property dialog uses this keyed ListBox role for its top navigation.
    Keeping the role on ListBox preserves WPF's Selection/SelectionItem peers
    and the standard selector keyboard route without adding a presentation
    code-behind seam.
  -->
  <ControlTemplate x:Key="App.Canonical.TopNavigationItemTemplate" TargetType="{x:Type ListBoxItem}">
    <Grid SnapsToDevicePixels="True">
      <Border x:Name="NavigationItemChrome"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="Center"
                          RecognizesAccessKey="True"
                          ContentSource="Content" />
      </Border>
      <Border x:Name="SelectionIndicator"
              Height="2"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Bottom"
              Background="{DynamicResource App.AccentBrush}"
              Visibility="Collapsed"
              IsHitTestVisible="False" />
      <Border x:Name="FocusBorder"
              BorderBrush="{DynamicResource App.InputFocusBorderBrush}"
              BorderThickness="1"
              Visibility="Collapsed"
              IsHitTestVisible="False" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="NavigationItemChrome" Property="Background" Value="{DynamicResource App.ControlHoverBrush}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="NavigationItemChrome" Property="Background" Value="{DynamicResource App.ControlSelectedBrush}" />
        <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
        <Setter TargetName="NavigationItemChrome" Property="Opacity" Value="0.55" />
        <Setter TargetName="SelectionIndicator" Property="Opacity" Value="0.55" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.TopNavigationTemplate" TargetType="{x:Type ListBox}">
    <Border x:Name="TopNavigationChrome"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
      <ScrollViewer x:Name="PART_ScrollViewer"
                    Padding="{TemplateBinding Padding}"
                    Focusable="False"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Disabled"
                    CanContentScroll="True">
        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
      </ScrollViewer>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="TopNavigationChrome" Property="BorderBrush" Value="{DynamicResource App.InputFocusBorderBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
        <Setter TargetName="TopNavigationChrome" Property="Opacity" Value="0.55" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.TopNavigationContentTemplate" TargetType="{x:Type ContentControl}">
    <ContentPresenter Margin="{TemplateBinding Padding}"
                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                      ContentSource="Content" />
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.ExpanderHeaderToggleTemplate" TargetType="{x:Type ToggleButton}">
    <Border x:Name="HeaderChrome"
            Padding="8,6"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Path x:Name="CollapsedGlyph"
              Width="6"
              Height="10"
              Fill="{TemplateBinding Foreground}"
              Data="M 0 0 L 6 5 L 0 10 Z" />
        <Path x:Name="ExpandedGlyph"
              Width="10"
              Height="6"
              Fill="{TemplateBinding Foreground}"
              Data="M 0 0 L 5 6 L 10 0 Z"
              Visibility="Collapsed" />
        <ContentPresenter Grid.Column="1"
                          Margin="6,0,0,0"
                          VerticalAlignment="Center" />
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource App.ControlHoverBrush}" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="CollapsedGlyph" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="ExpandedGlyph" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="HeaderChrome" Property="BorderBrush" Value="{DynamicResource App.InputFocusBorderBrush}" />
        <Setter TargetName="HeaderChrome" Property="BorderThickness" Value="1" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
        <Setter Property="Opacity" Value="0.55" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.ExpanderTemplate" TargetType="{x:Type Expander}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ToggleButton x:Name="HeaderSite"
                    Grid.Row="0"
                    Style="{DynamicResource App.Canonical.ExpanderHeaderToggleStyle}"
                    Content="{TemplateBinding Header}"
                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                    ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                    IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
      <Border x:Name="ExpandSite"
              Grid.Row="1"
              Margin="16,4,0,0"
              Visibility="Collapsed">
        <ContentPresenter ContentSource="Content" />
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsExpanded" Value="True">
        <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
        <Setter TargetName="ExpandSite" Property="Opacity" Value="0.55" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.SliderRailButtonTemplate" TargetType="{x:Type RepeatButton}">
    <Grid Background="Transparent">
      <Border x:Name="RailChrome" Background="{TemplateBinding Tag}"
              Height="{DynamicResource App.Canonical.SliderRailThickness}" VerticalAlignment="Center" />
    </Grid>
    <ControlTemplate.Triggers>
      <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}" Value="Vertical">
        <Setter TargetName="RailChrome" Property="Height" Value="Auto" />
        <Setter TargetName="RailChrome" Property="Width" Value="{DynamicResource App.Canonical.SliderRailThickness}" />
        <Setter TargetName="RailChrome" Property="VerticalAlignment" Value="Stretch" />
        <Setter TargetName="RailChrome" Property="HorizontalAlignment" Value="Center" />
      </DataTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.TrackRepeatButtonTemplate" TargetType="{x:Type RepeatButton}">
    <Border Background="{TemplateBinding Tag}" />
  </ControlTemplate>

  <Style x:Key="App.Canonical.TrackRepeatButtonStyle" TargetType="{x:Type RepeatButton}" BasedOn="{x:Null}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.TrackRepeatButtonTemplate}" />
  </Style>

  <Style x:Key="App.Canonical.SliderRailButtonStyle" TargetType="{x:Type RepeatButton}" BasedOn="{StaticResource App.Canonical.TrackRepeatButtonStyle}">
    <Setter Property="Template" Value="{StaticResource App.Canonical.SliderRailButtonTemplate}" />
  </Style>

  <Style x:Key="App.Canonical.ProgressRepeatButtonStyle" TargetType="{x:Type RepeatButton}" BasedOn="{StaticResource App.Canonical.SliderRailButtonStyle}">
    <Setter Property="Tag" Value="{DynamicResource App.AccentBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}" Value="True">
        <Setter Property="Tag" Value="{DynamicResource App.AccentHoverBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Thumb.IsDragging, ElementName=PART_Track}" Value="True">
        <Setter Property="Tag" Value="{DynamicResource App.AccentPressedBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="App.Canonical.ButtonStyle" TargetType="{x:Type Button}" BasedOn="{x:Null}">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource App.ControlBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="Tag" Value="{DynamicResource App.InputFocusBorderBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.ButtonTemplate}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.ControlHoverBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.ControlPressedBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="App.Canonical.CompactButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource App.Canonical.ButtonStyle}">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="8,2" />
  </Style>

  <Style x:Key="App.Canonical.PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource App.Canonical.ButtonStyle}">
    <Setter Property="Background" Value="{DynamicResource App.AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource App.AccentForegroundBrush}" />
    <Setter Property="Tag" Value="{DynamicResource App.AccentFocusRingBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.AccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App.AccentForegroundBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.AccentPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.AccentPressedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App.AccentForegroundBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource App.AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App.AccentForegroundBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="App.Canonical.QuietButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource App.Canonical.ButtonStyle}">
    <Setter Property="Background" Value="{x:Null}" />
  </Style>

  <Style x:Key="App.Canonical.DangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource App.Canonical.ButtonStyle}">
    <Setter Property="Background" Value="{DynamicResource App.DangerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.DangerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource App.DangerForegroundBrush}" />
    <Setter Property="Tag" Value="{DynamicResource App.DangerForegroundBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.DangerHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.DangerHoverBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.DangerPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.DangerPressedBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="App.Canonical.IconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource App.Canonical.QuietButtonStyle}">
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style x:Key="App.Canonical.CalendarDayButtonStyle" TargetType="{x:Type CalendarDayButton}" BasedOn="{StaticResource App.Canonical.CompactButtonStyle}">
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Style.Triggers>
      <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{DynamicResource App.SubtleTextBrush}" /></Trigger>
      <Trigger Property="IsToday" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" /></Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App.AccentForegroundBrush}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource App.AccentHoverBrush}" />
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="IsPressed" Value="True" /></MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource App.AccentPressedBrush}" />
      </MultiTrigger>
      <Trigger Property="IsBlackedOut" Value="True"><Setter Property="Opacity" Value="0.4" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="App.Canonical.CalendarButtonStyle" TargetType="{x:Type CalendarButton}" BasedOn="{StaticResource App.Canonical.CompactButtonStyle}">
    <Setter Property="Margin" Value="1" />
    <Style.Triggers>
      <Trigger Property="HasSelectedDays" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" /></Trigger>
      <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{DynamicResource App.SubtleTextBrush}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="App.Canonical.CalendarItemStyle" TargetType="{x:Type CalendarItem}" BasedOn="{x:Null}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CalendarItem}">
          <ControlTemplate.Resources>
            <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
              <TextBlock Text="{Binding}" HorizontalAlignment="Center" Margin="2,4" Foreground="{DynamicResource App.SubtleTextBrush}" />
            </DataTemplate>
          </ControlTemplate.Resources>
          <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="6">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="PART_PreviousButton" Grid.Column="0" Style="{StaticResource App.Canonical.CompactButtonStyle}" Content="&#x2039;" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.DatePicker_previous_period}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.DatePicker_previous_period}" />
                <Button x:Name="PART_HeaderButton" Grid.Column="1" Style="{StaticResource App.Canonical.CompactButtonStyle}" Margin="4,0" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.DatePicker_change_period}" />
                <Button x:Name="PART_NextButton" Grid.Column="2" Style="{StaticResource App.Canonical.CompactButtonStyle}" Content="&#x203A;" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.DatePicker_next_period}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.DatePicker_next_period}" />
              </Grid>
              <Grid x:Name="PART_MonthView" Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              </Grid>
              <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              </Grid>
              <Border x:Name="PART_DisabledVisual" Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}" Value="Year">
              <Setter TargetName="PART_MonthView" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}" Value="Decade">
              <Setter TargetName="PART_MonthView" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="App.Canonical.CalendarStyle" TargetType="{x:Type Calendar}" BasedOn="{x:Null}">
    <Setter Property="Background" Value="{DynamicResource App.PopupBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CalendarItemStyle" Value="{StaticResource App.Canonical.CalendarItemStyle}" />
    <Setter Property="CalendarDayButtonStyle" Value="{StaticResource App.Canonical.CalendarDayButtonStyle}" />
    <Setter Property="CalendarButtonStyle" Value="{StaticResource App.Canonical.CalendarButtonStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Calendar}">
          <StackPanel x:Name="PART_Root">
            <CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="App.Canonical.DatePickerStyle" TargetType="{x:Type DatePicker}" BasedOn="{x:Null}">
    <Setter Property="v:DatePickerPresentation.Culture" Value="{Binding Source={x:Static vm:ResourceService.Current}, Path=DisplayCulture}" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="SelectedDateFormat" Value="Short" />
    <Setter Property="Background" Value="{DynamicResource App.ControlBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="CalendarStyle" Value="{StaticResource App.Canonical.CalendarStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type DatePicker}">
          <Grid x:Name="PART_Root">
            <Border x:Name="DateChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="26" /></Grid.ColumnDefinitions>
                <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" IsReadOnly="True" BorderThickness="0" Padding="6,2" Background="Transparent" Foreground="{TemplateBinding Foreground}" VerticalContentAlignment="Center" FocusVisualStyle="{x:Null}">
                  <DatePickerTextBox.Template>
                    <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                      <Grid>
                        <ScrollViewer x:Name="PART_ContentHost" Style="{DynamicResource App.Canonical.ScrollViewerStyle}" />
                        <!-- TextBoxViewの双方向キャレット用左右2 DIPに、案内文の実文字位置を合わせる。 -->
                        <TextBlock x:Name="DateHint" Margin="{TemplateBinding Padding}" Padding="2,0" Text="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.DatePicker_choose_date}" Foreground="{DynamicResource App.SubtleTextBrush}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}}" Value="{x:Null}">
                          <Setter TargetName="DateHint" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </DatePickerTextBox.Template>
                </DatePickerTextBox>
                <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource App.Canonical.CompactButtonStyle}" Padding="3" MinHeight="0" Content="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.DatePicker_open_calendar}" ToolTip="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.DatePicker_open_calendar}" AutomationProperties.Name="{Binding Source={x:Static vm:ResourceService.Current}, Path=Resources.DatePicker_open_calendar}">
                  <Button.ContentTemplate>
                    <DataTemplate><Path Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1" Data="M 1,3 L 13,3 13,13 1,13 Z M 1,6 L 13,6 M 4,1 L 4,4 M 10,1 L 10,4" /></DataTemplate>
                  </Button.ContentTemplate>
                </Button>
              </Grid>
            </Border>
            <Border x:Name="FocusBorder" BorderBrush="{DynamicResource App.InputFocusBorderBrush}" BorderThickness="2" IsHitTestVisible="False" Visibility="Collapsed" />
            <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Focusable="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="DateChrome" Property="Opacity" Value="0.55" /><Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

