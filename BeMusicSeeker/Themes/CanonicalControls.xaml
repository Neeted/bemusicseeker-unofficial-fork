<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    These resources are deliberately keyed.  Settings and dialogs opt into the
    design system explicitly; an application-level implicit style would also
    restyle MainWindow controls that have not been migrated yet.
  -->
  <ControlTemplate x:Key="App.Canonical.ButtonTemplate" TargetType="{x:Type Button}">
    <Grid SnapsToDevicePixels="True">
      <Border x:Name="ButtonChrome"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6">
        <ContentPresenter Margin="{TemplateBinding Padding}"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          RecognizesAccessKey="True" />
      </Border>
      <Border x:Name="FocusBorder"
              BorderBrush="{TemplateBinding Tag}"
              BorderThickness="2"
              CornerRadius="6"
              IsHitTestVisible="False"
              Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.55" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.TextBoxTemplate" TargetType="{x:Type TextBox}">
    <Grid>
      <Border x:Name="TextBoxChrome"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="4">
        <ScrollViewer x:Name="PART_ContentHost"
                      Margin="{TemplateBinding Padding}"
                      Style="{DynamicResource App.Canonical.ScrollViewerStyle}" />
      </Border>
      <Border x:Name="FocusBorder"
              BorderBrush="{DynamicResource App.InputFocusBorderBrush}"
              BorderThickness="2"
              CornerRadius="4"
              IsHitTestVisible="False"
              Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="TextBoxChrome" Property="Opacity" Value="0.55" />
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
      </Trigger>
      <Trigger Property="IsReadOnly" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.ComboBoxItemTemplate" TargetType="{x:Type ComboBoxItem}">
    <Border x:Name="ItemChrome"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            CornerRadius="4">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="Center" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource App.ControlHoverBrush}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource App.ControlSelectedBrush}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource App.InputFocusBorderBrush}" />
        <Setter TargetName="ItemChrome" Property="BorderThickness" Value="1" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
        <Setter Property="Opacity" Value="0.55" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.ComboBoxTemplate" TargetType="{x:Type ComboBox}">
    <Grid>
      <Border x:Name="ComboChrome"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="4">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="30" />
          </Grid.ColumnDefinitions>
          <ToggleButton x:Name="DropDownToggle"
                        Grid.ColumnSpan="2"
                        Focusable="False"
                        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template>
              <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Border Background="Transparent">
                  <ContentPresenter />
                </Border>
              </ControlTemplate>
            </ToggleButton.Template>
            <Path Width="8"
                  Height="5"
                  HorizontalAlignment="Right"
                  Margin="0,0,11,0"
                  Fill="{DynamicResource App.TextBrush}"
                  Data="M 0 0 L 4 4 L 8 0 Z" />
          </ToggleButton>
          <ContentPresenter x:Name="SelectionContent"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                            IsHitTestVisible="False" />
          <TextBox x:Name="PART_EditableTextBox"
                   Grid.Column="0"
                   Margin="{TemplateBinding Padding}"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                   IsReadOnly="{TemplateBinding IsReadOnly}"
                   Visibility="Collapsed" />
        </Grid>
      </Border>
      <Border x:Name="FocusBorder"
              BorderBrush="{DynamicResource App.InputFocusBorderBrush}"
              BorderThickness="2"
              CornerRadius="4"
              IsHitTestVisible="False"
              Visibility="Collapsed" />
      <Popup x:Name="PART_Popup"
             AllowsTransparency="True"
             Focusable="False"
             IsOpen="{TemplateBinding IsDropDownOpen}"
             Placement="Bottom"
             PopupAnimation="Fade"
             Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
        <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                Background="{DynamicResource App.PopupBackgroundBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
          <ScrollViewer Style="{DynamicResource App.Canonical.ScrollViewerStyle}"
                        CanContentScroll="True">
            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
          </ScrollViewer>
        </Border>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ComboChrome" Property="Background" Value="{DynamicResource App.ControlHoverBrush}" />
      </Trigger>
      <Trigger Property="IsEditable" Value="True">
        <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
        <Setter TargetName="SelectionContent" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ComboChrome" Property="Opacity" Value="0.55" />
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.CheckBoxTemplate" TargetType="{x:Type CheckBox}">
    <Grid Background="{x:Null}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="CheckChrome"
              Width="18"
              Height="18"
              VerticalAlignment="Center"
              Background="{DynamicResource App.ControlBackgroundBrush}"
              BorderBrush="{DynamicResource App.BorderBrush}"
              BorderThickness="1"
              CornerRadius="3">
        <Path x:Name="CheckGlyph"
              Width="10"
              Height="8"
              Data="M 0 4 L 3.5 7.5 L 10 0"
              Stroke="{DynamicResource App.AccentForegroundBrush}"
              StrokeThickness="2"
              Visibility="Collapsed" />
      </Border>
      <ContentPresenter Grid.Column="1"
                        Margin="{TemplateBinding Padding}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        RecognizesAccessKey="True" />
      <Border x:Name="FocusBorder"
              Grid.ColumnSpan="2"
              BorderBrush="{DynamicResource App.InputFocusBorderBrush}"
              BorderThickness="1"
              CornerRadius="3"
              IsHitTestVisible="False"
              Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource App.AccentBrush}" />
        <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" />
        <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource App.InputFocusBorderBrush}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.RadioButtonTemplate" TargetType="{x:Type RadioButton}">
    <Grid Background="{x:Null}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="RadioChrome"
              Width="18"
              Height="18"
              VerticalAlignment="Center"
              Background="{DynamicResource App.ControlBackgroundBrush}"
              BorderBrush="{DynamicResource App.BorderBrush}"
              BorderThickness="1"
              CornerRadius="9">
        <Ellipse x:Name="RadioGlyph"
                 Width="8"
                 Height="8"
                 Fill="{DynamicResource App.AccentBrush}"
                 Visibility="Collapsed" />
      </Border>
      <ContentPresenter Grid.Column="1"
                        Margin="{TemplateBinding Padding}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        RecognizesAccessKey="True" />
      <Border x:Name="FocusBorder"
              Grid.ColumnSpan="2"
              BorderBrush="{DynamicResource App.InputFocusBorderBrush}"
              BorderThickness="1"
              CornerRadius="3"
              IsHitTestVisible="False"
              Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="RadioChrome" Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" />
        <Setter TargetName="RadioGlyph" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="RadioChrome" Property="BorderBrush" Value="{DynamicResource App.InputFocusBorderBrush}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.HorizontalSliderTemplate" TargetType="{x:Type Slider}">
    <Grid MinHeight="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="4" />
        <RowDefinition Height="*" />
        <RowDefinition Height="4" />
      </Grid.RowDefinitions>
      <TickBar x:Name="TopTickBar"
               Grid.Row="0"
               Placement="Top"
               Fill="{DynamicResource App.SliderTickBrush}"
               Minimum="{TemplateBinding Minimum}"
               Maximum="{TemplateBinding Maximum}"
               TickFrequency="{TemplateBinding TickFrequency}"
               Ticks="{TemplateBinding Ticks}"
               IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
               Visibility="Collapsed" />
      <Track x:Name="PART_Track" Grid.Row="1" VerticalAlignment="Center">
        <Track.DecreaseRepeatButton>
          <RepeatButton Height="4"
                        Tag="{DynamicResource App.AccentBrush}"
                        Style="{DynamicResource App.Canonical.TrackRepeatButtonStyle}"
                        Command="{x:Static Slider.DecreaseLarge}" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Width="16" Height="16" Tag="{DynamicResource App.AccentBrush}">
            <Thumb.Template>
              <ControlTemplate TargetType="{x:Type Thumb}">
                <Ellipse Fill="{TemplateBinding Tag}"
                         Stroke="{DynamicResource App.AccentForegroundBrush}"
                         StrokeThickness="1" />
              </ControlTemplate>
            </Thumb.Template>
          </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Height="4"
                        Tag="{DynamicResource App.BorderBrush}"
                        Style="{DynamicResource App.Canonical.TrackRepeatButtonStyle}"
                        Command="{x:Static Slider.IncreaseLarge}" />
        </Track.IncreaseRepeatButton>
      </Track>
      <TickBar x:Name="BottomTickBar"
               Grid.Row="2"
               Placement="Bottom"
               Fill="{DynamicResource App.SliderTickBrush}"
               Minimum="{TemplateBinding Minimum}"
               Maximum="{TemplateBinding Maximum}"
               TickFrequency="{TemplateBinding TickFrequency}"
               Ticks="{TemplateBinding Ticks}"
               IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
               Visibility="Collapsed" />
      <Border x:Name="FocusBorder"
              Grid.RowSpan="3"
              BorderBrush="{DynamicResource App.InputFocusBorderBrush}"
              BorderThickness="1"
              CornerRadius="3"
              IsHitTestVisible="False"
              Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="TickPlacement" Value="TopLeft">
        <Setter TargetName="TopTickBar" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="TickPlacement" Value="BottomRight">
        <Setter TargetName="BottomTickBar" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="TickPlacement" Value="Both">
        <Setter TargetName="TopTickBar" Property="Visibility" Value="Visible" />
        <Setter TargetName="BottomTickBar" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.55" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.VerticalSliderTemplate" TargetType="{x:Type Slider}">
    <Grid MinWidth="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="4" />
      </Grid.ColumnDefinitions>
      <TickBar x:Name="LeftTickBar"
               Grid.Column="0"
               Placement="Left"
               Fill="{DynamicResource App.SliderTickBrush}"
               Minimum="{TemplateBinding Minimum}"
               Maximum="{TemplateBinding Maximum}"
               TickFrequency="{TemplateBinding TickFrequency}"
               Ticks="{TemplateBinding Ticks}"
               IsDirectionReversed="True"
               Visibility="Collapsed" />
      <Track x:Name="PART_Track"
             Grid.Column="1"
             HorizontalAlignment="Center"
             Orientation="Vertical"
             IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
          <RepeatButton Width="4"
                        Tag="{DynamicResource App.AccentBrush}"
                        Style="{DynamicResource App.Canonical.TrackRepeatButtonStyle}"
                        Command="{x:Static Slider.DecreaseLarge}" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Width="16" Height="16" Tag="{DynamicResource App.AccentBrush}">
            <Thumb.Template>
              <ControlTemplate TargetType="{x:Type Thumb}">
                <Ellipse Fill="{TemplateBinding Tag}"
                         Stroke="{DynamicResource App.AccentForegroundBrush}"
                         StrokeThickness="1" />
              </ControlTemplate>
            </Thumb.Template>
          </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Width="4"
                        Tag="{DynamicResource App.BorderBrush}"
                        Style="{DynamicResource App.Canonical.TrackRepeatButtonStyle}"
                        Command="{x:Static Slider.IncreaseLarge}" />
        </Track.IncreaseRepeatButton>
      </Track>
      <TickBar x:Name="RightTickBar"
               Grid.Column="2"
               Placement="Right"
               Fill="{DynamicResource App.SliderTickBrush}"
               Minimum="{TemplateBinding Minimum}"
               Maximum="{TemplateBinding Maximum}"
               TickFrequency="{TemplateBinding TickFrequency}"
               Ticks="{TemplateBinding Ticks}"
               IsDirectionReversed="True"
               Visibility="Collapsed" />
      <Border x:Name="FocusBorder"
              Grid.ColumnSpan="3"
              BorderBrush="{DynamicResource App.InputFocusBorderBrush}"
              BorderThickness="1"
              CornerRadius="3"
              IsHitTestVisible="False"
              Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="TickPlacement" Value="TopLeft">
        <Setter TargetName="LeftTickBar" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="TickPlacement" Value="BottomRight">
        <Setter TargetName="RightTickBar" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="TickPlacement" Value="Both">
        <Setter TargetName="LeftTickBar" Property="Visibility" Value="Visible" />
        <Setter TargetName="RightTickBar" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.55" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!--
    ScrollBar is the one shared scrolling primitive.  The MainWindow table,
    canonical controls, and compatibility aliases all resolve these templates
    so the visual route cannot drift while ScrollViewer keeps its existing
    PART_* and routed-command contract.
  -->
  <ControlTemplate x:Key="App.Canonical.VerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
    <Grid x:Name="ScrollBarRoot"
          Width="15"
          Background="{DynamicResource ScrollBar.TrackBackgroundBrush}"
          SnapsToDevicePixels="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <RepeatButton x:Name="LineUpButton"
                    Grid.Row="0"
                    Height="15"
                    Command="{x:Static ScrollBar.LineUpCommand}"
                    Style="{DynamicResource App.Canonical.ScrollBarButtonStyle}">
        <Path Width="8"
              Height="8"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Fill="{TemplateBinding Foreground}"
              Data="M0,6 L4,2 L8,6 Z" />
      </RepeatButton>
      <Track x:Name="PART_Track"
             Grid.Row="1"
             Orientation="Vertical"
             IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
          <RepeatButton x:Name="PageUpButton"
                        Tag="{DynamicResource ScrollBar.TrackBackgroundBrush}"
                        Command="{x:Static ScrollBar.PageUpCommand}"
                        Style="{DynamicResource App.Canonical.TrackRepeatButtonStyle}" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb MinHeight="24" Margin="2">
            <Thumb.Template>
              <ControlTemplate TargetType="{x:Type Thumb}">
                <Border x:Name="ThumbChrome"
                        Background="{DynamicResource ScrollBar.ThumbBackgroundBrush}"
                        CornerRadius="4" />
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ScrollBar.ThumbHoverBackgroundBrush}" />
                  </Trigger>
                  <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ScrollBar.ThumbDraggingBackgroundBrush}" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ScrollBar.TrackBackgroundBrush}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Thumb.Template>
          </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton x:Name="PageDownButton"
                        Tag="{DynamicResource ScrollBar.TrackBackgroundBrush}"
                        Command="{x:Static ScrollBar.PageDownCommand}"
                        Style="{DynamicResource App.Canonical.TrackRepeatButtonStyle}" />
        </Track.IncreaseRepeatButton>
      </Track>
      <RepeatButton x:Name="LineDownButton"
                    Grid.Row="2"
                    Height="15"
                    Command="{x:Static ScrollBar.LineDownCommand}"
                    Style="{DynamicResource App.Canonical.ScrollBarButtonStyle}">
        <Path Width="8"
              Height="8"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Fill="{TemplateBinding Foreground}"
              Data="M0,2 L4,6 L8,2 Z" />
      </RepeatButton>
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.HorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
    <Grid x:Name="ScrollBarRoot"
          Height="15"
          Background="{DynamicResource ScrollBar.TrackBackgroundBrush}"
          SnapsToDevicePixels="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <RepeatButton x:Name="LineLeftButton"
                    Grid.Column="0"
                    Width="15"
                    Command="{x:Static ScrollBar.LineLeftCommand}"
                    Style="{DynamicResource App.Canonical.ScrollBarButtonStyle}">
        <Path Width="8"
              Height="8"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Fill="{TemplateBinding Foreground}"
              Data="M6,0 L2,4 L6,8 Z" />
      </RepeatButton>
      <Track x:Name="PART_Track"
             Grid.Column="1"
             Orientation="Horizontal">
        <Track.DecreaseRepeatButton>
          <RepeatButton x:Name="PageLeftButton"
                        Tag="{DynamicResource ScrollBar.TrackBackgroundBrush}"
                        Command="{x:Static ScrollBar.PageLeftCommand}"
                        Style="{DynamicResource App.Canonical.TrackRepeatButtonStyle}" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb MinWidth="24" Margin="2">
            <Thumb.Template>
              <ControlTemplate TargetType="{x:Type Thumb}">
                <Border x:Name="ThumbChrome"
                        Background="{DynamicResource ScrollBar.ThumbBackgroundBrush}"
                        CornerRadius="4" />
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ScrollBar.ThumbHoverBackgroundBrush}" />
                  </Trigger>
                  <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ScrollBar.ThumbDraggingBackgroundBrush}" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ScrollBar.TrackBackgroundBrush}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Thumb.Template>
          </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
      <RepeatButton x:Name="PageRightButton"
                        Tag="{DynamicResource ScrollBar.TrackBackgroundBrush}"
                        Command="{x:Static ScrollBar.PageRightCommand}"
                        Style="{DynamicResource App.Canonical.TrackRepeatButtonStyle}" />
        </Track.IncreaseRepeatButton>
      </Track>
      <RepeatButton x:Name="LineRightButton"
                    Grid.Column="2"
                    Width="15"
                    Command="{x:Static ScrollBar.LineRightCommand}"
                    Style="{DynamicResource App.Canonical.ScrollBarButtonStyle}">
        <Path Width="8"
              Height="8"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Fill="{TemplateBinding Foreground}"
              Data="M2,0 L6,4 L2,8 Z" />
      </RepeatButton>
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.ScrollViewerTemplate" TargetType="{x:Type ScrollViewer}">
    <Grid Background="{TemplateBinding Background}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                              Grid.Row="0"
                              Grid.Column="0"
                              Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              CanContentScroll="{TemplateBinding CanContentScroll}" />
      <ScrollBar x:Name="PART_VerticalScrollBar"
                 Grid.Row="0"
                 Grid.Column="1"
                 Orientation="Vertical"
                 Style="{DynamicResource App.Canonical.ScrollBarStyle}"
                 Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                 ViewportSize="{TemplateBinding ViewportHeight}"
                 Minimum="0"
                 Maximum="{TemplateBinding ScrollableHeight}"
                 Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
      <ScrollBar x:Name="PART_HorizontalScrollBar"
                 Grid.Row="1"
                 Grid.Column="0"
                 Orientation="Horizontal"
                 Style="{DynamicResource App.Canonical.ScrollBarStyle}"
                 Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                 ViewportSize="{TemplateBinding ViewportWidth}"
                 Minimum="0"
                 Maximum="{TemplateBinding ScrollableWidth}"
                 Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
      <Border Grid.Row="1"
              Grid.Column="1"
              Background="{DynamicResource ScrollBar.TrackBackgroundBrush}" />
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.ListBoxItemTemplate" TargetType="{x:Type ListBoxItem}">
    <Border x:Name="ItemChrome"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="4">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="Center" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource App.ControlHoverBrush}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource App.ControlSelectedBrush}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource App.InputFocusBorderBrush}" />
        <Setter TargetName="ItemChrome" Property="BorderThickness" Value="1" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
        <Setter Property="Opacity" Value="0.55" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.ListBoxTemplate" TargetType="{x:Type ListBox}">
    <Border x:Name="ListChrome"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="4">
      <ScrollViewer Style="{DynamicResource App.Canonical.ScrollViewerStyle}"
                    Padding="{TemplateBinding Padding}"
                    Focusable="False">
        <ItemsPresenter />
      </ScrollViewer>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="ListChrome" Property="BorderBrush" Value="{DynamicResource App.InputFocusBorderBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
        <Setter TargetName="ListChrome" Property="Opacity" Value="0.55" />
      </Trigger>
      <Trigger Property="IsGrouping" Value="True">
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!--
    The property dialog uses this keyed ListBox role for its top navigation.
    Keeping the role on ListBox preserves WPF's Selection/SelectionItem peers
    and the standard selector keyboard route without adding a presentation
    code-behind seam.
  -->
  <ControlTemplate x:Key="App.Canonical.TopNavigationItemTemplate" TargetType="{x:Type ListBoxItem}">
    <Grid SnapsToDevicePixels="True">
      <Border x:Name="NavigationItemChrome"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="Center"
                          RecognizesAccessKey="True"
                          ContentSource="Content" />
      </Border>
      <Border x:Name="SelectionIndicator"
              Height="2"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Bottom"
              Background="{DynamicResource App.AccentBrush}"
              Visibility="Collapsed"
              IsHitTestVisible="False" />
      <Border x:Name="FocusBorder"
              BorderBrush="{DynamicResource App.InputFocusBorderBrush}"
              BorderThickness="1"
              Visibility="Collapsed"
              IsHitTestVisible="False" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="NavigationItemChrome" Property="Background" Value="{DynamicResource App.ControlHoverBrush}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="NavigationItemChrome" Property="Background" Value="{DynamicResource App.ControlSelectedBrush}" />
        <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
        <Setter TargetName="NavigationItemChrome" Property="Opacity" Value="0.55" />
        <Setter TargetName="SelectionIndicator" Property="Opacity" Value="0.55" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.TopNavigationTemplate" TargetType="{x:Type ListBox}">
    <Border x:Name="TopNavigationChrome"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
      <ScrollViewer x:Name="PART_ScrollViewer"
                    Padding="{TemplateBinding Padding}"
                    Focusable="False"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Disabled"
                    CanContentScroll="True">
        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
      </ScrollViewer>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="TopNavigationChrome" Property="BorderBrush" Value="{DynamicResource App.InputFocusBorderBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
        <Setter TargetName="TopNavigationChrome" Property="Opacity" Value="0.55" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.TopNavigationContentTemplate" TargetType="{x:Type ContentControl}">
    <ContentPresenter Margin="{TemplateBinding Padding}"
                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                      ContentSource="Content" />
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.ExpanderHeaderToggleTemplate" TargetType="{x:Type ToggleButton}">
    <Border x:Name="HeaderChrome"
            Padding="8,6"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Path x:Name="CollapsedGlyph"
              Width="6"
              Height="10"
              Fill="{DynamicResource App.TextBrush}"
              Data="M 0 0 L 6 5 L 0 10 Z" />
        <Path x:Name="ExpandedGlyph"
              Width="10"
              Height="6"
              Fill="{DynamicResource App.TextBrush}"
              Data="M 0 0 L 5 6 L 10 0 Z"
              Visibility="Collapsed" />
        <ContentPresenter Grid.Column="1"
                          Margin="6,0,0,0"
                          VerticalAlignment="Center" />
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource App.ControlHoverBrush}" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="CollapsedGlyph" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="ExpandedGlyph" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="HeaderChrome" Property="BorderBrush" Value="{DynamicResource App.InputFocusBorderBrush}" />
        <Setter TargetName="HeaderChrome" Property="BorderThickness" Value="1" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
        <Setter Property="Opacity" Value="0.55" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.ExpanderTemplate" TargetType="{x:Type Expander}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ToggleButton x:Name="HeaderSite"
                    Grid.Row="0"
                    Style="{DynamicResource App.Canonical.ExpanderHeaderToggleStyle}"
                    Content="{TemplateBinding Header}"
                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                    ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                    IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
      <Border x:Name="ExpandSite"
              Grid.Row="1"
              Margin="16,4,0,0"
              Visibility="Collapsed">
        <ContentPresenter ContentSource="Content" />
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsExpanded" Value="True">
        <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
        <Setter TargetName="ExpandSite" Property="Opacity" Value="0.55" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.TrackRepeatButtonTemplate" TargetType="{x:Type RepeatButton}">
    <Border Background="{TemplateBinding Tag}" />
  </ControlTemplate>

  <Style x:Key="App.Canonical.TrackRepeatButtonStyle" TargetType="{x:Type RepeatButton}" BasedOn="{x:Null}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.TrackRepeatButtonTemplate}" />
  </Style>

  <Style x:Key="App.Canonical.ScrollBarButtonStyle" TargetType="{x:Type RepeatButton}" BasedOn="{x:Null}">
    <Setter Property="Background" Value="{DynamicResource ScrollBar.ButtonBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ScrollBar.ButtonBorderBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource ScrollBar.ArrowBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Grid>
            <Border x:Name="ButtonChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" />
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource ScrollBar.ButtonHoverBackgroundBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource ScrollBar.ButtonPressedBackgroundBrush}" />
              <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource ScrollBar.ButtonBorderBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource ScrollBar.TrackBackgroundBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="App.Canonical.ButtonStyle" TargetType="{x:Type Button}" BasedOn="{x:Null}">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource App.ControlBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="Tag" Value="{DynamicResource App.InputFocusBorderBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.ButtonTemplate}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.ControlHoverBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.ControlPressedBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="App.Canonical.PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource App.Canonical.ButtonStyle}">
    <Setter Property="Background" Value="{DynamicResource App.AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource App.AccentForegroundBrush}" />
    <Setter Property="Tag" Value="{DynamicResource App.AccentFocusRingBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.AccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App.AccentForegroundBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.AccentPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.AccentPressedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App.AccentForegroundBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource App.AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App.AccentForegroundBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="App.Canonical.QuietButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource App.Canonical.ButtonStyle}">
    <Setter Property="Background" Value="{x:Null}" />
  </Style>

  <Style x:Key="App.Canonical.DangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource App.Canonical.ButtonStyle}">
    <Setter Property="Background" Value="{DynamicResource App.DangerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.DangerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource App.DangerForegroundBrush}" />
    <Setter Property="Tag" Value="{DynamicResource App.DangerForegroundBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.DangerHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.DangerHoverBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource App.DangerPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.DangerPressedBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="App.Canonical.IconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource App.Canonical.QuietButtonStyle}">
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style x:Key="App.Canonical.TextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{x:Null}">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource App.ControlBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.TextBoxTemplate}" />
  </Style>

  <Style x:Key="App.Canonical.ComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{x:Null}">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource App.ControlBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="ItemContainerStyle" Value="{DynamicResource App.Canonical.ComboBoxItemStyle}" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.ComboBoxTemplate}" />
  </Style>

  <Style x:Key="App.Canonical.ComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}" BasedOn="{x:Null}">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.ComboBoxItemTemplate}" />
  </Style>

  <Style x:Key="App.Canonical.CheckBoxStyle" TargetType="{x:Type CheckBox}" BasedOn="{x:Null}">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="8,2,0,2" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.CheckBoxTemplate}" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="App.Canonical.RadioButtonStyle" TargetType="{x:Type RadioButton}" BasedOn="{x:Null}">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="8,2,0,2" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.RadioButtonTemplate}" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="App.Canonical.SliderStyle" TargetType="{x:Type Slider}" BasedOn="{x:Null}">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.HorizontalSliderTemplate}" />
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Vertical">
        <Setter Property="Template" Value="{StaticResource App.Canonical.VerticalSliderTemplate}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="App.Canonical.ScrollBarStyle" TargetType="{x:Type ScrollBar}" BasedOn="{x:Null}">
    <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
    <Setter Property="Width" Value="15" />
    <Setter Property="Background" Value="{DynamicResource ScrollBar.TrackBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ScrollBar.ArrowBrush}" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.VerticalScrollBarTemplate}" />
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Template" Value="{StaticResource App.Canonical.HorizontalScrollBarTemplate}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.55" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="App.Canonical.ScrollViewerStyle" TargetType="{x:Type ScrollViewer}" BasedOn="{x:Null}">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.ScrollViewerTemplate}" />
  </Style>

  <Style x:Key="App.Canonical.ListBoxItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{x:Null}">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.ListBoxItemTemplate}" />
  </Style>

  <Style x:Key="App.Canonical.ListBoxStyle" TargetType="{x:Type ListBox}" BasedOn="{x:Null}">
    <Setter Property="Background" Value="{DynamicResource App.ControlBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="ItemContainerStyle" Value="{DynamicResource App.Canonical.ListBoxItemStyle}" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.ListBoxTemplate}" />
  </Style>

  <Style x:Key="App.Canonical.TopNavigationItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{x:Null}">
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.TopNavigationItemTemplate}" />
  </Style>

  <Style x:Key="App.Canonical.TopNavigationStyle" TargetType="{x:Type ListBox}" BasedOn="{x:Null}">
    <Setter Property="Background" Value="{x:Null}" />
    <Setter Property="BorderBrush" Value="{x:Null}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle" Value="{StaticResource App.Canonical.TopNavigationItemStyle}" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.TopNavigationTemplate}" />
  </Style>

  <Style x:Key="App.Canonical.TopNavigationContentStyle" TargetType="{x:Type ContentControl}" BasedOn="{x:Null}">
    <Setter Property="Padding" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.TopNavigationContentTemplate}" />
  </Style>

  <ControlTemplate x:Key="App.Canonical.GroupBoxTemplate" TargetType="{x:Type GroupBox}">
    <Border x:Name="CanonicalCard"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="1"
            Background="{TemplateBinding Background}"
            CornerRadius="12"
            SnapsToDevicePixels="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentPresenter Margin="16,12,16,0"
                          ContentSource="Header"
                          RecognizesAccessKey="True"
                          TextElement.Foreground="{TemplateBinding Control.Foreground}"
                          TextElement.FontSize="14"
                          TextElement.FontWeight="SemiBold" />
        <ContentPresenter Grid.Row="1"
                          Margin="{TemplateBinding Padding}"
                          TextElement.Foreground="{TemplateBinding Control.Foreground}" />
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
        <Setter TargetName="CanonicalCard" Property="Opacity" Value="0.65" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.LabelTemplate" TargetType="{x:Type Label}">
    <Grid>
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        RecognizesAccessKey="True"
                        TextElement.Foreground="{TemplateBinding Control.Foreground}" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="App.Canonical.GroupBoxStyle" TargetType="{x:Type GroupBox}" BasedOn="{x:Null}">
    <Setter Property="Margin" Value="0,0,0,16" />
    <Setter Property="Padding" Value="16,12,16,16" />
    <Setter Property="Background" Value="{DynamicResource App.ControlBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.GroupBoxTemplate}" />
  </Style>

  <Style x:Key="App.Canonical.LabelStyle" TargetType="{x:Type Label}" BasedOn="{x:Null}">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="0,6,12,6" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template" Value="{StaticResource App.Canonical.LabelTemplate}" />
  </Style>

  <Style x:Key="App.Canonical.ExpanderHeaderToggleStyle" TargetType="{x:Type ToggleButton}" BasedOn="{x:Null}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.ExpanderHeaderToggleTemplate}" />
  </Style>

  <Style x:Key="App.Canonical.ExpanderStyle" TargetType="{x:Type Expander}" BasedOn="{x:Null}">
    <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.ExpanderTemplate}" />
  </Style>
</ResourceDictionary>
