  <Style x:Key="App.Canonical.CompactSliderStyle" TargetType="{x:Type Slider}" BasedOn="{StaticResource App.Canonical.SliderStyle}">
    <Style.Resources>
      <s:Double x:Key="App.Canonical.SliderThumbSize">12</s:Double>
      <s:Double x:Key="App.Canonical.SliderRailThickness">3</s:Double>
    </Style.Resources>
  </Style>

  <Style x:Key="App.Canonical.ScrollBarStyle" TargetType="{x:Type ScrollBar}" BasedOn="{x:Null}">
    <!-- OSテーマの既定最小寸法17 DIPを外し、固定16 DIPの入力領域を保つ。 -->
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
    <Setter Property="Width" Value="16" />
    <!-- Paddingはつまみ描画の横断方向だけに使い、入力領域とTrackの測定寸法は変えない。 -->
    <Setter Property="Padding" Value="0,0,2,0" />
    <Setter Property="Background" Value="{DynamicResource ScrollBar.TrackBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ScrollBar.ArrowBrush}" />
    <Setter Property="Template" Value="{StaticResource App.Canonical.VerticalScrollBarTemplate}" />
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="0,0,0,2" />
        <Setter Property="Template" Value="{StaticResource App.Canonical.HorizontalScrollBarTemplate}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.55" />
      </Trigger>
    </Style.Triggers>
  </Style>

