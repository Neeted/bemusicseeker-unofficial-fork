  <ControlTemplate x:Key="App.Canonical.GroupBoxTemplate" TargetType="{x:Type GroupBox}">
    <Border x:Name="CanonicalCard"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="1"
            Background="{TemplateBinding Background}"
            SnapsToDevicePixels="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentPresenter Margin="16,16,16,0"
                          ContentSource="Header"
                          RecognizesAccessKey="True"
                          TextElement.Foreground="{TemplateBinding Control.Foreground}"
                          TextElement.FontSize="14"
                          TextElement.FontWeight="SemiBold" />
        <ContentPresenter Grid.Row="1"
                          Margin="{TemplateBinding Padding}"
                          TextElement.Foreground="{TemplateBinding Control.Foreground}" />
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
        <Setter TargetName="CanonicalCard" Property="Opacity" Value="0.65" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="App.Canonical.LabelTemplate" TargetType="{x:Type Label}">
    <Grid>
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        RecognizesAccessKey="True"
                        TextElement.Foreground="{TemplateBinding Control.Foreground}" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource App.DisabledTextBrush}" />
