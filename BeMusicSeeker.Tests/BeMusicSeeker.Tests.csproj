<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BeMusicSeeker.csproj" />
    <ProjectReference Include="..\BeMusicSeeker.Updater\BeMusicSeeker.Updater.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <Compile Include="..\tools\chart-info-compare\ChartInfoCompareCore.cs" Link="Tools\ChartInfoCompareCore.cs" />
    <Compile Include="..\tools\chart-info-export\ChartInfoExportCore.cs" Link="Tools\ChartInfoExportCore.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sqlite.net">
      <HintPath>..\libs\sqlite.net.dll</HintPath>
    </Reference>
    <Reference Include="Livet">
      <HintPath>..\libs\Livet.dll</HintPath>
    </Reference>
    <Reference Include="QuickConverter">
      <HintPath>..\libs\QuickConverter.dll</HintPath>
    </Reference>
    <Reference Include="DynamicJson">
      <HintPath>..\libs\DynamicJson.dll</HintPath>
    </Reference>
    <Reference Include="SgmlReaderDll">
      <HintPath>..\libs\SgmlReaderDll.dll</HintPath>
    </Reference>
    <Reference Include="SevenZipExtractor">
      <HintPath>..\libs\SevenZipExtractor.dll</HintPath>
    </Reference>
    <Reference Include="OggVorbis.NET64">
      <HintPath>..\vendor\native\x64\OggVorbis.NET64.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <None Update="TestData\archives\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="TestData\chart_info_real\expected.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="TestData\chart_info_real\manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="TestData\chart_info_real\charts\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="TestData\chart_info_edge_cases\expected.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="TestData\chart_info_edge_cases\manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="TestData\chart_info_edge_cases\charts\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="TestData\lr2_builtin_custom_folder_real\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\vendor\native\x64\7z.dll">
      <Link>libs\x64\7z.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\vendor\native\x64\sqlite3.dll">
      <Link>x64\sqlite3.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
