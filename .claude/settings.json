{
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Edit",
      "Write",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git ls-files *)",
      "PowerShell(git worktree list *)",
      "PowerShell(git add *)",
      "PowerShell(git restore --staged *)",
      "PowerShell(git mv *)",
      "PowerShell(git rm -- *)",
      "PowerShell(git commit -m *)",
      "PowerShell(git worktree add *)",
      "PowerShell(git worktree remove *)",
      "PowerShell(git switch dev)",
      "PowerShell(git switch -c *)",
      "PowerShell(git branch -d *)",
      "PowerShell(git fetch origin *)",
      "PowerShell(git pull --ff-only)",
      "PowerShell(git merge --ff-only *)",
      "PowerShell(git rebase dev)",
      "PowerShell(git rebase --continue)",
      "PowerShell(git rebase --abort)",
      "PowerShell(git stash create *)",
      "PowerShell(Push-Location *)",
      "PowerShell(Pop-Location)",
      "PowerShell(dotnet restore *)",
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet run --project tests/BeMusicSeeker.Core.Tests *)",
      "PowerShell(dotnet run --project tests/BeMusicSeeker.Windows.Tests *)",
      "PowerShell(dotnet run --project tests/BeMusicSeeker.Scenarios.Tests *)",
      "PowerShell(dotnet run --project tests/BeMusicSeeker.Desktop.E2E.Tests *)",
      "PowerShell(dotnet run --project tests/BeMusicSeeker.Compatibility.Tests *)",
      "PowerShell(dotnet run --project tests/BeMusicSeeker.Performance.Tests *)",
      "PowerShell(dotnet run --project tools/BeMusicSeeker.Verify -- dev *)",
      "PowerShell(dotnet run --project tools/BeMusicSeeker.Verify -- verify *)",
      "PowerShell(dotnet run --project tools/BeMusicSeeker.Verify -- compatibility *)",
      "PowerShell(dotnet run --project tools/BeMusicSeeker.Verify -- performance *)",
      "PowerShell(dotnet run --project tools/BeMusicSeeker.Verify -- prepare-candidate *)",
      "PowerShell(dotnet run --project tools/BeMusicSeeker.Verify -- full *)",
      "PowerShell(pwsh -NoProfile -File scripts/format-code.ps1 *)",
      "PowerShell(pwsh -NoProfile -File .\\scripts\\format-code.ps1 *)",
      "PowerShell(pwsh -NoProfile -File .claude/scripts/print-sections.ps1 *)",
      "PowerShell(uv run scripts/build-doc-html.py *)",
      "PowerShell(pwsh -NoProfile -File scripts/lang/convert-resx-to-json.ps1 *)",
      "PowerShell(pwsh native/EverythingBridge/build-x64.ps1 *)",
      "PowerShell(pwsh -NoProfile -File native/EverythingBridge/build-x64.ps1 *)",
      "PowerShell(pwsh -NoProfile -File .\\native\\EverythingBridge\\build-x64.ps1 *)",
      "PowerShell(pwsh -NoProfile -File .\\native\\EverythingBridge\\test-x64.ps1 *)",
      "PowerShell(pwsh -NoProfile -File native/EverythingBridge/test-x64.ps1 *)"
    ],
    "ask": [
      "PowerShell(git push *)",
      "PowerShell(git tag *)",
      "PowerShell(git merge --no-ff *)",
      "PowerShell(git worktree remove --force *)",
      "PowerShell(git worktree remove -f *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(git stash pop *)",
      "PowerShell(git stash drop *)",
      "PowerShell(pwsh -NoProfile -File scripts/release.ps1 *)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/precompact.ps1"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(git commit *)",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/commit-reminder.ps1"]
          },
          {
            "type": "command",
            "if": "PowerShell(git merge --ff-only *)",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/commit-reminder.ps1"]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/commit-reminder.ps1"]
          },
          {
            "type": "command",
            "if": "Bash(git merge --ff-only *)",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/commit-reminder.ps1"]
          }
        ]
      }
    ]
  }
}
