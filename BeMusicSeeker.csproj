      <HintPath>libs\DynamicJson.dll</HintPath>
    </Reference>
    <Reference Include="SgmlReaderDll">
      <HintPath>libs\SgmlReaderDll.dll</HintPath>
    </Reference>
    <Reference Include="SevenZipExtractor">
      <HintPath>libs\SevenZipExtractor.dll</HintPath>
    </Reference>
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>
</Project>