<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>BeMusicSeeker</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>False</GenerateTargetFrameworkAttribute>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>BeMusicSeeker\app.manifest</ApplicationManifest>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="bin\**\*.cs;obj\**\*.cs" />
    <Compile Remove="BeMusicSeeker.Tests\**\*.cs" />
    <Compile Remove="BeMusicSeeker.Updater\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
    <None Remove="BeMusicSeeker.Tests\**\*" />
    <None Remove="BeMusicSeeker.Updater\**\*" />
  </ItemGroup>
  <ItemGroup>
    <None Include="native\Everything3_x64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="native\EverythingBridge_x64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="vendor\native\x64\*.dll" Exclude="vendor\native\x64\7z.dll;vendor\native\x64\sqlite3.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>libs\x64\%(Filename)%(Extension)</TargetPath>
    </None>
    <None Update="lang\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="assets\audio\test.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>test.mp3</TargetPath>
    </None>
    <None Remove="BeMusicSeeker\App.xaml" />
    <ApplicationDefinition Include="BeMusicSeeker\App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <None Remove="icon_and_logo.ico" />
    <None Remove="resources\default_image.jpg" />
    <None Remove="resources\sovjetboxbd_v0_9.otf" />
    <None Remove="resources\icon_and_logo.png" />
    <None Remove="resources\ligaturesymbols-2.11.otf" />
    <None Remove="resources\imageres_5328.ico" />
    <None Remove="resources\commodore-20rounded-20v1.2.ttf" />
    <Resource Include="icon_and_logo.ico" />
    <EmbeddedResource Update="Properties\Images.resx" />
    <Resource Include="resources\default_image.jpg" />
    <Resource Include="resources\sovjetboxbd_v0_9.otf" />
    <Resource Include="resources\icon_and_logo.png" />
    <Resource Include="resources\ligaturesymbols-2.11.otf" />
    <Resource Include="resources\imageres_5328.ico" />
    <Resource Include="resources\commodore-20rounded-20v1.2.ttf" />
  </ItemGroup>

  <Target Name="VerifyEverythingNativeAssets" BeforeTargets="Build">
    <Error Condition="!Exists('native\Everything3_x64.dll')"
           Text="Everything SDK x64 native asset is missing: native\Everything3_x64.dll" />
    <Error Condition="!Exists('native\EverythingBridge_x64.dll')"
           Text="Everything bridge x64 native asset is missing: native\EverythingBridge_x64.dll" />
  </Target>
  <ItemGroup>
    <PackageReference Include="LivetCask.Core" />
    <PackageReference Include="LivetCask.EventListeners" />
    <PackageReference Include="LivetCask.Mvvm" />
    <PackageReference Include="Microsoft.Xml.SgmlReader" />
    <PackageReference Include="sqlite-net-pcl" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="SevenZipExtractor" GeneratePathProperty="true" ExcludeAssets="build" />
    <PackageReference Include="NVorbis" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="NLog" />
    <PackageReference Include="ManagedBass" />
    <PackageReference Include="ManagedBass.Mix" />
    <PackageReference Include="ManagedBass.Fx" />
    <PackageReference Include="ManagedBass.Enc" />
    <PackageReference Include="ManagedBass.Asio" />
    <PackageReference Include="ManagedBass.Wasapi" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgSevenZipExtractor)\build\x64\7z.dll" Condition="Exists('$(PkgSevenZipExtractor)\build\x64\7z.dll')">
      <Link>libs\x64\7z.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="RemoveLegacyNativeOutputArtifacts" AfterTargets="CopyFilesToOutputDirectory">
    <RemoveDir Directories="$(OutDir)x86;$(OutDir)libs\x86" />
  </Target>

  <Target Name="VerifySevenZipNativeAsset" BeforeTargets="Build;Publish">
    <Error Condition="!Exists('$(PkgSevenZipExtractor)\build\x64\7z.dll')"
           Text="SevenZipExtractor x64 native asset is missing: $(PkgSevenZipExtractor)\build\x64\7z.dll" />
  </Target>

  <Target Name="CopyPublishedNativeAssets" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)native;$(PublishDir)libs\x64" />
    <Copy SourceFiles="native\Everything3_x64.dll"
          DestinationFiles="$(PublishDir)native\Everything3_x64.dll"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="native\EverythingBridge_x64.dll"
          DestinationFiles="$(PublishDir)native\EverythingBridge_x64.dll"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="vendor\native\x64\bass.dll;vendor\native\x64\bassasio.dll;vendor\native\x64\bassenc.dll;vendor\native\x64\bassmix.dll;vendor\native\x64\basswasapi.dll;vendor\native\x64\bass_fx.dll"
          DestinationFiles="$(PublishDir)libs\x64\bass.dll;$(PublishDir)libs\x64\bassasio.dll;$(PublishDir)libs\x64\bassenc.dll;$(PublishDir)libs\x64\bassmix.dll;$(PublishDir)libs\x64\basswasapi.dll;$(PublishDir)libs\x64\bass_fx.dll"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(PkgSevenZipExtractor)\build\x64\7z.dll"
          DestinationFiles="$(PublishDir)libs\x64\7z.dll"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
