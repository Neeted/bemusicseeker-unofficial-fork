<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>BeMusicSeeker</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>BeMusicSeeker\app.manifest</ApplicationManifest>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="BeMusicSeeker.Tests\**\*.cs" />
    <Compile Remove="BeMusicSeeker.Updater\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
    <None Remove="BeMusicSeeker.Tests\**\*" />
    <None Remove="BeMusicSeeker.Updater\**\*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="BeMusicSeeker.Updater\BeMusicSeeker.Updater.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <None Include="native\Everything3_x64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="native\EverythingBridge_x64.dll" Condition="Exists('native\\EverythingBridge_x64.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="vendor\native\x64\*.dll" Exclude="vendor\native\x64\OggVorbis.NET64.dll;vendor\native\x64\sqlite3.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>libs\x64\%(Filename)%(Extension)</TargetPath>
    </None>
    <None Include="vendor\native\x64\sqlite3.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>x64\sqlite3.dll</TargetPath>
    </None>
    <None Update="lang\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="assets\audio\test.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>test.mp3</TargetPath>
    </None>
    <None Remove="BeMusicSeeker\App.xaml" />
    <ApplicationDefinition Include="BeMusicSeeker\App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <None Remove="icon_and_logo.ico" />
    <None Remove="resources\default_image.jpg" />
    <None Remove="resources\sovjetboxbd_v0_9.otf" />
    <None Remove="resources\icon_and_logo.png" />
    <None Remove="resources\ligaturesymbols-2.11.otf" />
    <None Remove="resources\imageres_5328.ico" />
    <None Remove="resources\commodore-20rounded-20v1.2.ttf" />
    <Resource Include="icon_and_logo.ico" />
    <EmbeddedResource Update="Properties\Images.resx" />
    <Resource Include="resources\default_image.jpg" />
    <Resource Include="resources\sovjetboxbd_v0_9.otf" />
    <Resource Include="resources\icon_and_logo.png" />
    <Resource Include="resources\ligaturesymbols-2.11.otf" />
    <Resource Include="resources\imageres_5328.ico" />
    <Resource Include="resources\commodore-20rounded-20v1.2.ttf" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="4.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Formatting.Analyzers" Version="4.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <Reference Include="Livet">
      <HintPath>libs\Livet.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Interactivity">
      <HintPath>libs\System.Windows.Interactivity.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Expression.Interactions">
      <HintPath>libs\Microsoft.Expression.Interactions.dll</HintPath>
    </Reference>
    <Reference Include="MetroRadiance">
      <HintPath>libs\MetroRadiance.dll</HintPath>
    </Reference>
    <Reference Include="MetroRadiance.Core">
      <HintPath>libs\MetroRadiance.Core.dll</HintPath>
    </Reference>
    <Reference Include="MetroRadiance.Chrome">
      <HintPath>libs\MetroRadiance.Chrome.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Expression.Drawing">
      <HintPath>libs\Microsoft.Expression.Drawing.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Expression.Effects">
      <HintPath>libs\Microsoft.Expression.Effects.dll</HintPath>
    </Reference>
    <Reference Include="Livet.Extensions">
      <HintPath>libs\Livet.Extensions.dll</HintPath>
    </Reference>
    <Reference Include="IniLibrary">
      <HintPath>libs\IniLibrary.dll</HintPath>
    </Reference>
    <!-- Keep HintPath references for legacy libraries without confirmed same-identity PackageReference replacement in this task. -->
    <Reference Include="sqlite.net">
      <HintPath>libs\sqlite.net.dll</HintPath>
    </Reference>
    <Reference Include="Bass.Net">
      <HintPath>libs\Bass.Net.dll</HintPath>
    </Reference>
    <!-- Keep HintPath because requested 4.5.0 resolves to 5.0.0 via current package graph (identity parity not guaranteed). -->
    <Reference Include="System.Collections.Immutable">
      <HintPath>libs\System.Collections.Immutable.dll</HintPath>
    </Reference>
    <Reference Include="QuickConverter">
      <HintPath>libs\QuickConverter.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.WindowsAPICodePack.Shell">
      <HintPath>libs\Microsoft.WindowsAPICodePack.Shell.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.WindowsAPICodePack">
      <HintPath>libs\Microsoft.WindowsAPICodePack.dll</HintPath>
    </Reference>
    <Reference Include="DynamicJson">
      <HintPath>libs\DynamicJson.dll</HintPath>
    </Reference>
    <Reference Include="SgmlReaderDll">
      <HintPath>libs\SgmlReaderDll.dll</HintPath>
    </Reference>
    <Reference Include="SevenZipExtractor">
      <HintPath>libs\SevenZipExtractor.dll</HintPath>
    </Reference>
    <Reference Include="OggVorbis.NET64">
      <HintPath>vendor\native\x64\OggVorbis.NET64.dll</HintPath>
    </Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="6.1.4" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.10" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.10" />
  </ItemGroup>

  <Target Name="RemoveLegacyNativeOutputArtifacts" AfterTargets="CopyFilesToOutputDirectory">
    <RemoveDir Directories="$(OutDir)x86;$(OutDir)libs\x86" />
    <Delete Files="$(OutDir)libs\x64\OggVorbis.NET64.dll" />
  </Target>

  <Target Name="CopyUpdaterToAppOutput" AfterTargets="Build">
    <PropertyGroup>
      <_UpdaterProjectDirectory>$(MSBuildProjectDirectory)\BeMusicSeeker.Updater\</_UpdaterProjectDirectory>
      <_UpdaterBuildOutputDirectory Condition="'$(Platform)' == 'x64'">$([System.IO.Path]::GetFullPath('$(_UpdaterProjectDirectory)bin\x64\$(Configuration)\$(TargetFramework)'))\</_UpdaterBuildOutputDirectory>
      <_UpdaterBuildOutputDirectory Condition="'$(Platform)' != 'x64'">$([System.IO.Path]::GetFullPath('$(_UpdaterProjectDirectory)bin\$(Configuration)\$(TargetFramework)'))\</_UpdaterBuildOutputDirectory>
    </PropertyGroup>

    <ItemGroup>
      <_UpdaterPayload Include="$(_UpdaterBuildOutputDirectory)BeMusicSeeker.Updater.exe" />
      <_UpdaterPayload Include="$(_UpdaterBuildOutputDirectory)BeMusicSeeker.Updater.dll" />
      <_UpdaterPayload Include="$(_UpdaterBuildOutputDirectory)BeMusicSeeker.Updater.deps.json" />
      <_UpdaterPayload Include="$(_UpdaterBuildOutputDirectory)BeMusicSeeker.Updater.runtimeconfig.json" />
    </ItemGroup>

    <Error Condition="!Exists('%(_UpdaterPayload.Identity)')"
           Text="Updater payload was not found: %(_UpdaterPayload.Identity)" />

    <Copy SourceFiles="@(_UpdaterPayload)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
