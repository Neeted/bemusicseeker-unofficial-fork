<?xml version="1.0" encoding="utf-8"?>
<views:ThemedWindow x:Class="Parago.Windows.ProgressDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Parago.Windows.Controls" xmlns:views="clr-namespace:BeMusicSeeker.Views" SizeToContent="Height" Width="500" MinWidth="500" FontFamily="Meiryo UI" ResizeMode="NoResize" WindowStyle="SingleBorderWindow" WindowStartupLocation="CenterOwner" ui:WindowSettings.HideCloseButton="True" Closing="OnClosing" Background="{DynamicResource App.DialogBackgroundBrush}" Foreground="{DynamicResource App.TextBrush}">
  <views:ThemedWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/BeMusicSeeker;component/BeMusicSeeker/Themes/CanonicalDialogStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </views:ThemedWindow.Resources>
  <Border Style="{StaticResource App.Canonical.NativeWindowContentStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Name="TextLabel" Grid.Row="0" Text="Loading..." TextTrimming="CharacterEllipsis" />
      <TextBlock Name="SubTextLabel" Grid.Row="1" Text="..." Visibility="Collapsed" Margin="0,5,0,5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ProgressBar Name="ProgressBar" Grid.Column="0" IsIndeterminate="True" Height="22" />
        <Button Name="CancelButton" Grid.Column="1" Margin="3,0,0,0" Width="70" Style="{StaticResource App.Canonical.DialogQuietActionStyle}" Content="Cancel" AutomationProperties.AutomationId="ProgressDialogCancel" Visibility="Collapsed" HorizontalAlignment="Right" Click="OnCancelButtonClick" />
      </Grid>
    </Grid>
  </Border>
</views:ThemedWindow>
