<?xml version="1.0" encoding="utf-8"?>
<views:ThemedWindow x:Class="Parago.Windows.ProgressDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Parago.Windows.Controls" xmlns:views="clr-namespace:BeMusicSeeker.Views" Height="140" Width="500" MinHeight="140" MinWidth="500" FontFamily="Meiryo UI" ResizeMode="NoResize" WindowStyle="SingleBorderWindow" WindowStartupLocation="CenterOwner" ui:WindowSettings.HideCloseButton="True" Closing="OnClosing" Background="{DynamicResource App.DialogBackgroundBrush}" Foreground="{DynamicResource App.TextBrush}">
  <DockPanel Margin="10" Background="{DynamicResource App.DialogBackgroundBrush}">
    <Grid DockPanel.Dock="Bottom">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ProgressBar Name="ProgressBar" Grid.Column="0" IsIndeterminate="True" Height="22" />
      <Button Name="CancelButton" Grid.Column="1" Margin="3,0,0,0" Width="70" Height="22" Content="Cancel" Visibility="Collapsed" HorizontalAlignment="Right" Click="OnCancelButtonClick" />
    </Grid>
    <TextBlock Name="TextLabel" Text="Loading..." TextTrimming="CharacterEllipsis" DockPanel.Dock="Top" />
    <TextBlock Name="SubTextLabel" Text="..." Visibility="Collapsed" Margin="0,5,0,5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
  </DockPanel>
</views:ThemedWindow>
