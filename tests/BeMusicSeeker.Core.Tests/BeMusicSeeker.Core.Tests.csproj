<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <EnableMicrosoftTestingExtensionsTrxReport>true</EnableMicrosoftTestingExtensionsTrxReport>
    <EnableMicrosoftTestingExtensionsCrashDump>true</EnableMicrosoftTestingExtensionsCrashDump>
    <EnableMicrosoftTestingExtensionsHangDump>true</EnableMicrosoftTestingExtensionsHangDump>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../tools/chart-info-export/ChartInfoExport.csproj" />
    <ProjectReference Include="../../tools/chart-info-compare/ChartInfoCompare.csproj" />

    <ProjectReference Include="../BeMusicSeeker.TestSupport/BeMusicSeeker.TestSupport.csproj" />
    <ProjectReference Include="../../BeMusicSeeker/BeMusicSeeker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../ModuleInitialization/ModuleLifetime.cs" Link="Infrastructure/ModuleLifetime.cs" />
    <Compile Include="../ModuleInitialization/AssemblySettings.cs" Link="Infrastructure/AssemblySettings.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Fixtures/ProcessFixture/ProcessFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../BeMusicSeeker.Tests/TestData/lr2_builtin_custom_folder_real/**/*" Link="TestData/lr2_builtin_custom_folder_real/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyProcessFixture" AfterTargets="Build">
    <Error Condition="'$(TargetDir)' == '' Or !$([System.IO.Path]::IsPathFullyQualified('$(TargetDir)'))" Text="Test output directory must be absolute and nonempty." />
    <PropertyGroup>
      <_ProcessFixtureDestination>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(TargetDir)', 'ProcessFixture'))))</_ProcessFixtureDestination>
      <_ProcessFixtureDestinationRoot>$([System.IO.Path]::GetPathRoot('$(_ProcessFixtureDestination)'))</_ProcessFixtureDestinationRoot>
      <_ProcessFixtureOutputRoot>$([System.IO.Path]::GetFullPath('$(TargetDir)'))</_ProcessFixtureOutputRoot>
    </PropertyGroup>
    <Error Condition="'$(_ProcessFixtureDestination)' == '$(_ProcessFixtureDestinationRoot)' Or '$(_ProcessFixtureDestination)' == '$(_ProcessFixtureOutputRoot)'" Text="Fixture directory must be a dedicated child of the test output directory." />
    <MSBuild Projects="../Fixtures/ProcessFixture/ProcessFixture.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="_ProcessFixtureTarget" />
    </MSBuild>
    <PropertyGroup>
      <_ProcessFixtureSource>@(_ProcessFixtureTarget->'%(RootDir)%(Directory)')</_ProcessFixtureSource>
    </PropertyGroup>
    <Error Condition="'$(_ProcessFixtureSource)' == ''" Text="Process fixture output directory is unavailable." />
    <ItemGroup>
      <_ProcessFixtureFiles Include="$(_ProcessFixtureSource)**/*" />
    </ItemGroup>
    <!-- 専有 leaf だけを再生成し、以前の平坦化コピーや退役した依存の残骸を残しません。 -->
    <RemoveDir Directories="$(_ProcessFixtureDestination)" />
    <Copy SourceFiles="@(_ProcessFixtureFiles)" DestinationFiles="@(_ProcessFixtureFiles->'$(_ProcessFixtureDestination)/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <ItemGroup>
    <!-- 計算・表示の両moduleが同じ独立固定入力を出力から読みます。 -->
    <Content Include="../../BeMusicSeeker.Tests/TestData/Walkure/*.json" Link="TestData/Walkure/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
