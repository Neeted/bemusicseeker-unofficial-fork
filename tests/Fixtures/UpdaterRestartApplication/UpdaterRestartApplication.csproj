<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- SDKのbundle生成だけを使い、依存のないfixtureに追加の分析用packageを導入しません。 -->
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <!-- 同じproject/global propertiesのPublish結果を全consumerで共有します。 -->
  <Target Name="GetUpdaterRestartApplicationFixture" DependsOnTargets="Publish" Returns="@(_UpdaterRestartApplicationFixture)">
    <ItemGroup>
      <_UpdaterRestartApplicationFixture Include="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(PublishDir)', '$(AssemblyName).exe'))" />
    </ItemGroup>
    <Error Condition="!Exists('@(_UpdaterRestartApplicationFixture)')" Text="更新再起動fixtureの公開exeがありません。" />
  </Target>
</Project>
