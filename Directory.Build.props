<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'BeMusicSeeker' Or '$(MSBuildProjectName)' == 'BeMusicSeeker.Updater' Or '$(MSBuildProjectName)' == 'BeMusicSeeker.Tests'">
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
  </PropertyGroup>
</Project>
